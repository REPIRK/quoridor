{
  // A floor, not a ceiling. "latestFeature" refused to cross a major version, so a
  // contributor whose machine carried only the .NET 10 SDK was told "a compatible .NET
  // SDK was not found" by every command in the README's own "Running it" section —
  // and never by CI, which installs 9.0.x and so never saw the pin bite. Reproduced by
  // pinning 8.0.100 against the 9.0.315 this machine has: latestFeature and latestMinor
  // both failed to load, latestMajor resolved to 9.0.315.
  //
  // The projects target net9.0 and a newer SDK builds that from the reference packs, so
  // rolling forward costs nothing. The workflows still pin 9.0.x, which is what keeps
  // the build that ships on the framework it was measured on.
  "sdk": {
    "version": "9.0.100",
    "rollForward": "latestMajor"
  }
}
