@using Quoridor.Engine
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject NavigationManager Nav

<div class="app" data-theme="@(_light ? "light" : "dark")">

    <header class="bar">
        <div class="brand">Quoridor</div>
        <div class="mode">@Title</div>
        <div class="actions">
            <button class="ghost" @onclick="OpenSetup">New game</button>
            <button class="ghost @(_routes ? "on" : "")" @onclick="() => _routes = !_routes">Routes</button>
            <button class="ghost @(_confirm ? "on" : "")" @onclick="() => _confirm = !_confirm">Confirm</button>
            <button class="ghost @(_sound ? "on" : "")" @onclick="() => _sound = !_sound">Sound</button>
            <button class="ghost @(_music ? "on" : "")" @onclick="ToggleMusic">Music</button>
            <button class="ghost" @onclick="() => _light = !_light">@(_light ? "Dark" : "Light")</button>
        </div>
    </header>

    <main class="layout">

        <aside class="players">
            @for (int seat = 1; seat >= 0; seat--)
            {
                int player = seat;
                bool onMove = !_session.IsOver && _session.State.SideToMove == player;

                <div class="player @(onMove ? "on-move" : "")">
                    <span class="turn @(player == 0 ? "p0" : "p1")"></span>
                    <div class="who">
                        <div class="name">@_session.PlayerName(player)</div>
                        <div class="walls @(player == 0 ? "p0" : "p1")">
                            @for (int i = 0; i < Board.WallsPerPlayer; i++)
                            {
                                <i class="@(i < _session.State.WallsOf(player) ? "" : "spent")"></i>
                            }
                            <span class="count">@_session.State.WallsOf(player)</span>
                        </div>
                    </div>
                    <div class="steps">@Steps(player)</div>
                </div>
            }
        </aside>

        <div class="board-wrap">
            <BoardView State="Shown"
                       Interactive="@(_session.IsHumanTurn && !_thinking && !_session.IsOver && _reviewPly is null)"
                       ShowRoutes="_routes"
                       Flipped="@(_session.LocalSeat == 1)"
                       Holes="_session.Holes"
                       ConfirmMoves="_confirm"
                       LastMove="ShownLastMove"
                       Premove="_premove"
                       OnPremove="move => _premove = move"
                       OnMove="OnMove"
                       OnPreview="text => _preview = text" />
        </div>

        <aside class="panel">
            <h2>Status</h2>
            <p class="status">@Status@(_thinking ? "…" : "")</p>
            <p class="hint">@(_preview ?? Hint)</p>
            @if (EngineLine is { } engine)
            {
                <p class="engine">@engine</p>
            }

            <hr />

            <h2>Moves</h2>
            <ol class="moves">
                @for (int row = 0; row * 2 < _session.Moves.Count; row++)
                {
                    int index = row;
                    bool here = _reviewPly is { } ply && ply > 0 && (ply - 1) / 2 == index;

                    <li class="@(here ? "here" : "")" @onclick="() => Review(Math.Min((index + 1) * 2, _session.Moves.Count))">
                        <span class="n">@(row + 1).</span>
                        <span>@Notation.Format(_session.Moves[row * 2])</span>
                        <span>@(row * 2 + 1 < _session.Moves.Count ? Notation.Format(_session.Moves[row * 2 + 1]) : "")</span>
                    </li>
                }
                @if (_session.Moves.Count == 0)
                {
                    <li class="empty">Nothing played yet.</li>
                }
            </ol>

            <div class="actions review">
                <button class="ghost" disabled="@(_session.Moves.Count == 0)"
                        @onclick="() => Review((_reviewPly ?? _session.Moves.Count) - 1)">&#x25C0;</button>
                <button class="ghost" disabled="@(_reviewPly is null)"
                        @onclick="() => Review((_reviewPly ?? 0) + 1)">&#x25B6;</button>
                <button class="ghost" disabled="@(_reviewPly is null)" @onclick="() => Review(null)">Live</button>
            </div>

            <hr />

            <div class="actions">
                <button class="ghost" disabled="@(!_session.CanUndo || _thinking)" @onclick="Undo">Undo</button>
                <button class="ghost" @onclick="() => Restart(false)">Restart</button>
            </div>
        </aside>
    </main>

    @if (_session.IsOver)
    {
        <div class="overlay">
            <div class="result">
                <h1>@WinnerLabel</h1>
                <p>@_session.Moves.Count moves played</p>
                <div class="actions">
                    <button class="ghost" @onclick="() => Restart(false)">Rematch</button>
                    @if (_session.Mode != WebMode.Hotseat)
                    {
                        <button class="ghost" @onclick="() => Restart(true)">Swap sides</button>
                    }
                    <button class="ghost" @onclick="OpenSetup">New game</button>
                </div>
            </div>
        </div>
    }

    @if (_showSetup)
    {
        <div class="overlay">
            <div class="setup">
                <h1>Quoridor</h1>
                <p class="lead">
                    Cross the board first. Ten walls each to make the other route longer.
                </p>

                <div class="row">
                    <span class="label">Opponent</span>
                    <button class="seg @(_mode == WebMode.VersusBot ? "on" : "")"
                            @onclick="() => SelectMode(WebMode.VersusBot)">The engine</button>
                    <button class="seg @(_mode == WebMode.Hotseat ? "on" : "")"
                            @onclick="() => SelectMode(WebMode.Hotseat)">A friend, here</button>
                    <button class="seg @(_mode == WebMode.Online ? "on" : "")"
                            @onclick="() => SelectMode(WebMode.Online)">A friend, online</button>
                </div>

                @if (_mode == WebMode.VersusBot)
                {
                    <div class="row">
                        <span class="label">Strength</span>
                        @foreach (BotStrength option in new[] { BotStrength.Easy, BotStrength.Normal, BotStrength.Hard })
                        {
                            BotStrength choice = option;
                            <button class="seg @(_strength == choice ? "on" : "")"
                                    @onclick="() => _strength = choice">@choice</button>
                        }
                    </div>
                }

                @if (_net.State == NetState.Idle)
                {
                    <div class="row">
                        <span class="label">Board</span>
                        @foreach (BoardLayout option in Layouts.All)
                        {
                            BoardLayout choice = option;
                            <button class="seg @(_layout == choice ? "on" : "")"
                                    @onclick="() => _layout = choice">@Layouts.Name(choice)</button>
                        }
                    </div>
                    <p class="fine">@Layouts.Description(_layout)</p>
                }

                @if (_mode == WebMode.VersusBot)
                {
                    <div class="row">
                        <span class="label">You play</span>
                        <button class="seg @(_seat == 0 ? "on" : "")" @onclick="() => _seat = 0">First</button>
                        <button class="seg @(_seat == 1 ? "on" : "")" @onclick="() => _seat = 1">Second</button>
                    </div>
                }

                @if (_mode == WebMode.Online)
                {
                    <div class="online">
                        @if (_net.State == NetState.Idle)
                        {
                            @* Only the player who creates the game picks the sides; the one who
                               opens the link takes whatever is left. *@
                            <div class="row">
                                <span class="label">You play</span>
                                <button class="seg @(_seat == 0 ? "on" : "")" @onclick="() => _seat = 0">First</button>
                                <button class="seg @(_seat == 1 ? "on" : "")" @onclick="() => _seat = 1">Second</button>
                            </div>
                            <div class="row">
                                <button class="ghost primary" @onclick="HostGame">Create a game</button>
                            </div>
                            <div class="row">
                                <input class="code" placeholder="or paste an invite code"
                                       value="@_joinCode"
                                       @oninput="e => _joinCode = e.Value?.ToString() ?? string.Empty" />
                                <button class="ghost" disabled="@string.IsNullOrWhiteSpace(_joinCode)"
                                        @onclick="JoinGame">Join</button>
                            </div>
                        }
                        else if (_net.State == NetState.Hosting)
                        {
                            <p class="fine">
                                @(string.IsNullOrEmpty(_net.Code)
                                    ? "Setting up…"
                                    : "Send this link to the other player. The game starts the moment they open it.")
                            </p>
                            @if (!string.IsNullOrEmpty(_net.Code))
                            {
                                <input class="code wide" readonly value="@ShareLink" @onfocus="SelectAll" />
                            }
                        }
                        else if (_net.State == NetState.Joining)
                        {
                            <p class="fine">Connecting…</p>
                        }
                        else if (_net.State == NetState.Failed)
                        {
                            <p class="fine">@_net.Trouble</p>
                            <div class="row">
                                <button class="ghost" @onclick="ResetNet">Try again</button>
                            </div>
                        }
                    </div>
                }

                <p class="fine">
                    @if (_mode == WebMode.Online)
                    {
                        <text>
                            The two browsers talk directly to each other over WebRTC — there is no
                            server of ours in the middle. A free public service is used once, only to
                            introduce them; after that the moves never touch a third party. Strict
                            networks sometimes block the direct connection.
                        </text>
                    }
                    else
                    {
                        <text>
                            Click a square to step, or hover the groove between two squares to place a
                            wall. Hard runs a real alpha-beta search — in a browser it gets one thread,
                            so it thinks a little less deeply than the desktop build.
                        </text>
                    }
                </p>

                <p class="fine">
                    Prefer it on your desktop?
                    <a href="https://github.com/REPIRK/quoridor/releases/latest/download/Quoridor.exe">
                        Download the Windows app
                    </a>
                    — it adds clocks, engine against engine, game review and play over your
                    own network.
                </p>

                @if (_mode != WebMode.Online)
                {
                    <div class="actions">
                        <button class="ghost primary" @onclick="StartGame">Play</button>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    // The full engine is the default; the two heuristic bots are the handicap.
    private WebSession _session = new(WebMode.VersusBot, BotStrength.Hard);
    private NetLink _net = default!;

    private WebMode _mode = WebMode.VersusBot;
    private BotStrength _strength = BotStrength.Hard;

    /// <summary>The seat this browser takes in the game being set up. Seat 0 moves first.</summary>
    private int _seat;

    private BoardLayout _layout = BoardLayout.Open;

    private bool _showSetup = true;
    private bool _thinking;
    private bool _light;
    private bool _routes;
    private bool _confirm;
    private bool _touch;
    private bool _sound = true;
    private bool _music;
    private string? _preview;
    private string _joinCode = string.Empty;

    /// <summary>A move chosen during the opponent's turn, played the moment ours starts.</summary>
    private Move? _premove;

    /// <summary>Ply being looked at while stepping back; null means live.</summary>
    private int? _reviewPly;

    private GameState Shown => _reviewPly is { } ply ? _session.StateAfter(ply) : _session.State;

    private Move? ShownLastMove => _reviewPly is { } ply
        ? ply > 0 ? _session.Moves[ply - 1] : null
        : _session.LastMove;

    protected override async Task OnInitializedAsync()
    {
        _net = new NetLink(Js);
        _net.Changed += OnNetChanged;
        _net.Received += OnNetMessage;

        // Arriving through an invite link goes straight to connecting.
        var uri = new Uri(Nav.Uri);
        string? invite = System.Web.HttpUtility.ParseQueryString(uri.Query).Get("join");

        if (string.IsNullOrWhiteSpace(invite)) return;

        _mode = WebMode.Online;
        _joinCode = invite;
        await _net.JoinAsync(invite);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // A touch screen has no hover, so one stray tap would move a pawn. Confirmation
        // is the right default there and the wrong one with a mouse.
        try
        {
            bool coarse = await Js.InvokeAsync<bool>("eval", "matchMedia('(hover: none)').matches");
            if (!coarse) return;

            _touch = true;
            _confirm = true;
            StateHasChanged();
        }
        catch (Exception)
        {
            // Not worth a broken page if the check is unavailable.
        }
    }

    // ================================================================= review ==

    /// <summary>
    /// Steps back and forth through the game. Null returns to the live position.
    /// </summary>
    private void Review(int? ply)
    {
        int played = _session.Moves.Count;

        if (ply is null || ply >= played)
        {
            _reviewPly = null;
            return;
        }

        _reviewPly = Math.Clamp(ply.Value, 0, played);
        _preview = null;
    }

    private string ShareLink => $"{Nav.BaseUri}?join={_net.Code}";

    private string Title
    {
        get
        {
            string name = _session.Mode switch
            {
                WebMode.Hotseat => "Two players, one screen",
                WebMode.Online => _net.IsConnected ? "Online game" : "Online game · disconnected",
                _ => $"Versus {_session.Strength.ToString().ToLowerInvariant()} engine",
            };

            return _session.Layout == BoardLayout.Open
                ? name
                : $"{name} · {Layouts.Name(_session.Layout).ToLowerInvariant()}";
        }
    }

    private string Status
    {
        get
        {
            if (_session.IsOver) return WinnerLabel;
            if (_thinking) return "Thinking";

            if (_session.Mode == WebMode.Online)
                return _session.IsHumanTurn ? "Your move" : "Waiting for your opponent";

            return _session.Mode == WebMode.VersusBot && _session.IsHumanTurn
                ? "Your move"
                : $"{_session.PlayerName(_session.State.SideToMove)} to move";
        }
    }

    private string Hint
    {
        get
        {
            if (_session.IsOver) return "Rematch to play again.";

            if (_session.Mode == WebMode.Online && !_net.IsConnected)
                return _net.Trouble.Length > 0 ? _net.Trouble : "The connection is gone.";

            if (_session.State.WallsOf(_session.State.SideToMove) == 0)
                return "No walls left — it is a straight race now.";

            return _touch
                ? "Tap a square to step, or the gap between squares for a wall. Tap again to confirm."
                : "Click a square to step, or hover a groove between squares to place a wall.";
        }
    }

    private string WinnerLabel
    {
        get
        {
            int winner = _session.Winner;
            if (winner < 0) return string.Empty;

            if (_session.Mode == WebMode.Hotseat) return $"{_session.PlayerName(winner)} wins";
            if (winner == _session.LocalSeat) return "You win";

            return _session.Mode == WebMode.VersusBot ? "The engine wins" : "Your opponent wins";
        }
    }

    private string? EngineLine
    {
        get
        {
            if (_session.Bot is not SearchAgent engine || engine.LastResult.Depth == 0) return null;

            SearchResult result = engine.LastResult;
            string verdict = result.IsForced
                ? result.Score > 0 ? "engine has a forced win" : "engine is lost"
                : result.Score > 250 ? "engine ahead"
                : result.Score < -250 ? "you ahead"
                : "level";

            return $"depth {result.Depth} · {result.Nodes:N0} nodes · {verdict}";
        }
    }

    private string Steps(int player)
    {
        (int first, int second) = _session.Distances();
        int distance = player == 0 ? first : second;

        return distance < 0 ? "no route" : distance == 0 ? "home" : $"{distance} to go";
    }

    // ================================================================== setup ==

    private void OpenSetup()
    {
        _showSetup = true;
        ResetNet();
    }

    private void SelectMode(WebMode mode)
    {
        _mode = mode;
        if (mode != WebMode.Online) ResetNet();
    }

    private async Task StartGame()
    {
        _session = new WebSession(_mode, _strength, _seat, _layout);
        _showSetup = false;
        ResetPlayState();

        // Taking the second seat means the engine opens.
        if (_session.IsBotTurn) await RunEngine();
    }

    /// <summary>
    /// Begins again, optionally with the players changing places. Online this has to be
    /// agreed, so the same instruction goes to the other browser and both act on it.
    /// </summary>
    private async Task Restart(bool swap)
    {
        int seat = _session.LocalSeat < 0 ? -1 : swap ? _session.LocalSeat ^ 1 : _session.LocalSeat;

        if (_session.Mode == WebMode.Online)
            await _net.SendAsync(swap ? "restart|swap" : "restart");

        _seat = seat < 0 ? 0 : seat;
        _session = new WebSession(_session.Mode, _session.Strength, _seat, _session.Layout);
        ResetPlayState();

        if (_session.IsBotTurn) await RunEngine();
    }

    private void Undo()
    {
        _session.Undo();
        ResetPlayState();
    }

    // =================================================================== sound ==

    private IJSObjectReference? _sfx;

    /// <summary>
    /// The sounds are synthesised in the browser, so the module is the whole of it —
    /// there is nothing to download and nothing to wait for. Loaded on the first sound
    /// because a page may never make one.
    /// </summary>
    private async Task Sfx(string kind)
    {
        if (!_sound) return;

        try
        {
            _sfx ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/sfx.js");
            await _sfx.InvokeVoidAsync("play", kind);
        }
        catch (Exception)
        {
            // Audio is a nicety; a browser that refuses it should not break the game.
        }
    }

    /// <summary>The sound a move makes, and the one the end of the game makes.</summary>
    private async Task SoundFor(Move move)
    {
        await Sfx(move.Kind == MoveKind.Pawn ? "move" : "wall");

        if (!_session.IsOver) return;

        bool ours = _session.Mode == WebMode.Hotseat || _session.Winner == _session.LocalSeat;
        await Sfx(ours ? "win" : "lose");
    }

    private async Task ToggleMusic()
    {
        _music = !_music;

        try
        {
            _sfx ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/sfx.js");
            await _sfx.InvokeVoidAsync("music", _music);
        }
        catch (Exception)
        {
        }
    }

    /// <summary>Anything that only made sense for the position we just left.</summary>
    private void ResetPlayState()
    {
        _preview = null;
        _premove = null;
        _reviewPly = null;
    }

    // =================================================================== link ==

    private async Task HostGame() => await _net.HostAsync();

    private async Task JoinGame() => await _net.JoinAsync(_joinCode);

    private void ResetNet()
    {
        _ = _net.SendAsync(string.Empty);
        _ = _net.DisposeAsync().AsTask();

        _net = new NetLink(Js);
        _net.Changed += OnNetChanged;
        _net.Received += OnNetMessage;
    }

    private void OnNetChanged() => InvokeAsync(async () =>
    {
        // The player who created the game chose the sides; the one who opened the link
        // starts on the assumption of the second seat and is told otherwise straight away.
        if (_net.IsConnected && (_session.Mode != WebMode.Online || _showSetup))
        {
            bool host = _net.Code.Length > 0;

            // The player who opened the link takes the second seat and the standard board
            // until told otherwise, which happens immediately.
            if (!host)
            {
                _seat = 1;
                _layout = BoardLayout.Open;
            }

            _session = new WebSession(WebMode.Online, BotStrength.Normal, _seat, _layout);
            _showSetup = false;
            ResetPlayState();

            if (host) await _net.SendAsync($"seat|{_seat ^ 1}|{(int)_layout}");
        }

        StateHasChanged();
    });

    private void OnNetMessage(string message) => InvokeAsync(async () =>
    {
        // "seat|<n>|<layout>" — the side and the board the other browser has set up.
        // Sent once, on connecting, by whoever created the game.
        if (message.StartsWith("seat|"))
        {
            string[] terms = message.Split('|');

            if (terms.Length == 3 &&
                int.TryParse(terms[1], out int mine) && mine is 0 or 1 &&
                int.TryParse(terms[2], out int shape) && Enum.IsDefined(typeof(BoardLayout), shape))
            {
                _seat = mine;
                _layout = (BoardLayout)shape;

                if (mine != _session.LocalSeat || _layout != _session.Layout)
                {
                    _session = new WebSession(WebMode.Online, BotStrength.Normal, _seat, _layout);
                    ResetPlayState();
                }
            }

            StateHasChanged();
            return;
        }

        if (message is "restart" or "restart|swap")
        {
            _seat = message.EndsWith("swap") ? _session.LocalSeat ^ 1 : _session.LocalSeat;

            _session = new WebSession(WebMode.Online, BotStrength.Normal, _seat, _session.Layout);
            ResetPlayState();
            StateHasChanged();
            return;
        }

        // "move|<ply>|<notation>". The ply guards against a duplicate or a message that
        // overtook another; anything that does not line up is dropped rather than
        // guessed at, because both sides hold the same position and can afford to wait.
        string[] parts = message.Split('|');

        if (parts.Length == 3 &&
            parts[0] == "move" &&
            int.TryParse(parts[1], out int ply) &&
            ply == _session.Moves.Count &&
            Notation.TryParse(parts[2], out Move move) &&
            _session.Apply(move))
        {
            await SoundFor(move);
        }

        StateHasChanged();
        await TryPremoveAsync();
    });

    // =================================================================== play ==

    private async Task OnMove(Move move)
    {
        if (_thinking || !_session.IsHumanTurn) return;

        int ply = _session.Moves.Count;
        if (!_session.Apply(move)) return;

        _preview = null;
        await SoundFor(move);

        if (_session.Mode == WebMode.Online)
        {
            await _net.SendAsync($"move|{ply}|{Notation.Format(move)}");
            return;
        }

        await RunEngine();
    }

    /// <summary>
    /// Plays the move queued during the opponent's turn. Whether it would still be legal
    /// could not be known when it was chosen, so it is checked now and quietly dropped
    /// if their move ruined it.
    /// </summary>
    private async Task TryPremoveAsync()
    {
        if (_premove is not { } queued) return;
        if (!_session.IsHumanTurn || _reviewPly is not null) return;

        _premove = null;

        if (_session.State.IsLegal(queued)) await OnMove(queued);

        // This runs from a network callback or after the engine, not from a Blazor event,
        // so nothing repaints on its own — whether the move was played or dropped.
        StateHasChanged();
    }

    /// <summary>
    /// WebAssembly has one thread, and the search is on it. Showing "Thinking" and then
    /// yielding lets the browser paint that before the page goes quiet for half a second
    /// — without the yield the label would only appear after the search had finished.
    /// </summary>
    private async Task RunEngine()
    {
        while (_session.IsBotTurn)
        {
            _thinking = true;
            StateHasChanged();
            await Task.Delay(40);

            Move move = _session.Think();
            _session.Apply(move);
            await SoundFor(move);

            _thinking = false;
            StateHasChanged();
            await Task.Delay(1);
        }

        await TryPremoveAsync();
    }

    private async Task SelectAll(FocusEventArgs _) =>
        await Js.InvokeVoidAsync("document.execCommand", "selectAll", false, null);

    public async ValueTask DisposeAsync()
    {
        await _net.DisposeAsync();

        if (_sfx is not null)
        {
            try { await _sfx.DisposeAsync(); } catch (Exception) { /* page is going away */ }
        }
    }
}
