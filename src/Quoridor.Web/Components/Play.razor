@using Quoridor.Engine
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject NavigationManager Nav

<div class="app" data-theme="@(_light ? "light" : "dark")">

    <header class="bar">
        <div class="brand">Quoridor</div>
        <div class="mode">@Title</div>
        @* One button, not six. What is behind it is not needed mid-move, and a row of
           toggles above the board is a row of things to read past. *@
        <div class="actions">
            <button class="ghost" @onclick="OpenSetup">New game</button>
            <button class="ghost @(_showSettings ? "on" : "")" @onclick="() => _showSettings = !_showSettings">
                Settings
            </button>
        </div>
    </header>

    <main class="layout">

        <aside class="players">
            @for (int seat = 1; seat >= 0; seat--)
            {
                int player = seat;
                bool onMove = !_session.IsOver && _session.State.SideToMove == player;

                <div class="player @(onMove ? "on-move" : "")">
                    <span class="turn @(player == 0 ? "p0" : "p1")"></span>
                    <div class="who">
                        <div class="name">@_session.PlayerName(player)</div>
                        <div class="walls @(player == 0 ? "p0" : "p1")">
                            @for (int i = 0; i < WallPips; i++)
                            {
                                <i class="@(i < _session.State.WallsOf(player) ? "" : "spent")"></i>
                            }
                            <span class="count">@_session.State.WallsOf(player)</span>
                        </div>
                    </div>
                    <div class="steps">@Steps(player)</div>
                </div>
            }
        </aside>

        <div class="board-wrap">
            <BoardView State="Shown"
                       Interactive="@(_session.IsHumanTurn && !_thinking && !_session.IsOver && _reviewPly is null)"
                       ShowRoutes="_routes"
                       Flipped="@(_session.LocalSeat == 1)"
                       Holes="_session.Holes"
                       Collected="@(_reviewPly is null ? _session.LastPickup : null)"
                       ConfirmMoves="_confirm"
                       LastMove="ShownLastMove"
                       Premove="_premove"
                       OnPremove="move => _premove = move"
                       OnMove="OnMove"
                       OnPreview="text => _preview = text" />
        </div>

        <aside class="panel">
            @* The instructions teach themselves in two moves and then become furniture,
               so they retire on their own. The mark brings them back for anyone who
               wants them, and is the only thing left in their place. *@
            <div class="heading">
                <h2>Status</h2>
                <button class="ask @(_showHelp ? "on" : "")" title="How to move"
                        @onclick="() => _showHelp = !_showHelp">?</button>
            </div>

            <p class="status">@Status@(_thinking ? "…" : "")</p>

            @{ string note = _preview ?? Hint; }
            @if (note.Length > 0)
            {
                <p class="hint">@note</p>
            }
            @if (EngineLine is { } engine)
            {
                <p class="engine">@engine</p>
            }

            <hr />

            <h2>Moves</h2>
            <ol class="moves">
                @for (int row = 0; row * 2 < _session.Moves.Count; row++)
                {
                    int index = row;
                    bool here = _reviewPly is { } ply && ply > 0 && (ply - 1) / 2 == index;

                    <li class="@(here ? "here" : "")" @onclick="() => Review(Math.Min((index + 1) * 2, _session.Moves.Count))">
                        <span class="n">@(row + 1).</span>
                        <span>@Notation.Format(_session.Moves[row * 2], _session.State)</span>
                        <span>@(row * 2 + 1 < _session.Moves.Count ? Notation.Format(_session.Moves[row * 2 + 1], _session.State) : "")</span>
                    </li>
                }
                @if (_session.Moves.Count == 0)
                {
                    <li class="empty">Nothing played yet.</li>
                }
            </ol>

            <div class="actions review">
                <button class="ghost" disabled="@(_session.Moves.Count == 0)"
                        @onclick="() => Review((_reviewPly ?? _session.Moves.Count) - 1)">&#x25C0;</button>
                <button class="ghost" disabled="@(_reviewPly is null)"
                        @onclick="() => Review((_reviewPly ?? 0) + 1)">&#x25B6;</button>
                <button class="ghost" disabled="@(_reviewPly is null)" @onclick="() => Review(null)">Live</button>
            </div>

            <hr />

            <div class="actions">
                <button class="ghost" disabled="@(!_session.CanUndo || _thinking)" @onclick="Undo">Undo</button>
                <button class="ghost" @onclick="() => Restart(false)">Restart</button>
            </div>
        </aside>
    </main>

    @if (_showSettings)
    {
        <div class="overlay" @onclick="() => _showSettings = false">
            <div class="setup settings" @onclick:stopPropagation="true">
                <h1>Settings</h1>

                <div class="row">
                    <span class="label">Board</span>
                    <button class="seg @(_routes ? "on" : "")" @onclick="() => _routes = !_routes">Show routes</button>
                    <button class="seg @(_confirm ? "on" : "")" @onclick="() => _confirm = !_confirm">Confirm moves</button>
                </div>

                <div class="row">
                    <span class="label">Theme</span>
                    <button class="seg @(!_light ? "on" : "")" @onclick="() => _light = false">Dark</button>
                    <button class="seg @(_light ? "on" : "")" @onclick="() => _light = true">Light</button>
                </div>

                <div class="row">
                    <span class="label">Sound</span>
                    <button class="seg @(_sound ? "on" : "")" @onclick="ToggleSound">@(_sound ? "On" : "Off")</button>
                    <input class="slider" type="range" min="0" max="100" step="1" disabled="@(!_sound)"
                           value="@_soundVolume"
                           @oninput="e => SetVolume(e.Value, music: false)" />
                    <span class="reading">@_soundVolume%</span>
                </div>

                <div class="row">
                    <span class="label">Music</span>
                    <button class="seg @(_music ? "on" : "")" @onclick="ToggleMusic">@(_music ? "On" : "Off")</button>
                    <input class="slider" type="range" min="0" max="100" step="1" disabled="@(!_music)"
                           value="@_musicVolume"
                           @oninput="e => SetVolume(e.Value, music: true)" />
                    <span class="reading">@_musicVolume%</span>
                </div>

                <div class="row">
                    <span class="label">Track</span>
                    <select class="pick" value="@_track" @onchange="PickTrack">
                        <option value="0">Ink — calm, mid-register</option>
                        <option value="1">Slate — low and sparse</option>
                        <option value="2">Glass — bright, more movement</option>
                    </select>
                </div>

                <p class="fine">This game: @_session.Setup.Describe().</p>

                @if (_session.Setup.Pickups > 0)
                {
                    <PickupGuide />
                }

                <div class="actions">
                    <button class="ghost primary" @onclick="() => _showSettings = false">Done</button>
                </div>
            </div>
        </div>
    }

    @if (_session.IsOver)
    {
        <div class="overlay">
            <div class="result">
                <h1>@WinnerLabel</h1>
                <p>@_session.Moves.Count moves played</p>
                <div class="actions">
                    <button class="ghost" @onclick="() => Restart(false)">Rematch</button>
                    @if (_session.Mode != WebMode.Hotseat)
                    {
                        <button class="ghost" @onclick="() => Restart(true)">Swap sides</button>
                    }
                    <button class="ghost" @onclick="OpenSetup">New game</button>
                </div>
            </div>
        </div>
    }

    @if (_showSetup)
    {
        <div class="overlay">
            <div class="setup">
                <h1>Quoridor</h1>
                <p class="lead">
                    Cross the board first. Ten walls each to make the other route longer.
                </p>

                <div class="row">
                    <span class="label">Opponent</span>
                    <button class="seg @(_mode == WebMode.VersusBot ? "on" : "")"
                            @onclick="() => SelectMode(WebMode.VersusBot)">The engine</button>
                    <button class="seg @(_mode == WebMode.Hotseat ? "on" : "")"
                            @onclick="() => SelectMode(WebMode.Hotseat)">A friend, here</button>
                    <button class="seg @(_mode == WebMode.Online ? "on" : "")"
                            @onclick="() => SelectMode(WebMode.Online)">A friend, online</button>
                </div>

                @* The three ways in. Most people want the first one and should not have
                   to read past everything the third one can do to reach it. *@
                <div class="row">
                    <span class="label">Game</span>
                    @foreach (GameFlavour option in new[] { GameFlavour.Standard, GameFlavour.Random, GameFlavour.Custom })
                    {
                        GameFlavour choice = option;
                        <button class="seg @(_flavour == choice ? "on" : "")"
                                @onclick="() => _flavour = choice">@choice</button>
                    }
                </div>
                <p class="fine">@FlavourNote</p>

                @if (_mode == WebMode.VersusBot)
                {
                    <div class="row">
                        <span class="label">Strength</span>
                        <select class="pick" value="@((int)_strength)"
                                @onchange="e => _strength = (BotStrength)Number(e, 2)">
                            <option value="0">Easy</option>
                            <option value="1">Normal</option>
                            <option value="2">Hard</option>
                        </select>
                    </div>
                }

                @if (_flavour == GameFlavour.Custom)
                {
                    @if (_mode != WebMode.Hotseat)
                    {
                        <div class="row">
                            <span class="label">You play</span>
                            <select class="pick" value="@_seat" @onchange="e => _seat = Number(e, 0)">
                                <option value="0">First</option>
                                <option value="1">Second</option>
                            </select>
                        </div>
                    }

                    @* Still shown while the link is out. The board is not read until the
                       other player actually connects, so these stay live and the host can
                       keep adjusting while they wait — and taking them away the instant
                       the button was pressed made the card collapse and looked like the
                       settings had been thrown away. Only the player joining loses them,
                       because for them the board is the host's to choose. *@
                    @if (_net.State != NetState.Joining)
                    {
                        <div class="row">
                            <span class="label">Board</span>
                            <select class="pick" value="@_size" @onchange="e => _size = Number(e, Board.Size)">
                                <option value="9">9 × 9 — standard</option>
                                <option value="7">7 × 7 — quick</option>
                                <option value="5">5 × 5 — tiny</option>
                            </select>
                        </div>

                        <div class="row">
                            <span class="label">Walls each</span>
                            <select class="pick" value="@_walls"
                                    @onchange="e => _walls = Number(e, Board.WallsPerPlayer)">
                                @foreach (int option in new[] { 0, 3, 5, 7, 10, 14, 20 })
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        </div>

                        <div class="row">
                            <span class="label">Holes</span>
                            <select class="pick" value="@_holes" @onchange="e => _holes = Number(e, 0)">
                                <option value="0">None</option>
                                <option value="2">2 — scattered at random</option>
                                <option value="4">4 — scattered at random</option>
                                <option value="6">6 — scattered at random</option>
                                <option value="10">10 — scattered at random</option>
                            </select>
                        </div>

                        <div class="row">
                            <span class="label">Pickups</span>
                            <select class="pick" value="@_pickups" @onchange="e => _pickups = Number(e, 0)">
                                <option value="0">None</option>
                                <option value="4">4 — a spare wall or a free move</option>
                                <option value="6">6 — a spare wall or a free move</option>
                                <option value="10">10 — a spare wall or a free move</option>
                            </select>
                        </div>

                        @if (_pickups > 0)
                        {
                            <PickupGuide />
                        }
                    }
                }
                else if (_flavour == GameFlavour.Random)
                {
                    @* A rolled game may well put pickups on the board, and the first one
                       should not be a surprise nobody explained. *@
                    <PickupGuide />
                }

                @if (_mode == WebMode.Online)
                {
                    <div class="online">
                        @if (_net.State == NetState.Idle)
                        {
                            @* Only the player who creates the game picks the board and the
                               sides; the one who opens the link is told what they are. *@
                            <div class="row">
                                <button class="ghost primary" @onclick="HostGame">Create a game</button>
                            </div>
                            <div class="row">
                                <input class="code" placeholder="or paste an invite code"
                                       value="@_joinCode"
                                       @oninput="e => _joinCode = e.Value?.ToString() ?? string.Empty" />
                                <button class="ghost" disabled="@string.IsNullOrWhiteSpace(_joinCode)"
                                        @onclick="JoinGame">Join</button>
                            </div>
                        }
                        else if (_net.State == NetState.Hosting)
                        {
                            <p class="fine">
                                @(string.IsNullOrEmpty(_net.Code)
                                    ? "Setting up…"
                                    : "Send this link to the other player. The game starts the moment they open it.")
                            </p>
                            @if (!string.IsNullOrEmpty(_net.Code))
                            {
                                <div class="row">
                                    <input class="code wide" readonly value="@ShareLink" @onfocus="SelectAll" />
                                    <button class="ghost copy" @onclick="() => Copy(ShareLink)">@CopyLabel</button>
                                </div>
                                <p class="fine">
                                    Or read out the code: <span class="mono">@_net.Code</span>
                                    <button class="ghost copy" @onclick="() => Copy(_net.Code)">@CopyLabel</button>
                                </p>
                            }
                        }
                        else if (_net.State == NetState.Joining)
                        {
                            <p class="fine">Connecting…</p>
                        }
                        else if (_net.State == NetState.Failed)
                        {
                            <p class="fine">@_net.Trouble</p>
                            <div class="row">
                                <button class="ghost" @onclick="ResetNet">Try again</button>
                            </div>
                        }
                    </div>
                }

                @* The prose is welcome on the plain screen and in the way once every knob
                   is open: with Custom showing, it is what pushes the button that actually
                   starts the game below the fold. *@
                @if (_flavour != GameFlavour.Custom)
                {
                    <p class="fine">
                        @if (_mode == WebMode.Online)
                        {
                            <text>
                                The two browsers talk directly to each other over WebRTC — there is no
                                server of ours in the middle. A free public service is used once, only to
                                introduce them; after that the moves never touch a third party. Strict
                                networks sometimes block the direct connection.
                            </text>
                        }
                        else
                        {
                            <text>
                                Click a square to step, or hover the groove between two squares to place a
                                wall. Hard runs a real alpha-beta search — in a browser it gets one thread,
                                so it thinks a little less deeply than the desktop build.
                            </text>
                        }
                    </p>

                    <p class="fine">
                        Prefer it on your desktop?
                        <a href="https://github.com/REPIRK/quoridor/releases/latest/download/Quoridor.exe">
                            Download the Windows app
                        </a>
                        — it adds clocks, engine against engine, game review and play over your
                        own network.
                    </p>
                }

                @if (_mode != WebMode.Online)
                {
                    <div class="actions">
                        <button class="ghost primary" @onclick="StartGame">Play</button>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    // The full engine is the default; the two heuristic bots are the handicap.
    private WebSession _session = new(WebMode.VersusBot, BotStrength.Hard);
    private NetLink _net = default!;

    private WebMode _mode = WebMode.VersusBot;
    private BotStrength _strength = BotStrength.Hard;

    /// <summary>The seat this browser takes in the game being set up. Seat 0 moves first.</summary>
    private int _seat;

    private GameFlavour _flavour = GameFlavour.Standard;

    // The custom knobs, only reachable through the third flavour.
    private int _size = Board.Size;
    private int _walls = Board.WallsPerPlayer;
    private int _holes;
    private int _pickups;

    private bool _showSetup = true;
    private bool _showSettings;
    private bool _thinking;
    private bool _engineRunning;
    private bool _light;
    private bool _routes;
    private bool _confirm;
    private bool _touch;
    private bool _showHelp;
    private bool _sound = true;
    private bool _music;
    private int _soundVolume = 70;
    private int _musicVolume = 50;
    private int _track;
    private string? _preview;
    private string _joinCode = string.Empty;

    /// <summary>
    /// How many wall pips to draw. Sized once, to the most the row will ever have to
    /// show — pickups can push a player above the starting supply, and a row that grew
    /// as they did would reflow the panel mid-game.
    /// </summary>
    private int WallPips => Math.Min(Board.MaxWalls,
        _session.Setup.Walls + (_session.Setup.Pickups > 0 ? 4 : 0));

    /// <summary>A dropdown's new value, or the fallback if the browser sent nonsense.</summary>
    private static int Number(ChangeEventArgs e, int fallback) =>
        int.TryParse(e.Value?.ToString(), out int value) ? value : fallback;

    private string FlavourNote => _flavour switch
    {
        GameFlavour.Random => "Board, walls, holes, pickups and who moves first — all rolled for you.",
        GameFlavour.Custom => "Everything is yours to set.",
        _ => "Nine by nine, ten walls each. The game as it is normally played.",
    };

    /// <summary>
    /// The board this setup screen describes. Standard is the plain game; Random rolls
    /// everything, seeded from the clock so two games are never the same; Custom is
    /// whatever the knobs say, with a fresh seed so the same numbers still give a
    /// different scatter each time.
    /// </summary>
    private GameSetup BuildSetup() => BuildSetup(_flavour);

    private GameSetup BuildSetup(GameFlavour flavour)
    {
        int seed = Environment.TickCount;

        if (flavour == GameFlavour.Standard) return GameSetup.Standard;

        if (flavour == GameFlavour.Custom)
        {
            return new GameSetup
            {
                Size = _size,
                Walls = _walls,
                Holes = _holes,
                Pickups = _pickups,
                Seed = seed,
            };
        }

        var roll = new Random(seed);
        int size = roll.Next(4) == 0 ? 7 : Board.Size;

        return new GameSetup
        {
            Size = size,
            Walls = roll.Next(4, size == 7 ? 9 : 13),
            Holes = new[] { 0, 0, 2, 4, 6 }[roll.Next(5)],
            Pickups = new[] { 0, 4, 4, 6, 10 }[roll.Next(5)],
            Seed = seed,
        };
    }

    /// <summary>A move chosen during the opponent's turn, played the moment ours starts.</summary>
    private Move? _premove;

    /// <summary>Ply being looked at while stepping back; null means live.</summary>
    private int? _reviewPly;

    private GameState Shown => _reviewPly is { } ply ? _session.StateAfter(ply) : _session.State;

    private Move? ShownLastMove => _reviewPly is { } ply
        ? ply > 0 ? _session.Moves[ply - 1] : null
        : _session.LastMove;

    protected override async Task OnInitializedAsync()
    {
        _net = new NetLink(Js);
        _net.Changed += OnNetChanged;
        _net.Received += OnNetMessage;

        // Arriving through an invite link goes straight to connecting.
        var uri = new Uri(Nav.Uri);
        string? invite = System.Web.HttpUtility.ParseQueryString(uri.Query).Get("join");

        if (string.IsNullOrWhiteSpace(invite)) return;

        _mode = WebMode.Online;
        _joinCode = invite;
        await _net.JoinAsync(invite);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Fetch the sound module now, while nobody is waiting for anything, so the first
        // move does not find itself paying for it.
        _ = LoadSfx();

        // A touch screen has no hover, so one stray tap would move a pawn. Confirmation
        // is the right default there and the wrong one with a mouse.
        try
        {
            if (await LoadPage() is not { } page) return;
            if (!await page.InvokeAsync<bool>("isCoarsePointer")) return;

            _touch = true;
            _confirm = true;
            StateHasChanged();
        }
        catch (Exception)
        {
            // Not worth a broken page if the check is unavailable.
        }
    }

    // ================================================================= review ==

    /// <summary>
    /// Steps back and forth through the game. Null returns to the live position.
    /// </summary>
    private void Review(int? ply)
    {
        int played = _session.Moves.Count;

        if (ply is null || ply >= played)
        {
            _reviewPly = null;
            return;
        }

        _reviewPly = Math.Clamp(ply.Value, 0, played);
        _preview = null;
    }

    private string ShareLink => $"{Nav.BaseUri}?join={_net.Code}";

    private string Title
    {
        get
        {
            string name = _session.Mode switch
            {
                WebMode.Hotseat => "Two players, one screen",
                WebMode.Online => _net.IsConnected ? "Online game" : "Online game · disconnected",
                _ => $"Versus {_session.Strength.ToString().ToLowerInvariant()} engine",
            };

            return _session.Setup.IsStandard ? name : $"{name} · {_session.Setup.Describe()}";
        }
    }

    private string Status
    {
        get
        {
            if (_session.IsOver) return WinnerLabel;
            if (_thinking) return "Thinking";

            if (_session.Mode == WebMode.Online)
                return _session.IsHumanTurn ? "Your move" : "Waiting for your opponent";

            return _session.Mode == WebMode.VersusBot && _session.IsHumanTurn
                ? "Your move"
                : $"{_session.PlayerName(_session.State.SideToMove)} to move";
        }
    }

    private string Hint
    {
        get
        {
            if (_session.IsOver) return "Rematch to play again.";

            if (_session.Mode == WebMode.Online && !_net.IsConnected)
                return _net.Trouble.Length > 0 ? _net.Trouble : "The connection is gone.";

            // Without saying so, a turn that does not pass just looks like the game
            // ignored the other player.
            if (_session.LastMoveWentAgain)
                return "Free move — the turn does not pass. Go again.";

            if (_session.LastMoveTookAWall)
                return "Two spare walls picked up, on top of what you started with.";

            if (_session.State.WallsOf(_session.State.SideToMove) == 0)
                return "No walls left — it is a straight race now.";

            // How to move is worth saying once. After a couple of moves it has been
            // learned by doing, and a line that never changes is a line you stop
            // reading — so it goes, and the mark by the heading brings it back.
            if (!_showHelp && _session.Moves.Count > 2) return string.Empty;

            return _touch
                ? "Tap a square to step, or the gap between squares for a wall. Tap again to confirm."
                : "Click a square to step, or hover a groove between squares to place a wall.";
        }
    }

    private string WinnerLabel
    {
        get
        {
            int winner = _session.Winner;
            if (winner < 0) return string.Empty;

            if (_session.Mode == WebMode.Hotseat) return $"{_session.PlayerName(winner)} wins";
            if (winner == _session.LocalSeat) return "You win";

            return _session.Mode == WebMode.VersusBot ? "The engine wins" : "Your opponent wins";
        }
    }

    private string? EngineLine
    {
        get
        {
            if (_session.Bot is not SearchAgent engine || engine.LastResult.Depth == 0) return null;

            SearchResult result = engine.LastResult;
            string verdict = result.IsForced
                ? result.Score > 0 ? "engine has a forced win" : "engine is lost"
                : result.Score > 250 ? "engine ahead"
                : result.Score < -250 ? "you ahead"
                : "level";

            return $"depth {result.Depth} · {result.Nodes:N0} nodes · {verdict}";
        }
    }

    private string Steps(int player)
    {
        (int first, int second) = _session.Distances();
        int distance = player == 0 ? first : second;

        return distance < 0 ? "no route" : distance == 0 ? "home" : $"{distance} to go";
    }

    // ================================================================== setup ==

    private void OpenSetup()
    {
        _showSetup = true;
        ResetNet();
    }

    private void SelectMode(WebMode mode)
    {
        _mode = mode;
        if (mode != WebMode.Online) ResetNet();
    }

    private async Task StartGame()
    {
        // A rolled game rolls the order of play too.
        if (_flavour == GameFlavour.Random) _seat = Random.Shared.Next(2);

        _session = new WebSession(_mode, _strength, _seat, BuildSetup(), _flavour);
        _showSetup = false;
        ResetPlayState();

        // Taking the second seat means the engine opens.
        if (_session.IsBotTurn) await RunEngine();
    }

    /// <summary>
    /// Begins again, optionally with the players changing places. Online this has to be
    /// agreed, so the same instruction goes to the other browser and both act on it.
    /// </summary>
    private async Task Restart(bool swap)
    {
        bool rolled = _session.Flavour == GameFlavour.Random;

        // A rolled game rolls again — playing the same random board twice is not what
        // "random" was asked for. Standard and Custom are settings, so they stand.
        GameSetup setup = rolled ? BuildSetup(GameFlavour.Random) : _session.Setup;

        int seat = _session.LocalSeat < 0 ? 0 : swap ? _session.LocalSeat ^ 1 : _session.LocalSeat;

        // Random re-rolls who starts as well — but not online, where the seats belong to
        // both players and swapping sides is the only agreed way to change them.
        if (rolled && _session.Mode != WebMode.Online) seat = Random.Shared.Next(2);

        // Online the whole thing is a joint decision, so the other browser is told which
        // board to build and whether the sides changed.
        if (_session.Mode == WebMode.Online)
            await _net.SendAsync($"restart|{(swap ? "swap" : "keep")}|{setup.Encode()}");

        _seat = seat;
        _session = new WebSession(_session.Mode, _session.Strength, _seat, setup, _session.Flavour);
        ResetPlayState();

        if (_session.IsBotTurn) await RunEngine();
    }

    private void Undo()
    {
        _session.Undo();
        ResetPlayState();
    }

    // =================================================================== sound ==

    private IJSObjectReference? _sfx;

    /// <summary>
    /// The sounds are synthesised in the browser, so the module is the whole of it —
    /// there is nothing to download and nothing to wait for. Loaded on the first sound
    /// because a page may never make one.
    /// </summary>
    private async Task<IJSObjectReference?> LoadSfx()
    {
        try
        {
            if (_sfx is not null) return _sfx;

            _sfx = await Js.InvokeAsync<IJSObjectReference>("import", "./js/sfx.js");

            // Builds the audio graph while the browser is idle. Left to the first move,
            // it costs that move a fifth of a second and the pawn lurches instead of
            // sliding.
            await _sfx.InvokeVoidAsync("warm");

            return _sfx;
        }
        catch (Exception)
        {
            // Audio is a nicety; a browser that refuses it should not break the game.
            return null;
        }
    }

    private async Task Sfx(string kind)
    {
        if (!_sound) return;

        try
        {
            if (await LoadSfx() is { } module) await module.InvokeVoidAsync("play", kind);
        }
        catch (Exception)
        {
        }
    }

    /// <summary>The sound a move makes, and the one the end of the game makes.</summary>
    private async Task SoundFor(Move move)
    {
        // A pickup is the one thing on the board worth its own sound; without it the
        // most interesting move in the game sounds exactly like every other step.
        if (_session.LastMoveWentAgain || _session.LastMoveTookAWall)
            await Sfx(_session.LastMoveWentAgain ? "again" : "collect");
        else
            await Sfx(move.Kind == MoveKind.Pawn ? "move" : "wall");

        if (!_session.IsOver) return;

        bool ours = _session.Mode == WebMode.Hotseat || _session.Winner == _session.LocalSeat;
        await Sfx(ours ? "win" : "lose");
    }

    private async Task ToggleMusic()
    {
        _music = !_music;
        await StartMusic();
    }

    /// <summary>Switches pieces. Playing already means stopping and starting again.</summary>
    private async Task PickTrack(ChangeEventArgs e)
    {
        _track = Math.Clamp(Number(e, 0), 0, 2);

        if (!_music) return;

        try
        {
            if (await LoadSfx() is { } module) await module.InvokeVoidAsync("music", false);
        }
        catch (Exception)
        {
            return;
        }

        await StartMusic();
    }

    private async Task StartMusic()
    {
        try
        {
            if (await LoadSfx() is not { } module) return;

            await module.InvokeVoidAsync("setVolume", _soundVolume / 100.0, _musicVolume / 100.0);
            await module.InvokeVoidAsync("music", _music, _track);
        }
        catch (Exception)
        {
        }
    }

    /// <summary>Turning the effects on plays one, so the slider can be heard.</summary>
    private async Task ToggleSound()
    {
        _sound = !_sound;
        if (_sound) await Sfx("move");
    }

    private async Task SetVolume(object? value, bool music)
    {
        if (!int.TryParse(value?.ToString(), out int level)) return;

        level = Math.Clamp(level, 0, 100);

        if (music) _musicVolume = level;
        else _soundVolume = level;

        try
        {
            if (await LoadSfx() is not { } module) return;

            await module.InvokeVoidAsync("setVolume", _soundVolume / 100.0, _musicVolume / 100.0);
        }
        catch (Exception)
        {
            return;
        }

        // A volume you cannot hear is a volume you cannot set, so the effects slider
        // makes a sound as it moves.
        if (!music && _sound) await Sfx("move");
    }

    /// <summary>Anything that only made sense for the position we just left.</summary>
    private void ResetPlayState()
    {
        _preview = null;
        _premove = null;
        _reviewPly = null;
    }

    // =================================================================== link ==

    private async Task HostGame() => await _net.HostAsync();

    private async Task JoinGame() => await _net.JoinAsync(_joinCode);

    private void ResetNet()
    {
        _ = _net.SendAsync(string.Empty);
        _ = _net.DisposeAsync().AsTask();

        _net = new NetLink(Js);
        _net.Changed += OnNetChanged;
        _net.Received += OnNetMessage;
    }

    private void OnNetChanged() => InvokeAsync(async () =>
    {
        // The player who created the game chose the sides; the one who opened the link
        // starts on the assumption of the second seat and is told otherwise straight away.
        if (_net.IsConnected && (_session.Mode != WebMode.Online || _showSetup))
        {
            bool host = _net.Code.Length > 0;

            // The player who opened the link takes the second seat and the standard board
            // until told otherwise, which happens immediately.
            GameSetup setup = host ? BuildSetup() : GameSetup.Standard;
            if (!host) _seat = 1;

            // The host's flavour travels with the game, so a rematch on a rolled board
            // rolls again for both of them.
            _session = new WebSession(
                WebMode.Online, BotStrength.Normal, _seat, setup, host ? _flavour : GameFlavour.Standard);
            _showSetup = false;
            ResetPlayState();

            if (host) await _net.SendAsync($"seat|{_seat ^ 1}|{setup.Encode()}");
        }

        StateHasChanged();
    });

    private void OnNetMessage(string message) => InvokeAsync(async () =>
    {
        // "seat|<n>|<board>" — the side and the board the other browser has set up, the
        // board as the numbers it was generated from so both sides build the same one.
        // Sent once, on connecting, by whoever created the game.
        if (message.StartsWith("seat|"))
        {
            string[] terms = message.Split('|');

            if (terms.Length == 7 &&
                int.TryParse(terms[1], out int mine) && mine is 0 or 1 &&
                GameSetup.TryDecode(terms.AsSpan(2), out GameSetup setup))
            {
                _seat = mine;

                if (mine != _session.LocalSeat || setup != _session.Setup)
                {
                    // A board that is not the plain one was rolled or set by the host;
                    // either way this side follows whatever they send on a rematch.
                    _session = new WebSession(
                        WebMode.Online, BotStrength.Normal, _seat, setup, GameFlavour.Standard);

                    ResetPlayState();
                }
            }

            StateHasChanged();
            return;
        }

        // "restart|<swap|keep>|<board>" — begin again, on the board the other side rolled
        // and with the sides they say. Older builds sent "restart" and "restart|swap",
        // which still mean the same thing on the board already in play.
        if (message.StartsWith("restart"))
        {
            string[] terms = message.Split('|');
            bool swap = terms.Length > 1 && terms[1] == "swap";

            GameSetup setup = terms.Length == 7 && GameSetup.TryDecode(terms.AsSpan(2), out GameSetup sent)
                ? sent
                : _session.Setup;

            _seat = swap ? _session.LocalSeat ^ 1 : _session.LocalSeat;

            _session = new WebSession(
                WebMode.Online, BotStrength.Normal, _seat, setup, _session.Flavour);

            ResetPlayState();
            StateHasChanged();
            return;
        }

        // "move|<ply>|<notation>". The ply guards against a duplicate or a message that
        // overtook another; anything that does not line up is dropped rather than
        // guessed at, because both sides hold the same position and can afford to wait.
        string[] parts = message.Split('|');

        if (parts.Length == 3 &&
            parts[0] == "move" &&
            int.TryParse(parts[1], out int ply) &&
            ply == _session.Moves.Count &&
            Notation.TryParse(parts[2], out Move move, _session.State.GoalRow(0)) &&
            _session.Apply(move))
        {
            _ = SoundFor(move);
        }

        StateHasChanged();
        await TryPremoveAsync();
    });

    // =================================================================== play ==

    private async Task OnMove(Move move)
    {
        if (_thinking || !_session.IsHumanTurn) return;

        int ply = _session.Moves.Count;
        if (!_session.Apply(move)) return;

        _preview = null;

        // Deliberately not awaited. The first sound has to fetch its module, and waiting
        // on that once held the engine's reply up for five seconds on a cold load.
        _ = SoundFor(move);

        if (_session.Mode == WebMode.Online)
        {
            await _net.SendAsync($"move|{ply}|{Notation.Format(move, _session.State)}");
            return;
        }

        // Let the move finish moving before the engine takes the thread away. The search
        // runs on the only thread this build has, so anything still animating when it
        // starts simply stops dead and snaps into place when it ends. Playing a person
        // has always looked right for exactly this reason: nothing blocks in between.
        await Task.Delay(MoveAnimationMs);

        await RunEngine();
    }

    /// <summary>
    /// How long the board takes to show a move, matching the pawn's transition in the
    /// stylesheet. The engine waits this out before it starts thinking.
    /// </summary>
    private const int MoveAnimationMs = 330;

    /// <summary>
    /// Plays the move queued during the opponent's turn. Whether it would still be legal
    /// could not be known when it was chosen, so it is checked now and quietly dropped
    /// if their move ruined it.
    /// </summary>
    private async Task TryPremoveAsync()
    {
        if (_premove is not { } queued) return;
        if (!_session.IsHumanTurn || _reviewPly is not null) return;

        _premove = null;

        if (_session.State.IsLegal(queued)) await OnMove(queued);

        // This runs from a network callback or after the engine, not from a Blazor event,
        // so nothing repaints on its own — whether the move was played or dropped.
        StateHasChanged();
    }

    /// <summary>
    /// WebAssembly has one thread, and the search is on it. Showing "Thinking" and then
    /// yielding lets the browser paint that before the page goes quiet for half a second
    /// — without the yield the label would only appear after the search had finished.
    /// </summary>
    private async Task RunEngine()
    {
        // Only ever one of these. The loop yields so the browser can paint "Thinking",
        // and a restart pressed inside that gap would otherwise start a second loop
        // alongside the first, both driving the same game.
        if (_engineRunning) return;
        _engineRunning = true;

        try
        {
            while (_session.IsBotTurn)
            {
                _thinking = true;
                StateHasChanged();
                await Task.Delay(40);

                Move move = _session.Think();
                _session.Apply(move);
                _ = SoundFor(move);

                _thinking = false;
                StateHasChanged();

                // Same reason as after a human move: if the engine is about to think
                // again — it found a free move — its pawn has to arrive first.
                await Task.Delay(MoveAnimationMs);
            }
        }
        finally
        {
            _thinking = false;
            _engineRunning = false;
        }

        await TryPremoveAsync();
    }

    private async Task SelectAll(FocusEventArgs _) =>
        await Js.InvokeVoidAsync("document.execCommand", "selectAll", false, null);

    /// <summary>Shown on the copy buttons; says so for a moment after one is pressed.</summary>
    private string CopyLabel => _copied ? "Copied" : "Copy";

    private bool _copied;

    private IJSObjectReference? _page;

    private async Task<IJSObjectReference?> LoadPage()
    {
        try
        {
            return _page ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/page.js");
        }
        catch (Exception)
        {
            return null;
        }
    }

    /// <summary>
    /// Puts the invite on the clipboard, and says so on the button for a moment. The
    /// work is in the module: the clipboard API has to be called as a method on the
    /// object that owns it, which an interop path by name cannot do.
    /// </summary>
    private async Task Copy(string text)
    {
        if (string.IsNullOrEmpty(text)) return;

        try
        {
            if (await LoadPage() is not { } page) return;
            if (!await page.InvokeAsync<bool>("copy", text)) return;
        }
        catch (Exception)
        {
            return;
        }

        _copied = true;
        StateHasChanged();

        await Task.Delay(1400);

        _copied = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        await _net.DisposeAsync();

        foreach (IJSObjectReference? module in new[] { _sfx, _page })
        {
            if (module is null) continue;

            try { await module.DisposeAsync(); } catch (Exception) { /* page is going away */ }
        }
    }
}
