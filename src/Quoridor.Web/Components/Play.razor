@using Quoridor.Engine
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject NavigationManager Nav

<div class="app" data-theme="@(_light ? "light" : "dark")">

    <header class="bar" inert="@Covered">
        <div class="brand">Quoridor</div>
        <div class="mode">@Title</div>
        @* One button, not six. What is behind it is not needed mid-move, and a row of
           toggles above the board is a row of things to read past. *@
        <div class="actions">
            <button class="ghost" @onclick="OpenSetup">New game</button>
            <button class="ghost @(_showSettings ? "on" : "")" @onclick="() => _showSettings = !_showSettings">
                Settings
            </button>
        </div>
    </header>

    <main class="layout" inert="@Covered">

        <aside class="players">
            @for (int seat = 1; seat >= 0; seat--)
            {
                int player = seat;
                bool onMove = !_session.IsOver && _session.State.SideToMove == player;

                <div class="player @(onMove ? "on-move" : "")">
                    <span class="turn @(player == 0 ? "p0" : "p1")"></span>
                    <div class="who">
                        <div class="name">@_session.PlayerName(player)</div>
                        @* Two spare walls land in this row and nowhere else. The board
                           sees the pickup off where it was taken, but the thing it was
                           taken for arrives here, and arriving in silence is how a prize
                           comes to feel like nothing much happened. Keyed on the ply so
                           each collection plays once. *@
                        <div class="walls @(player == 0 ? "p0" : "p1") @(Gained(player) ? "gained" : "")"
                             @key="@(Gained(player) ? $"gained-{player}-{_session.State.Ply}" : $"walls-{player}")">
                            @for (int i = 0; i < WallPips; i++)
                            {
                                @* The sweep crosses the row in a fixed time however long
                                   the row is, and finishes inside the pause before the
                                   engine takes the thread — as the board's own entrance
                                   does, and for the same reason. *@
                                <i class="@(i < _session.State.WallsOf(player) ? "" : "spent")"
                                   style="@(Gained(player) ? $"animation-delay: {90 * i / Math.Max(1, WallPips - 1)}ms" : null)"></i>
                            }
                            <span class="count">@_session.State.WallsOf(player)</span>
                        </div>
                    </div>
                </div>
            }

            @* The race, as one figure instead of two grey strings on opposite sides of a
               panel that nobody subtracts from each other. Each player's remaining steps
               sit at their own end, and the bar between leans toward whoever gets home
               first — by six steps it is as far over as it goes, because past that the
               answer is simply "them" and a longer bar says nothing more.

               The half-step of being on move is included, so the bar is never exactly
               level and the turn passing is visible here as well as on the board. The
               whole sentence is on the figure itself, which is why nothing is written
               beside it. *@
            <div class="tape" role="img" title="@Race" aria-label="@Race" style="--edge: @Edge">
                <span class="end p0">@Remaining(0)</span>
                <div class="rail">
                    <span class="wedge @(Ahead == 0 ? "p0" : "p1")"></span>
                </div>
                <span class="end p1">@Remaining(1)</span>
            </div>
        </aside>

        <div class="board-wrap">
            @* AllowPremove below: not your turn and reading the game back are two different
               things, and Interactive is false for both. Only the first of them is a turn
               that is coming, so only the first may be moved for in advance — a click on a
               position from ten plies ago is a player looking, not a player queueing.

               Said here and not among the attributes, which is where it was first written.
               A Razor comment inside an element's attribute list is not removed: the
               compiler emits it as a component parameter whose *name* is the whole of the
               comment text, and Blazor then throws "does not have a property matching the
               name" the first time the board is rendered — so the game screen never draws
               at all. It compiles either way, which is the trap: nothing but running it
               says so. Reproduced by handing the emitted name to
               ParameterView.SetParameterProperties against a real BoardView. *@
            <BoardView State="Shown"
                       Interactive="@(_session.IsHumanTurn && !_thinking && !_session.IsOver && _reviewPly is null)"
                       Reading="_reading"
                       Reviewing="@(_reviewPly is not null)"
                       Flipped="@(_session.LocalSeat == 1)"
                       Holes="_session.Holes"
                       Generation="_session.Setup.GetHashCode()"
                       Collected="@(_reviewPly is null ? _session.LastPickup : null)"
                       Carved="_carved"
                       ConfirmMoves="_confirm"
                       LastMove="ShownLastMove"
                       AllowPremove="@(_reviewPly is null)"
                       Premove="_premove"
                       OnPremove="move => _premove = move"
                       OnMove="OnMove"
                       OnPreview="text => _preview = text" />
        </div>

        <aside class="panel">
            @* The instructions teach themselves in two moves and then become furniture,
               so they retire on their own. The mark brings them back for anyone who
               wants them, and is the only thing left in their place. *@
            <div class="heading">
                <h2>Status</h2>
                <button class="ask @(_showHelp ? "on" : "")" title="How to move"
                        @onclick="() => _showHelp = !_showHelp">?</button>
            </div>

            @* Whose move it is, said out loud. A player who cannot see the board learns the
               turn has passed from this line and from nothing else, and it is already the
               one thing on the page that says so — role="status" only asks the screen
               reader to mention it when it changes, and atomic asks for the whole of it
               rather than the words that differ. *@
            <p class="status" role="status" aria-atomic="true">@Status@(_saidThinking ? "…" : "")</p>

            @{ string note = _preview ?? Hint; }
            @if (note.Length > 0)
            {
                <p class="hint">@note</p>
            }
            @if (_showHelp && Keys.Length > 0)
            {
                <p class="hint keys">@Keys</p>
            }
            @if (EngineLine is { } engine)
            {
                <p class="engine">@engine</p>
            }

            <hr />

            <h2>Moves</h2>
            <ol class="moves">
                @for (int row = 0; row * 2 < _session.Moves.Count; row++)
                {
                    int index = row;
                    bool here = _reviewPly is { } ply && ply > 0 && (ply - 1) / 2 == index;

                    <li class="@(here ? "here" : "")" @onclick="() => Review(Math.Min((index + 1) * 2, _session.Moves.Count))">
                        <span class="n">@(row + 1).</span>
                        <span>@Notation.Format(_session.Moves[row * 2], _session.State)</span>
                        <span>@(row * 2 + 1 < _session.Moves.Count ? Notation.Format(_session.Moves[row * 2 + 1], _session.State) : "")</span>
                    </li>
                }
                @if (_session.Moves.Count == 0)
                {
                    <li class="empty">Nothing played yet.</li>
                }
            </ol>

            @* A greyed-out button that will not say why is a button you press twice and
               then distrust. The reason is on the button itself, where the pointer already
               is when the question comes up. *@
            <div class="actions review">
                <button class="ghost" disabled="@(_session.Moves.Count == 0)" title="@BackNote"
                        @onclick="() => Review((_reviewPly ?? _session.Moves.Count) - 1)">&#x25C0;</button>
                <button class="ghost" disabled="@(_reviewPly is null)" title="@LiveNote"
                        @onclick="() => Review((_reviewPly ?? 0) + 1)">&#x25B6;</button>
                <button class="ghost" disabled="@(_reviewPly is null)" title="@LiveNote"
                        @onclick="() => Review(null)">Live</button>
            </div>

            <hr />

            <div class="actions">
                <button class="ghost" disabled="@(!_session.CanUndo || _thinking)" title="@UndoNote"
                        @onclick="Undo">Undo</button>
                <button class="ghost" @onclick="() => Restart(false)">Restart</button>
            </div>
        </aside>
    </main>

    @if (_showSettings)
    {
        <div class="overlay" @onclick="() => _showSettings = false">
            <div class="setup settings" @onclick:stopPropagation="true">
                <h1>Settings</h1>

                <div class="row">
                    <span class="label">Board</span>
                    <button class="seg @(_reading ? "on" : "")" @onclick="() => Choose(() => _reading = !_reading)">Read the position</button>
                    <button class="seg @(_confirm ? "on" : "")" @onclick="() => Choose(() => _confirm = !_confirm)">Confirm moves</button>
                </div>

                <div class="row">
                    <span class="label">Theme</span>
                    <button class="seg @(!_light ? "on" : "")" @onclick="() => Choose(() => _light = false)">Dark</button>
                    <button class="seg @(_light ? "on" : "")" @onclick="() => Choose(() => _light = true)">Light</button>
                </div>

                @* Two boards, not two of anything else: the same game drawn flat, or drawn
                   as a tray with the pieces standing in it. Flat is the one a first visit
                   gets, because it is the one that never gets in the way of reading the
                   position — the other is there for whoever wants the object. *@
                <div class="row">
                    <span class="label">Style</span>
                    <button class="seg @(!_carved ? "on" : "")" @onclick="() => Choose(() => _carved = false)">Flat</button>
                    <button class="seg @(_carved ? "on" : "")" @onclick="() => Choose(() => _carved = true)">Carved</button>
                </div>

                <div class="row">
                    <span class="label">Sound</span>
                    <button class="seg @(_sound ? "on" : "")" @onclick="ToggleSound">@(_sound ? "On" : "Off")</button>
                    <input class="slider" type="range" min="0" max="100" step="1" disabled="@(!_sound)"
                           value="@_soundVolume"
                           @oninput="e => SetVolume(e.Value, music: false)" />
                    <span class="reading">@_soundVolume%</span>
                </div>

                <div class="row">
                    <span class="label">Music</span>
                    <button class="seg @(_music ? "on" : "")" @onclick="ToggleMusic">@(_music ? "On" : "Off")</button>
                    <input class="slider" type="range" min="0" max="100" step="1" disabled="@(!_music)"
                           value="@_musicVolume"
                           @oninput="e => SetVolume(e.Value, music: true)" />
                    <span class="reading">@_musicVolume%</span>
                </div>

                <div class="row">
                    <span class="label">Track</span>
                    <select class="pick" value="@_track" @onchange="PickTrack">
                        <option value="0">Ink — calm, mid-register</option>
                        <option value="1">Slate — low and sparse</option>
                        <option value="2">Glass — bright, more movement</option>
                    </select>
                </div>

                <p class="fine">This game: @_session.Setup.Describe().</p>

                @if (_session.Setup.Pickups > 0)
                {
                    <PickupGuide Carved="_carved" />
                }

                @* What the board really carries, not what was asked for: a two set on a nine
                   and then rolled onto a five is a rule the player would go looking for and
                   never find. *@
                @if (_session.Setup.ActualPortals > 0)
                {
                    @PortalGuide
                }

                <div class="actions">
                    <button class="ghost primary" @onclick="() => _showSettings = false">Done</button>
                </div>
            </div>
        </div>
    }

    @* Not the instant the game ends. The winning move is the most interesting thing that
       happens all game and the card used to cover it before anybody had looked. *@
    @if (_showResult)
    {
        <div class="overlay">
            <div class="result">
                <h1>@WinnerLabel</h1>
                <p>@_session.Moves.Count moves played</p>
                <div class="actions">
                    <button class="ghost" @onclick="() => Restart(false)">Rematch</button>
                    @if (_session.Mode != WebMode.Hotseat)
                    {
                        <button class="ghost" @onclick="() => Restart(true)">Swap sides</button>
                    }
                    <button class="ghost" @onclick="OpenSetup">New game</button>
                </div>
            </div>
        </div>
    }

    @if (_showSetup)
    {
        <div class="overlay">
            <div class="setup">
                <h1>Quoridor</h1>
                <p class="lead">
                    Cross the board first. Ten walls each to make the other route longer.
                </p>

                <div class="row">
                    <span class="label">Opponent</span>
                    <button class="seg @(_mode == WebMode.VersusBot ? "on" : "")"
                            @onclick="() => SelectMode(WebMode.VersusBot)">The engine</button>
                    <button class="seg @(_mode == WebMode.Hotseat ? "on" : "")"
                            @onclick="() => SelectMode(WebMode.Hotseat)">A friend, here</button>
                    <button class="seg @(_mode == WebMode.Online ? "on" : "")"
                            @onclick="() => SelectMode(WebMode.Online)">A friend, online</button>
                </div>

                @* The three ways in. Most people want the first one and should not have
                   to read past everything the third one can do to reach it. *@
                <div class="row">
                    <span class="label">Game</span>
                    @foreach (GameFlavour option in new[] { GameFlavour.Standard, GameFlavour.Random, GameFlavour.Custom })
                    {
                        GameFlavour choice = option;
                        <button class="seg @(_flavour == choice ? "on" : "")"
                                @onclick="() => _flavour = choice">@choice</button>
                    }
                </div>
                <p class="fine">@FlavourNote</p>

                @if (_mode == WebMode.VersusBot)
                {
                    <div class="row">
                        <span class="label">Strength</span>
                        <select class="pick" value="@((int)_strength)"
                                @onchange="e => _strength = (BotStrength)Number(e, 2)">
                            <option value="0">Easy</option>
                            <option value="1">Normal</option>
                            <option value="2">Hard</option>
                        </select>
                    </div>
                }

                @if (_flavour == GameFlavour.Custom)
                {
                    @if (_mode != WebMode.Hotseat)
                    {
                        <div class="row">
                            <span class="label">You play</span>
                            <select class="pick" value="@_seat" @onchange="e => _seat = Number(e, 0)">
                                <option value="0">First</option>
                                <option value="1">Second</option>
                            </select>
                        </div>
                    }

                    @* Still shown while the link is out. The board is not read until the
                       other player actually connects, so these stay live and the host can
                       keep adjusting while they wait — and taking them away the instant
                       the button was pressed made the card collapse and looked like the
                       settings had been thrown away. Only the player joining loses them,
                       because for them the board is the host's to choose. *@
                    @if (_net.State != NetState.Joining)
                    {
                        <div class="row">
                            <span class="label">Board</span>
                            <select class="pick" value="@_size" @onchange="PickSize">
                                <option value="9">9 × 9 — standard</option>
                                <option value="7">7 × 7 — quick</option>
                                <option value="5">5 × 5 — tiny</option>
                            </select>
                        </div>

                        @* Every one of these lists is the chosen size's own, straight out of
                           Core. A nine's numbers on a five are not a longer game there, they
                           are a board that cannot carry them: 20 walls against 16 slots, and
                           10 pickups against the 4 squares the holes leave. *@
                        <div class="row">
                            <span class="label">Walls each</span>
                            <select class="pick" value="@_walls" @onchange="PickWalls">
                                @foreach (int option in WallChoices)
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        </div>

                        <div class="row">
                            <span class="label">Holes</span>
                            <select class="pick" value="@_holes" @onchange="PickHoles">
                                @foreach (int option in HoleChoices)
                                {
                                    <option value="@option">@ScatterLabel(option, "scattered at random")</option>
                                }
                            </select>
                        </div>

                        <div class="row">
                            <span class="label">Pickups</span>
                            <select class="pick" value="@_pickups" @onchange="PickPickups">
                                @foreach (int option in PickupChoices)
                                {
                                    <option value="@option">@ScatterLabel(option, "a spare wall or a free move")</option>
                                }
                            </select>
                        </div>

                        @* Said for the same reason the portal note is said: a size that offers
                           fewer is following a rule of the game, and a rule nobody states reads
                           as a list that has lost its options. *@
                        @if (SizeNote.Length > 0)
                        {
                            <p class="fine why">@SizeNote</p>
                        }

                        @* Counted in portals, not in squares: a portal's two mouths are one
                           object, unlike a pair of holes or of pickups. The list is the
                           size's own, so a number this board cannot carry is never the one
                           sent over a link. *@
                        <div class="row">
                            <span class="label">Portals</span>
                            <select class="pick" value="@_portals"
                                    disabled="@(PortalChoices.Length == 1)"
                                    @onchange="e => _portals = Number(e, 0)">
                                @foreach (int option in PortalChoices)
                                {
                                    <option value="@option">@PortalLabel(option)</option>
                                }
                            </select>
                        </div>

                        @* A control with nothing in it is a control that looks broken. What
                           the size will and will not carry is a rule of the game, so it is
                           said out loud rather than left to be inferred from a dead list. *@
                        @if (PortalNote.Length > 0)
                        {
                            <p class="fine why">@PortalNote</p>
                        }

                        @if (_pickups > 0)
                        {
                            <PickupGuide Carved="_carved" />
                        }
                        @if (_portals > 0)
                        {
                            @PortalGuide
                        }
                    }
                }
                else if (_flavour == GameFlavour.Random)
                {
                    @* A rolled game may well put pickups or a portal on the board, and the
                       first of either should not be a surprise nobody explained. *@
                    <PickupGuide Carved="_carved" />
                    @PortalGuide
                }

                @if (_mode == WebMode.Online)
                {
                    <div class="online">
                        @if (_net.State == NetState.Idle)
                        {
                            @* Only the player who creates the game picks the board and the
                               sides; the one who opens the link is told what they are. *@
                            <div class="row">
                                <button class="ghost primary" @onclick="HostGame">Create a game</button>
                            </div>
                            <div class="row">
                                <input class="code" placeholder="or paste an invite code"
                                       value="@_joinCode"
                                       @oninput="e => _joinCode = e.Value?.ToString() ?? string.Empty" />
                                <button class="ghost" disabled="@string.IsNullOrWhiteSpace(_joinCode)"
                                        @onclick="JoinGame">Join</button>
                            </div>
                        }
                        else if (_net.State == NetState.Hosting)
                        {
                            <p class="fine">
                                @(string.IsNullOrEmpty(_net.Code)
                                    ? "Setting up…"
                                    : "Send this link to the other player. The game starts the moment they open it.")
                            </p>
                            @if (!string.IsNullOrEmpty(_net.Code))
                            {
                                <div class="row">
                                    <input class="code wide" readonly value="@ShareLink" @onfocus="SelectAll" />
                                    <button class="ghost copy" @onclick="() => Copy(ShareLink)">@CopyLabel</button>
                                </div>
                                <p class="fine">
                                    Or read out the code: <span class="mono">@_net.Code</span>
                                    <button class="ghost copy" @onclick="() => Copy(_net.Code)">@CopyLabel</button>
                                </p>
                            }
                        }
                        else if (_net.State == NetState.Joining)
                        {
                            <p class="fine">Connecting…</p>
                        }
                        else if (_net.State == NetState.Failed)
                        {
                            <p class="fine">@_net.Trouble</p>
                            <div class="row">
                                <button class="ghost" @onclick="ResetNet">Try again</button>
                            </div>
                        }
                    </div>
                }

                @* The prose is welcome on the plain screen and in the way once every knob
                   is open: with Custom showing, it is what pushes the button that actually
                   starts the game below the fold. *@
                @if (_flavour != GameFlavour.Custom)
                {
                    <p class="fine">
                        @if (_mode == WebMode.Online)
                        {
                            <text>
                                The two browsers talk directly to each other over WebRTC — there is no
                                server of ours in the middle. A free public service is used once, only to
                                introduce them; after that the moves never touch a third party. Strict
                                networks sometimes block the direct connection.
                            </text>
                        }
                        else
                        {
                            <text>
                                Click a square to step, or hover the groove between two squares to place a
                                wall. Hard runs a real alpha-beta search — in a browser it gets one thread,
                                so it thinks a little less deeply than the desktop build.
                            </text>
                        }
                    </p>

                    <p class="fine">
                        Prefer it on your desktop?
                        <a href="https://github.com/REPIRK/quoridor/releases/latest/download/Quoridor.exe">
                            Download the Windows app
                        </a>
                        — it adds clocks, engine against engine, game review and play over your
                        own network.
                    </p>
                }

                @if (_mode != WebMode.Online)
                {
                    <div class="actions">
                        <button class="ghost primary" @onclick="StartGame">Play</button>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    // The full engine is the default; the two heuristic bots are the handicap.
    private WebSession _session = new(WebMode.VersusBot, BotStrength.Hard);
    private NetLink _net = default!;

    private WebMode _mode = WebMode.VersusBot;
    private BotStrength _strength = BotStrength.Hard;

    /// <summary>The seat this browser takes in the game being set up. Seat 0 moves first.</summary>
    private int _seat;

    private GameFlavour _flavour = GameFlavour.Standard;

    // The custom knobs, only reachable through the third flavour.
    private int _size = Board.Size;
    private int _walls = Board.WallsPerPlayer;
    private int _holes;
    private int _pickups;
    private int _portals;

    private bool _showSetup = true;
    private bool _showSettings;
    private bool _thinking;
    private bool _engineRunning;
    private bool _light;
    private bool _reading;
    private bool _confirm;

    /// <summary>Whether the board is drawn as an object rather than as a diagram. Off is
    /// the board this game is really about, so off is what a first visit gets.</summary>
    private bool _carved;

    /// <summary>
    /// Whether a card is up over the page. Each of the three is an opaque sheet across the
    /// whole viewport, so the mouse has never been able to reach what is behind one — but
    /// the keyboard could, and now that the board has a caret of its own that is a real
    /// hole: the caret is the third stop on a fresh page, ahead of every control the setup
    /// card offers, and Enter on it plays a move into a game nobody has started yet.
    ///
    /// `inert` is the one thing that says this properly. It takes the whole subtree out of
    /// the tab order and out of hit testing at once, which is what an opaque sheet already
    /// means everywhere except the keyboard.
    /// </summary>
    private bool Covered => _showSetup || _showSettings || _showResult;

    private bool _touch;
    private bool _showHelp;
    private bool _sound = true;
    private bool _music;
    private int _soundVolume = 70;
    private int _musicVolume = 50;
    private int _track;
    private string? _preview;
    private string _joinCode = string.Empty;

    /// <summary>
    /// How many wall pips to draw. Sized once, to the most the row will ever have to
    /// show — pickups can push a player above the starting supply, and a row that grew
    /// as they did would reflow the panel mid-game.
    /// </summary>
    private int WallPips => Math.Min(Board.MaxWalls,
        _session.Setup.Walls + (_session.Setup.Pickups > 0 ? 4 : 0));

    /// <summary>Whether this player's wall supply just grew, which only a pickup does.
    /// Not while stepping back through the game, where nothing is happening now.</summary>
    private bool Gained(int player) =>
        _reviewPly is null && _session.LastMoveTookAWall && _session.LastMover == player;

    /// <summary>A dropdown's new value, or the fallback if the browser sent nonsense.</summary>
    private static int Number(ChangeEventArgs e, int fallback) =>
        int.TryParse(e.Value?.ToString(), out int value) ? value : fallback;

    private string FlavourNote => _flavour switch
    {
        GameFlavour.Random => "Board, walls, holes, pickups, portals and who moves first — all rolled for you.",
        GameFlavour.Custom => "Everything is yours to set.",
        _ => "Nine by nine, ten walls each. The game as it is normally played.",
    };

    // ========================================================= what a size carries ==

    /// <summary>The wall supplies the chosen size can actually be played with.</summary>
    private int[] WallChoices => GameSetup.WallOptions(_size);

    /// <summary>The hole counts the chosen size has squares for.</summary>
    private int[] HoleChoices => GameSetup.HoleOptions(_size);

    /// <summary>The pickup counts left over once the holes have taken theirs.</summary>
    private int[] PickupChoices => GameSetup.PickupOptions(_size);

    /// <summary>The portal counts the chosen size can actually carry.</summary>
    private int[] PortalChoices => GameSetup.PortalOptions(_size);

    /// <summary>
    /// The board size, with every count brought back inside what that size can carry.
    /// A two chosen on a nine cannot be left standing on the control after the board has
    /// become a five: the game would be built without it, and a number shown but not
    /// honoured reads as the generator being unreliable rather than as a rule of the size.
    ///
    /// The same was true of the walls, the holes and the pickups, which kept the nine's
    /// numbers on every board — a five with Holes=10 and Pickups=10 starts as
    /// "5×5 · 0 walls · 10 holes · 4 pickups" while the card still says ten of each,
    /// because Core caps them against its 14 drawable cells.
    /// </summary>
    private void PickSize(ChangeEventArgs e)
    {
        _size = Number(e, Board.Size);

        _walls = Clamped(_walls, WallChoices);
        _holes = Clamped(_holes, HoleChoices);
        _pickups = Clamped(_pickups, PickupChoices);
        _portals = Clamped(_portals, PortalChoices);
    }

    private void PickWalls(ChangeEventArgs e) =>
        _walls = Clamped(Number(e, Board.WallsPerPlayer), WallChoices);

    private void PickHoles(ChangeEventArgs e) => _holes = Clamped(Number(e, 0), HoleChoices);

    private void PickPickups(ChangeEventArgs e) => _pickups = Clamped(Number(e, 0), PickupChoices);

    /// <summary>
    /// A count brought inside what a size offers: the largest option that size carries
    /// which is no bigger than the one asked for. Not a plain minimum, because the result
    /// has to be one of the options the list draws — a value no option carries leaves the
    /// control showing a blank, which reads as the setting having been lost.
    /// </summary>
    private static int Clamped(int count, int[] options)
    {
        int best = options[0];

        foreach (int option in options)
        {
            if (option <= count && option > best) best = option;
        }

        return best;
    }

    /// <summary>The two scattered counts, which read the same way apart from what is
    /// scattered. Zero is "None" rather than "0 — scattered at random".</summary>
    private static string ScatterLabel(int count, string what) =>
        count == 0 ? "None" : $"{count} — {what}";

    /// <summary>
    /// Why a smaller board is offered less of everything. Said only for the five, where
    /// all three lists shorten at once; the seven only loses the top of the wall list,
    /// which is a smaller claim than a paragraph under the controls is worth.
    /// </summary>
    private string SizeNote => _size == 5
        ? "A five has 16 wall slots to the nine's 64, and 14 squares that a hole or a pickup may stand on — so the counts a nine offers are not on this board to give."
        : string.Empty;

    /// <summary>Said in pairs of squares, because that is the unit the count is in.</summary>
    private static string PortalLabel(int count) => count switch
    {
        1 => "1 — one pair of linked squares",
        2 => "2 — two pairs of linked squares",
        _ => "None",
    };

    /// <summary>
    /// Why a size is offered fewer portals than the last one was. A five has nowhere at all
    /// to put a mouth, and a seven has one usable pairing, so a second portal there would
    /// share it and the two would be one objective rather than two.
    /// </summary>
    private string PortalNote => PortalChoices.Length switch
    {
        1 => "No portals on a five. A mouth may not stand on a goal row, next to one, or on the middle row — and on a five that is every row there is.",
        2 => "One portal on a seven. Its two usable rows are a single mirrored pair, and two portals sharing that pair would be one objective rather than two.",
        _ => string.Empty,
    };

    /// <summary>
    /// What a portal does, drawn where the pickups are drawn and in the same voice. It is a
    /// fragment rather than a component of its own only because it is wanted in three places
    /// in this one file — the custom knobs, a rolled game, and the settings panel of a game
    /// already in play.
    ///
    /// Two mouths, not one: a portal is the pair, and a single ring is the half of it that
    /// cannot be walked through.
    /// </summary>
    private RenderFragment PortalGuide => @<div class="guide">
        <div class="line">
            <svg class="glyph" viewBox="0 0 40 28" aria-hidden="true">
                <g class="portal">
                    <path class="link" d="M 10 21 Q 20 28 30 21" />
                    <circle class="rim" cx="10" cy="14" r="8" />
                    <circle class="iris" cx="10" cy="14" r="3.5" />
                    <circle class="rim" cx="30" cy="14" r="8" />
                    <circle class="iris" cx="30" cy="14" r="3.5" />
                </g>
            </svg>
            <div>
                <b>Two squares, one step.</b>
                Stand on either mouth and the other one is next door: crossing costs a move
                and passes the turn, exactly as walking one square does. Nothing is used up,
                so a portal works all game, for whoever is standing on it.
            </div>
        </div>

        <p class="fine">
            Both mouths of a pair are drawn in one colour, so the one you are standing on
            tells you where you would come out. They sit opposite each other under the same
            half turn as the pickups, and no wall can ever close one.
        </p>
    </div>;

    /// <summary>
    /// The board this setup screen describes. Standard is the plain game; Random rolls
    /// everything, seeded from the clock so two games are never the same; Custom is
    /// whatever the knobs say, with a fresh seed so the same numbers still give a
    /// different scatter each time.
    /// </summary>
    private GameSetup BuildSetup() => BuildSetup(_flavour);

    private GameSetup BuildSetup(GameFlavour flavour)
    {
        // The seed is drawn rather than read off the clock. The clock only ticks every
        // few milliseconds, so a rematch taken straight away used to be handed the same
        // number and rebuilt the very board it was asked to replace; and a seed that
        // climbs steadily makes the boards it produces cycle instead of scatter.
        int seed = Random.Shared.Next();

        if (flavour == GameFlavour.Standard) return GameSetup.Standard;

        if (flavour == GameFlavour.Custom)
        {
            return new GameSetup
            {
                Size = _size,
                Walls = _walls,
                Holes = _holes,
                Pickups = _pickups,
                Portals = _portals,
                Seed = seed,
            };
        }

        return GameSetup.Roll(seed);
    }

    /// <summary>A move chosen during the opponent's turn, played the moment ours starts.</summary>
    private Move? _premove;

    /// <summary>Ply being looked at while stepping back; null means live.</summary>
    private int? _reviewPly;

    private GameState Shown => _reviewPly is { } ply ? _session.StateAfter(ply) : _session.State;

    private Move? ShownLastMove => _reviewPly is { } ply
        ? ply > 0 ? _session.Moves[ply - 1] : null
        : _session.LastMove;

    protected override async Task OnInitializedAsync()
    {
        // Before anything is drawn, so that what is drawn is already the player's own.
        await LoadSettings();

        _net = new NetLink(Js);
        _net.Changed += OnNetChanged;
        _net.Received += OnNetMessage;

        // Arriving through an invite link goes straight to connecting.
        var uri = new Uri(Nav.Uri);
        string? invite = System.Web.HttpUtility.ParseQueryString(uri.Query).Get("join");

        if (string.IsNullOrWhiteSpace(invite)) return;

        _mode = WebMode.Online;
        _joinCode = invite;
        await _net.JoinAsync(invite);
    }

    /// <summary>What the move list was last scrolled for, so it is only scrolled again
    /// when the game moved on or the review moved to another row.</summary>
    private (int Played, int? Ply) _listed = (-1, null);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            // Every way a game can end — a move here, the engine's reply, a move arriving
            // over the link — ends with a render, so the wait is started from here rather
            // than from each of them in turn.
            if (_session.IsOver && !_showResult && !_resultHeld)
            {
                _resultHeld = true;
                _ = HoldResult();
            }

            // The list is a fixed height and a game outgrows it about ten moves in,
            // after which the move just played is below the fold — including the one
            // the arrow keys have just stepped to, which is the whole point of pressing
            // them. It follows the game rather than being scrolled by hand every move.
            (int, int?) now = (_session.Moves.Count, _reviewPly);

            if (now != _listed && _page is not null)
            {
                _listed = now;

                try
                {
                    await _page.InvokeVoidAsync("followMoves", _reviewPly is not null);
                }
                catch (Exception)
                {
                    // A list that does not scroll itself is not worth a broken page.
                }
            }

            return;
        }

        // Fetch the sound module now, while nobody is waiting for anything, so the first
        // move does not find itself paying for it.
        _ = LoadSfx();

        // A touch screen has no hover, so one stray tap would move a pawn. Confirmation
        // is the right default there and the wrong one with a mouse — a default being all
        // it is, so a player who has been to the panel and turned it off keeps it off.
        try
        {
            if (await LoadPage() is not { } page) return;

            _keyOwner = DotNetObjectReference.Create(this);
            await page.InvokeVoidAsync("listenForKeys", _keyOwner);

            if (!await page.InvokeAsync<bool>("isCoarsePointer")) return;

            _touch = true;
            if (!_confirmChosen) _confirm = true;

            StateHasChanged();
        }
        catch (Exception)
        {
            // Not worth a broken page if the check is unavailable.
        }
    }

    // ================================================================== keys ==

    private DotNetObjectReference<Play>? _keyOwner;

    /// <summary>
    /// The keyboard, which the desktop build has always had and this one did not. The
    /// map lives here rather than in the script so that what a key does sits beside the
    /// thing it does it to; the script only claims the presses so the page does not
    /// scroll out from under a player who pressed space.
    /// </summary>
    [JSInvokable]
    public void OnKey(string key)
    {
        // While a game is being set up the board behind is not the player's yet.
        if (_showSetup) return;

        if (_showSettings)
        {
            // One way out of the panel, and it is the one everybody tries first.
            if (key is "Escape") { _showSettings = false; StateHasChanged(); }
            return;
        }

        switch (key)
        {
            case "ArrowLeft":
                Review((_reviewPly ?? _session.Moves.Count) - 1);
                break;

            case "ArrowRight":
                Review((_reviewPly ?? 0) + 1);
                break;

            // Back to the live position from anywhere in the game so far.
            case "Escape" when _reviewPly is not null:
                Review(null);
                break;

            case " ":
                _reading = !_reading;
                break;

            case "?":
                _showHelp = !_showHelp;
                break;

            case "ctrl+z" when _session.CanUndo && !_thinking:
                Undo();
                break;

            default:
                return;
        }

        StateHasChanged();
    }

    // ================================================================= review ==

    /// <summary>
    /// Steps back and forth through the game. Null returns to the live position.
    ///
    /// A game with nothing played has no past to step into, and the keyboard could reach
    /// one that the buttons could not: ArrowLeft asked for ply -1, which is not >= 0 and
    /// so fell through to a clamp that produced ply 0 — the live position, marked as
    /// history. The board went non-interactive and the first move of the game could not
    /// be played at all.
    /// </summary>
    private void Review(int? ply)
    {
        int played = _session.Moves.Count;

        if (ply is null || played == 0 || ply >= played)
        {
            _reviewPly = null;
            return;
        }

        _reviewPly = Math.Clamp(ply.Value, 0, played);
        _preview = null;

        // Reading the game back is not waiting for a turn, and a click on the historic
        // board must not be banked as a move to play in the live one. The board stops
        // offering premoves while this is set (AllowPremove below); anything banked
        // before we got here goes now, because it was chosen against a position the
        // player has since stepped away from.
        _premove = null;
    }

    private string ShareLink => $"{Nav.BaseUri}?join={_net.Code}";

    private string Title
    {
        get
        {
            string name = _session.Mode switch
            {
                WebMode.Hotseat => "Two players, one screen",
                WebMode.Online => _net.IsConnected ? "Online game" : "Online game · disconnected",
                _ => $"Versus {_session.Strength.ToString().ToLowerInvariant()} engine",
            };

            return _session.Setup.IsStandard ? name : $"{name} · {_session.Setup.Describe()}";
        }
    }

    private string Status
    {
        get
        {
            if (_session.IsOver) return WinnerLabel;
            if (_saidThinking) return "Thinking";

            if (_session.Mode == WebMode.Online)
                return _session.IsHumanTurn ? "Your move" : "Waiting for your opponent";

            return _session.Mode == WebMode.VersusBot && _session.IsHumanTurn
                ? "Your move"
                : $"{_session.PlayerName(_session.State.SideToMove)} to move";
        }
    }

    private string Hint
    {
        get
        {
            if (_session.IsOver) return "Rematch to play again.";

            if (_session.Mode == WebMode.Online && !_net.IsConnected)
                return _net.Trouble.Length > 0 ? _net.Trouble : "The connection is gone.";

            // Without saying so, a turn that does not pass just looks like the game
            // ignored the other player.
            if (_session.LastMoveWentAgain)
                return "Free move — the turn does not pass. Go again.";

            // The other shape a turn that comes straight back can have, and the one no
            // pickup explains: the rules forfeit a turn nobody can play.
            if (_session.LastTurnForfeited)
                return "Your opponent has no legal move. The turn is forfeited — play again.";

            if (_session.LastMoveTookAWall)
                return "Two spare walls picked up, on top of what you started with.";

            // The one move whose result does not look like its cause: the pawn is
            // suddenly half a board away, having paid a single step for it.
            if (_session.LastMoveCrossedPortal)
                return "Through the portal — one step to the square it is linked to.";

            if (_session.State.WallsOf(_session.State.SideToMove) == 0)
                return "No walls left — it is a straight race now.";

            // How to move is worth saying once. After a couple of moves it has been
            // learned by doing, and a line that never changes is a line you stop
            // reading — so it goes, and the mark by the heading brings it back.
            if (!_showHelp && _session.Moves.Count > 2) return string.Empty;

            return _touch
                ? "Tap a square to step, or the gap between squares for a wall. Tap again to confirm."
                : "Click a square to step, or hover a groove between squares to place a wall.";
        }
    }

    /// <summary>
    /// The keys, shown only with the help open. A shortcut nobody is told about is a
    /// shortcut nobody uses, and a list of them standing over the board all game is the
    /// furniture the help text was retired for being.
    /// </summary>
    private string Keys => _touch || _session.IsOver
        ? string.Empty
        : "Space reads the position · ← → step through the game · Esc returns to it · Ctrl+Z undo";

    // ============================================================ why not, then ==

    /// <summary>
    /// Why Undo is not available, when it is not. Online it never is and that is a rule of
    /// the mode rather than of the position, so it is worth saying even though the button
    /// will never come back to life in that game.
    /// </summary>
    private string? UndoNote
    {
        get
        {
            if (_thinking) return "The engine has the board for a moment.";
            if (_session.CanUndo) return null;

            if (_session.Mode == WebMode.Online)
                return "Taking a move back has to be agreed, and there is no way to ask.";

            return _session.Moves.Count == 0
                ? "Nothing has been played yet."
                : "Not until you have had a move of your own to take back.";
        }
    }

    /// <summary>Why there is nothing to step back to.</summary>
    private string? BackNote => _session.Moves.Count == 0 ? "No moves to step back through yet." : null;

    /// <summary>Why the two forward controls are dead: they only mean something from inside
    /// the game's past, and this is the live position.</summary>
    private string? LiveNote => _reviewPly is null ? "You are at the live position." : null;

    private string WinnerLabel
    {
        get
        {
            int winner = _session.Winner;
            if (winner < 0) return string.Empty;

            if (_session.Mode == WebMode.Hotseat) return $"{_session.PlayerName(winner)} wins";
            if (winner == _session.LocalSeat) return "You win";

            return _session.Mode == WebMode.VersusBot ? "The engine wins" : "Your opponent wins";
        }
    }

    private string? EngineLine
    {
        get
        {
            if (_session.Bot is not SearchAgent engine || engine.LastResult.Depth == 0) return null;

            SearchResult result = engine.LastResult;
            string verdict = result.IsForced
                ? result.Score > 0 ? "engine has a forced win" : "engine is lost"
                : result.Score > 250 ? "engine ahead"
                : result.Score < -250 ? "you ahead"
                : "level";

            return $"depth {result.Depth} · {result.Nodes:N0} nodes · {verdict}";
        }
    }

    // ================================================================== the tape ==

    /// <summary>
    /// How far ahead a player has to be before the bar stops leaning further. Past six
    /// steps the answer is simply "them", and a longer bar would be saying the same thing
    /// louder rather than saying more.
    /// </summary>
    private const int DecisiveLead = 6;

    /// <summary>
    /// The lead, in steps, positive when the first player is closer to home. The half-step
    /// belongs to whoever is on move — they take the next of those steps — which is why
    /// the race is never exactly level and why the bar shifts as the turn passes.
    /// </summary>
    private double Advantage
    {
        get
        {
            (int first, int second) = _session.Distances();

            // Having no route at all is not being a long way behind; it is being out of
            // the race, and the figure should say so rather than pick a number.
            if (first < 0 && second < 0) return 0;
            if (first < 0) return -DecisiveLead;
            if (second < 0) return DecisiveLead;

            double half = _session.IsOver ? 0 : _session.State.SideToMove == 0 ? 0.5 : -0.5;

            return second - first + half;
        }
    }

    /// <summary>Whose end the bar leans toward.</summary>
    private int Ahead => Advantage >= 0 ? 0 : 1;

    /// <summary>
    /// How far over, as the fraction of the rail's half the bar is scaled to. Written
    /// invariantly because it lands in a CSS custom property, and a browser set to a
    /// comma decimal point would be handed a number it can only drop.
    /// </summary>
    private string Edge => Math.Min(Math.Abs(Advantage) / DecisiveLead, 1)
        .ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>What a player has left to walk, short enough to sit at the end of the bar.</summary>
    private string Remaining(int player)
    {
        (int first, int second) = _session.Distances();
        int distance = player == 0 ? first : second;

        return distance < 0 ? "—" : distance == 0 ? "home" : distance.ToString();
    }

    /// <summary>
    /// The figure said out loud, for the title and for anyone reading the page rather than
    /// looking at it. A shape with a sentence attached needs no caption printed beside it.
    /// </summary>
    private string Race
    {
        get
        {
            (int first, int second) = _session.Distances();
            string both = $"{_session.PlayerName(0)} {Walk(first)}, {_session.PlayerName(1)} {Walk(second)}";

            if (first < 0 || second < 0) return $"{both}.";

            int lead = Math.Abs(second - first);

            if (lead == 0)
            {
                return _session.IsOver
                    ? $"{both} — level."
                    : $"{both} — level, and {_session.PlayerName(_session.State.SideToMove)} to move.";
            }

            string leader = _session.PlayerName(second > first ? 0 : 1);

            return $"{both} — {leader} ahead by {lead} {(lead == 1 ? "step" : "steps")}.";
        }
    }

    // Written as a chain rather than a switch on relational patterns: a line that begins
    // with "<" inside a Razor code block is read as the start of a tag, and "< 0 =>" turns
    // the rest of the file into markup.
    private static string Walk(int distance) =>
        distance < 0 ? "has no route"
        : distance == 0 ? "is home"
        : distance == 1 ? "is one step from home"
        : $"is {distance} steps from home";

    // ================================================================== setup ==

    private void OpenSetup()
    {
        _showSetup = true;
        ResetNet();
    }

    private void SelectMode(WebMode mode)
    {
        _mode = mode;
        if (mode != WebMode.Online) ResetNet();
    }

    private void StartGame()
    {
        // A rolled game rolls the order of play too.
        if (_flavour == GameFlavour.Random) _seat = Random.Shared.Next(2);

        _session = new WebSession(_mode, _strength, _seat, BuildSetup(), _flavour);
        _showSetup = false;

        // The game just set up is the one a returning player almost always wants next, so
        // it is written down here — where it has been settled — rather than on every
        // touch of every control on the card.
        Remember();

        // Music cannot start when the page loads, however it was left: a browser will not
        // make a sound until somebody has pressed something. This press is the first one
        // there is, so a piece that was playing last time picks up here.
        if (_music) _ = StartMusic();

        // Last, because it is what hands the board to the engine when the engine opens,
        // and a fast bot answers inside this call.
        ResetPlayState();
    }

    /// <summary>
    /// Begins again, optionally with the players changing places. Online this has to be
    /// agreed, so the same instruction goes to the other browser and both act on it.
    /// </summary>
    private async Task Restart(bool swap)
    {
        bool rolled = _session.Flavour == GameFlavour.Random;

        // A rolled game rolls again — playing the same random board twice is not what
        // "random" was asked for. Standard and Custom are settings, so they stand.
        GameSetup setup = rolled ? BuildSetup(GameFlavour.Random) : _session.Setup;

        int seat = _session.LocalSeat < 0 ? 0 : swap ? _session.LocalSeat ^ 1 : _session.LocalSeat;

        // Random re-rolls who starts as well — but not online, where the seats belong to
        // both players and swapping sides is the only agreed way to change them.
        if (rolled && _session.Mode != WebMode.Online) seat = Random.Shared.Next(2);

        // Online the whole thing is a joint decision, so the other browser is told which
        // board to build and whether the sides changed.
        if (_session.Mode == WebMode.Online)
            await _net.SendAsync($"restart|{(swap ? "swap" : "keep")}|{setup.Encode()}");

        _seat = seat;
        _session = new WebSession(_session.Mode, _session.Strength, _seat, setup, _session.Flavour);
        ResetPlayState();
    }

    /// <summary>
    /// How long a board takes to arrive: the gaps open, then the prizes are laid out.
    /// The delays themselves are worked out in the board component, which keeps them
    /// inside this window however many of each there are.
    /// </summary>
    private const int BoardEntranceMs = 330;

    /// <summary>
    /// Hands the game to the engine when the engine opens — but not before the board has
    /// finished arriving. Every other move already waits for the pawn to land for the
    /// same reason: the search runs on the only thread there is, and an entrance still
    /// playing when it starts stops where it stands. At the start of a game that is a
    /// board with its gaps not yet drawn, which is worse than a stopped pawn: it is a
    /// board that is simply wrong until the search returns.
    /// </summary>
    private async Task OpenGame()
    {
        if (!_session.IsBotTurn) return;

        // A plain board has nothing to arrive, so it has nothing to wait for. The portals
        // count here as the holes and the pickups do: their mouths are drawn with the rest
        // of what the generator laid out, and a search starting mid-entrance freezes them
        // half-arrived. Only at the start of a game: an undo back onto an engine turn also
        // comes through here, and there the board has been on screen all along.
        if (_session.Moves.Count == 0 &&
            (_session.Setup.Holes > 0 || _session.Setup.Pickups > 0 || _session.Setup.ActualPortals > 0))
        {
            await Task.Delay(BoardEntranceMs);
        }

        await RunEngine();
    }

    private void Undo()
    {
        _session.Undo();

        // Which also starts the engine again, if the position we came back to is one it
        // has to answer — taking back the move that won the game is exactly that.
        ResetPlayState();
    }

    // =================================================================== sound ==

    private IJSObjectReference? _sfx;

    /// <summary>
    /// The sounds are synthesised in the browser, so the module is the whole of it —
    /// there is nothing to download and nothing to wait for. Loaded on the first sound
    /// because a page may never make one.
    /// </summary>
    private async Task<IJSObjectReference?> LoadSfx()
    {
        try
        {
            if (_sfx is not null) return _sfx;

            _sfx = await Js.InvokeAsync<IJSObjectReference>("import", "./js/sfx.js");

            // Builds the audio graph while the browser is idle. Left to the first move,
            // it costs that move a fifth of a second and the pawn lurches instead of
            // sliding.
            await _sfx.InvokeVoidAsync("warm");

            // A volume remembered from an earlier visit has to reach the thing that makes
            // the sound, or the slider says one number and the board plays another.
            await _sfx.InvokeVoidAsync("setVolume", _soundVolume / 100.0, _musicVolume / 100.0);

            return _sfx;
        }
        catch (Exception)
        {
            // Audio is a nicety; a browser that refuses it should not break the game.
            return null;
        }
    }

    private async Task Sfx(string kind)
    {
        if (!_sound) return;

        try
        {
            if (await LoadSfx() is { } module) await module.InvokeVoidAsync("play", kind);
        }
        catch (Exception)
        {
        }
    }

    /// <summary>The sound a move makes, and the one the end of the game makes.</summary>
    private async Task SoundFor(Move move)
    {
        // A pickup is the one thing on the board worth its own sound; without it the
        // most interesting move in the game sounds exactly like every other step. A
        // portal step earns one for the opposite reason: it is the one move that does not
        // look like what it is, because the pawn arrives somewhere it never walked to.
        if (_session.LastMoveWentAgain || _session.LastMoveTookAWall)
            await Sfx(_session.LastMoveWentAgain ? "again" : "collect");
        else if (_session.LastMoveCrossedPortal)
            await Sfx("portal");
        else
            await Sfx(move.Kind == MoveKind.Pawn ? "move" : "wall");

        if (!_session.IsOver) return;

        bool ours = _session.Mode == WebMode.Hotseat || _session.Winner == _session.LocalSeat;
        await Sfx(ours ? "win" : "lose");
    }

    private async Task ToggleMusic()
    {
        _music = !_music;
        Remember();

        await StartMusic();
    }

    /// <summary>Switches pieces. Playing already means stopping and starting again.</summary>
    private async Task PickTrack(ChangeEventArgs e)
    {
        _track = Math.Clamp(Number(e, 0), 0, 2);
        Remember();

        if (!_music) return;

        try
        {
            if (await LoadSfx() is { } module) await module.InvokeVoidAsync("music", false);
        }
        catch (Exception)
        {
            return;
        }

        await StartMusic();
    }

    private async Task StartMusic()
    {
        try
        {
            if (await LoadSfx() is not { } module) return;

            await module.InvokeVoidAsync("setVolume", _soundVolume / 100.0, _musicVolume / 100.0);
            await module.InvokeVoidAsync("music", _music, _track);
        }
        catch (Exception)
        {
        }
    }

    /// <summary>Turning the effects on plays one, so the slider can be heard.</summary>
    private async Task ToggleSound()
    {
        _sound = !_sound;
        Remember();

        if (_sound) await Sfx("move");
    }

    private async Task SetVolume(object? value, bool music)
    {
        if (!int.TryParse(value?.ToString(), out int level)) return;

        level = Math.Clamp(level, 0, 100);

        if (music) _musicVolume = level;
        else _soundVolume = level;

        Remember();

        try
        {
            if (await LoadSfx() is not { } module) return;

            await module.InvokeVoidAsync("setVolume", _soundVolume / 100.0, _musicVolume / 100.0);
        }
        catch (Exception)
        {
            return;
        }

        // A volume you cannot hear is a volume you cannot set, so the effects slider
        // makes a sound as it moves.
        if (!music && _sound) await Sfx("move");
    }

    // ============================================================== remembered ==

    /// <summary>
    /// Whether the confirm step was chosen by hand on some earlier visit. A touch screen
    /// turns it on by itself, and it must not turn it back on for the one player who went
    /// looking for the switch and turned it off.
    /// </summary>
    private bool _confirmChosen;

    /// <summary>The board sizes the list offers, which is what a stored one has to be.</summary>
    private static readonly int[] BoardSizes = { 9, 7, 5 };

    /// <summary>
    /// Everything worth carrying to the next visit, as the single line it is stored as.
    /// Named terms rather than a fixed order, so that a setting added later is simply not
    /// found in what an older visit wrote — and takes its default — and one that has
    /// stopped meaning anything can be dropped without invalidating the rest.
    /// </summary>
    private string Settings => string.Join(';', new[]
    {
        $"theme={(_light ? "light" : "dark")}",
        $"style={(_carved ? "carved" : "flat")}",
        $"reading={(_reading ? 1 : 0)}",
        $"confirm={(_confirm ? 1 : 0)}",
        $"sound={(_sound ? 1 : 0)}",
        $"soundvol={_soundVolume}",
        $"music={(_music ? 1 : 0)}",
        $"musicvol={_musicVolume}",
        $"track={_track}",

        // The game last set up, so that coming back to play another one is the same
        // single press it was the first time. An online game is not written down: it
        // cannot be resumed by remembering it, since the invite went with the tab, and
        // opening the card on the online panel with an empty code is a worse start than
        // the one almost everybody wants.
        $"opponent={(_mode == WebMode.Hotseat ? "hotseat" : "engine")}",
        $"strength={(int)_strength}",
        $"game={_flavour}",
        $"size={_size}",
        $"walls={_walls}",
        $"holes={_holes}",
        $"pickups={_pickups}",
        $"portals={_portals}",
    });

    /// <summary>
    /// Takes the stored line back apart. Every value is checked against what the control
    /// it belongs to actually offers, and anything that fails simply leaves the default
    /// standing: what is in storage was written by some other version of this page, or by
    /// somebody with the developer tools open, and neither is a reason to fail to start.
    /// </summary>
    private void ApplySettings(string stored)
    {
        foreach (string term in stored.Split(';', StringSplitOptions.RemoveEmptyEntries))
        {
            int mark = term.IndexOf('=');
            if (mark <= 0) continue;

            string name = term[..mark];
            string value = term[(mark + 1)..];

            switch (name)
            {
                case "theme": _light = value == "light"; break;
                case "style": _carved = value == "carved"; break;
                case "reading": _reading = value == "1"; break;
                case "confirm": _confirm = value == "1"; _confirmChosen = true; break;
                case "sound": _sound = value == "1"; break;
                case "music": _music = value == "1"; break;
                case "soundvol": _soundVolume = Ranged(value, _soundVolume, 100); break;
                case "musicvol": _musicVolume = Ranged(value, _musicVolume, 100); break;
                case "track": _track = Ranged(value, _track, 2); break;

                case "opponent": _mode = value == "hotseat" ? WebMode.Hotseat : WebMode.VersusBot; break;
                case "strength": _strength = (BotStrength)Ranged(value, (int)_strength, 2); break;
                case "game": _flavour = Flavour(value); break;

                case "size": _size = Offered(value, BoardSizes, Board.Size); break;
                case "walls": _walls = Ranged(value, _walls, Board.MaxWalls); break;
                case "holes": _holes = Ranged(value, _holes, Board.CellCount); break;
                case "pickups": _pickups = Ranged(value, _pickups, Board.CellCount); break;
                case "portals": _portals = Ranged(value, _portals, GameSetup.MaxPortals); break;
            }
        }

        // The size and the four counts are stored as separate terms and read in whatever
        // order they arrive in, so what the size will carry is only settled once the whole
        // line is in — the same rule the controls themselves apply, and for the same
        // reason. Every count is checked here rather than as it is read, because until the
        // size is known there is no list to check it against.
        _walls = Clamped(_walls, WallChoices);
        _holes = Clamped(_holes, HoleChoices);
        _pickups = Clamped(_pickups, PickupChoices);
        _portals = Clamped(_portals, PortalChoices);
    }

    /// <summary>A stored number inside the range its control has, or the default. Written
    /// as two comparisons rather than a relational pattern because a Razor code block reads
    /// a line beginning with "&lt;" as the start of a tag.</summary>
    private static int Ranged(string value, int fallback, int highest) =>
        int.TryParse(value, out int number) && number >= 0 && number <= highest ? number : fallback;

    /// <summary>
    /// A stored number, but only one the control in question actually offers. A value no
    /// option carries would leave the list showing a blank, which reads as the setting
    /// having been lost rather than as it never having been possible.
    /// </summary>
    private static int Offered(string value, int[] options, int fallback) =>
        int.TryParse(value, out int number) && Array.IndexOf(options, number) >= 0 ? number : fallback;

    private static GameFlavour Flavour(string value) => value switch
    {
        nameof(GameFlavour.Random) => GameFlavour.Random,
        nameof(GameFlavour.Custom) => GameFlavour.Custom,
        _ => GameFlavour.Standard,
    };

    /// <summary>
    /// Reads the settings back before anything is drawn. After the first render would be
    /// simpler and would also mean a player who chose the light theme is shown the dark
    /// one for a frame on the way in. The module is a few hundred bytes and comes from the
    /// browser's own cache on every visit that has anything stored to read — the one visit
    /// that pays for the round trip is the one where it finds nothing.
    /// </summary>
    private async Task LoadSettings()
    {
        try
        {
            if (await LoadPage() is not { } page) return;

            ApplySettings(await page.InvokeAsync<string>("readSettings"));
        }
        catch (Exception)
        {
            // A visit with nothing remembered is a visit with the defaults, which is
            // exactly what a first visit is.
        }
    }

    /// <summary>
    /// Makes a change from the settings panel and writes the result down. A preference
    /// that has to be set again on every visit is a preference the player stops setting.
    /// </summary>
    private void Choose(Action change)
    {
        change();
        Remember();
    }

    /// <summary>
    /// Stores the settings as they now stand. Started and not awaited: nothing on the page
    /// is waiting to hear whether the browser kept them, and the button that caused it
    /// should not sit pressed while a disk is written to.
    /// </summary>
    private void Remember()
    {
        // Before the module is up nothing has been changed yet — and writing at that point
        // would store the defaults over what we are still in the middle of reading.
        if (_page is null) return;

        _ = RememberAsync();
    }

    private async Task RememberAsync()
    {
        try
        {
            if (_page is { } page) await page.InvokeVoidAsync("writeSettings", Settings);
        }
        catch (Exception)
        {
            // Storage is a convenience; a browser without it should still play.
        }
    }

    /// <summary>
    /// Anything that only made sense for the position we just left — and then handing the
    /// board back to whoever is on move in the new one.
    ///
    /// Restarting the engine used to be each caller's own business, and Undo was the one
    /// caller that did not do it: take a move back onto an engine turn and the game simply
    /// stopped, with the status line saying the engine was to move and nothing ever
    /// happening. Every path that changes the position already comes through here, so this
    /// is the one place that has to remember, and the only one that can forget.
    /// </summary>
    private void ResetPlayState()
    {
        _preview = null;
        _premove = null;
        _reviewPly = null;
        _showResult = false;
        _resultHeld = false;

        // A fresh opponent has no history to guess from, so the strength stands in for
        // one: the full engine is worth announcing, and the two handicapped bots answer
        // faster than the word could be read.
        _lastThinkMs = _session.Strength == BotStrength.Hard ? SlowSearchMs : 0;

        // Not awaited: this is called from Undo and from two network callbacks, none of
        // which is waiting for the engine's reply, and RunEngine repaints for itself. It
        // releases _engineRunning in a finally, so a search that throws leaves the loop
        // startable rather than wedged.
        _ = OpenGame();
    }

    // ================================================================ the finish ==

    /// <summary>Whether the result card is up, which the game being over is not yet.</summary>
    private bool _showResult;

    /// <summary>Whether the wait is already running, so it is only started once.</summary>
    private bool _resultHeld;

    /// <summary>
    /// Long enough to see the move that won and the finish line flooding out from it, and
    /// short enough that it reads as a beat rather than as the page having stopped. The
    /// board's own flourish is --t-win in the stylesheet and finishes inside this.
    /// </summary>
    private const int WinPauseMs = 750;

    private async Task HoldResult()
    {
        await Task.Delay(WinPauseMs);

        _resultHeld = false;

        // A restart or an undo inside the pause takes the card with it: there is no result
        // to show any more, and the wait was for a game that is no longer the one in play.
        if (!_session.IsOver) return;

        _showResult = true;
        StateHasChanged();
    }

    // =================================================================== link ==

    private async Task HostGame() => await _net.HostAsync();

    private async Task JoinGame() => await _net.JoinAsync(_joinCode);

    private void ResetNet()
    {
        _ = _net.SendAsync(string.Empty);
        _ = _net.DisposeAsync().AsTask();

        _net = new NetLink(Js);
        _net.Changed += OnNetChanged;
        _net.Received += OnNetMessage;
    }

    private void OnNetChanged() => InvokeAsync(async () =>
    {
        // The player who created the game chose the sides; the one who opened the link
        // starts on the assumption of the second seat and is told otherwise straight away.
        if (_net.IsConnected && (_session.Mode != WebMode.Online || _showSetup))
        {
            bool host = _net.Code.Length > 0;

            // The player who opened the link takes the second seat and the standard board
            // until told otherwise, which happens immediately.
            GameSetup setup = host ? BuildSetup() : GameSetup.Standard;
            if (!host) _seat = 1;

            // The host's flavour travels with the game, so a rematch on a rolled board
            // rolls again for both of them.
            _session = new WebSession(
                WebMode.Online, BotStrength.Normal, _seat, setup, host ? _flavour : GameFlavour.Standard);
            _showSetup = false;
            ResetPlayState();

            // The host announces the board; the other side asks for it. Announcing alone
            // was one message with no second chance — miss it and that browser plays on a
            // standard board while the game goes on around it, holes and pickups missing
            // and nothing saying so. Asking makes the handshake answerable rather than
            // hopeful, and the answer is idempotent, so arriving twice costs nothing.
            if (host) await _net.SendAsync($"seat|{_seat ^ 1}|{setup.Encode()}");
            else await _net.SendAsync("board?");
        }

        StateHasChanged();
    });

    private void OnNetMessage(string message) => InvokeAsync(async () =>
    {
        // "board?" — the other side asking which board this is. Only the host can answer,
        // and it answers from the session actually in play rather than from the setup
        // screen, so a game already under way is described as it now stands.
        if (message == "board?")
        {
            if (_net.Code.Length > 0 && _session.Mode == WebMode.Online)
                await _net.SendAsync($"seat|{_session.LocalSeat ^ 1}|{_session.Setup.Encode()}");

            return;
        }

        // "seat|<n>|<board>" — the side and the board the other browser has set up, the
        // board as the numbers it was generated from so both sides build the same one.
        // Sent on connecting by whoever created the game, and again whenever asked.
        if (message.StartsWith("seat|"))
        {
            string[] terms = message.Split('|');

            // Seven terms is a board without portals and eight is one with: the portal
            // count is only sent when it is not zero, so every game that could have been
            // played against a build predating portals still can be.
            if (terms.Length is 7 or 8 &&
                int.TryParse(terms[1], out int mine) && mine is 0 or 1 &&
                GameSetup.TryDecode(terms.AsSpan(2), out GameSetup setup))
            {
                _seat = mine;

                if (mine != _session.LocalSeat || setup != _session.Setup)
                {
                    // A board that is not the plain one was rolled or set by the host;
                    // either way this side follows whatever they send on a rematch.
                    _session = new WebSession(
                        WebMode.Online, BotStrength.Normal, _seat, setup, GameFlavour.Standard);

                    ResetPlayState();
                }
            }

            StateHasChanged();
            return;
        }

        // "restart|<swap|keep>|<board>" — begin again, on the board the other side rolled
        // and with the sides they say. Older builds sent "restart" and "restart|swap",
        // which still mean the same thing on the board already in play.
        if (message.StartsWith("restart"))
        {
            string[] terms = message.Split('|');
            bool swap = terms.Length > 1 && terms[1] == "swap";

            // Seven or eight for the same reason as the seat message: the eighth term is
            // the portal count, and it is only there when there is a portal to name.
            GameSetup setup = terms.Length is 7 or 8 && GameSetup.TryDecode(terms.AsSpan(2), out GameSetup sent)
                ? sent
                : _session.Setup;

            _seat = swap ? _session.LocalSeat ^ 1 : _session.LocalSeat;

            _session = new WebSession(
                WebMode.Online, BotStrength.Normal, _seat, setup, _session.Flavour);

            ResetPlayState();
            StateHasChanged();
            return;
        }

        // "move|<ply>|<notation>". The ply guards against a duplicate or a message that
        // overtook another; anything that does not line up is dropped rather than
        // guessed at, because both sides hold the same position and can afford to wait.
        string[] parts = message.Split('|');

        // The seat test is the one that matters: legality alone is checked against
        // whoever is on move, so without it a message arriving on our own turn is
        // applied as our move, and the other browser gets to play both colours.
        if (parts.Length == 3 &&
            parts[0] == "move" &&
            _session.State.SideToMove != _session.LocalSeat &&
            int.TryParse(parts[1], out int ply) &&
            ply == _session.Moves.Count &&
            Notation.TryParse(parts[2], out Move move, _session.State.GoalRow(0)) &&
            _session.Apply(move))
        {
            _ = SoundFor(move);
        }

        StateHasChanged();
        await TryPremoveAsync();
    });

    // =================================================================== play ==

    private async Task OnMove(Move move)
    {
        if (_thinking || !_session.IsHumanTurn) return;

        int ply = _session.Moves.Count;
        if (!_session.Apply(move)) return;

        _preview = null;

        // Deliberately not awaited. The first sound has to fetch its module, and waiting
        // on that once held the engine's reply up for five seconds on a cold load.
        _ = SoundFor(move);

        if (_session.Mode == WebMode.Online)
        {
            await _net.SendAsync($"move|{ply}|{Notation.Format(move, _session.State)}");
            return;
        }

        // Let the move finish moving before the engine takes the thread away. The search
        // runs on the only thread this build has, so anything still animating when it
        // starts simply stops dead and snaps into place when it ends. Playing a person
        // has always looked right for exactly this reason: nothing blocks in between.
        await Task.Delay(MoveAnimationMs);

        await RunEngine();
    }

    /// <summary>
    /// How long the board takes to show a move, matching the pawn's transition in the
    /// stylesheet. The engine waits this out before it starts thinking.
    /// </summary>
    private const int MoveAnimationMs = 330;

    /// <summary>
    /// Plays the move queued during the opponent's turn. Whether it would still be legal
    /// could not be known when it was chosen, so it is checked now and quietly dropped
    /// if their move ruined it.
    /// </summary>
    private async Task TryPremoveAsync()
    {
        if (_premove is not { } queued) return;
        if (!_session.IsHumanTurn || _reviewPly is not null) return;

        _premove = null;

        if (_session.State.IsLegal(queued)) await OnMove(queued);

        // This runs from a network callback or after the engine, not from a Blazor event,
        // so nothing repaints on its own — whether the move was played or dropped.
        StateHasChanged();
    }

    /// <summary>
    /// WebAssembly has one thread, and the search is on it. Showing "Thinking" and then
    /// yielding lets the browser paint that before the page goes quiet for half a second
    /// — without the yield the label would only appear after the search had finished.
    /// </summary>
    private async Task RunEngine()
    {
        // Only ever one of these. The loop yields so the browser can paint "Thinking",
        // and a restart pressed inside that gap would otherwise start a second loop
        // alongside the first, both driving the same game.
        if (_engineRunning) return;
        _engineRunning = true;

        try
        {
            while (true)
            {
                // Read once per turn, and re-read at the top of every one: a restart
                // replaces the session outright, and the loop has to end up driving
                // whichever game is now in play rather than the one it started on.
                WebSession session = _session;
                if (!session.IsBotTurn) break;

                _thinking = true;
                _saidThinking = _lastThinkMs >= SlowSearchMs;

                // A wait worth mentioning is announced and then paid for; one that is
                // over before it can be read is simply taken. Easy answers in a few
                // milliseconds, and the panel used to write "Thinking…" and rub it out
                // again between two frames, which reads as the page glitching rather
                // than as an opponent playing quickly.
                if (_saidThinking)
                {
                    StateHasChanged();
                    await Task.Delay(40);

                    // That yield hands the browser back the thread, and a Restart pressed
                    // inside it is processed before we get it again. Think() only asks
                    // that there be an engine, not that it be the engine's turn, so
                    // pressing on regardless had the engine play the human's opening
                    // move on the new board. Going round again rather than breaking out:
                    // the new game may be one the engine opens, and this loop is the one
                    // holding _engineRunning, so it is the one that has to play it.
                    if (!ReferenceEquals(session, _session) || !session.IsBotTurn) continue;
                }

                // How long the last search took is the only honest guide to how long
                // this one will take, and it costs nothing to keep.
                long started = System.Diagnostics.Stopwatch.GetTimestamp();

                Move move = session.Think();

                _lastThinkMs = (int)System.Diagnostics.Stopwatch.GetElapsedTime(started).TotalMilliseconds;

                session.Apply(move);
                _ = SoundFor(move);

                _thinking = false;
                _saidThinking = false;
                StateHasChanged();

                // Same reason as after a human move: if the engine is about to think
                // again — it found a free move — its pawn has to arrive first.
                await Task.Delay(MoveAnimationMs);
            }
        }
        finally
        {
            _thinking = false;
            _saidThinking = false;
            _engineRunning = false;
        }

        await TryPremoveAsync();
    }

    /// <summary>
    /// How long a search has to take before it is worth telling the player it is running.
    /// Below this the label is gone before the eye has finished moving to it.
    /// </summary>
    private const int SlowSearchMs = 120;

    /// <summary>What the last search cost, which is what the next one is guessed from.</summary>
    private int _lastThinkMs;

    /// <summary>Whether this wait was long enough last time to be worth a word about it.
    /// The engine having the thread is <see cref="_thinking"/>; this is only whether the
    /// panel says so.</summary>
    private bool _saidThinking;

    private async Task SelectAll(FocusEventArgs _) =>
        await Js.InvokeVoidAsync("document.execCommand", "selectAll", false, null);

    /// <summary>Shown on the copy buttons; says so for a moment after one is pressed.</summary>
    private string CopyLabel => _copied ? "Copied" : "Copy";

    private bool _copied;

    private IJSObjectReference? _page;

    private async Task<IJSObjectReference?> LoadPage()
    {
        try
        {
            return _page ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/page.js");
        }
        catch (Exception)
        {
            return null;
        }
    }

    /// <summary>
    /// Puts the invite on the clipboard, and says so on the button for a moment. The
    /// work is in the module: the clipboard API has to be called as a method on the
    /// object that owns it, which an interop path by name cannot do.
    /// </summary>
    private async Task Copy(string text)
    {
        if (string.IsNullOrEmpty(text)) return;

        try
        {
            if (await LoadPage() is not { } page) return;
            if (!await page.InvokeAsync<bool>("copy", text)) return;
        }
        catch (Exception)
        {
            return;
        }

        _copied = true;
        StateHasChanged();

        await Task.Delay(1400);

        _copied = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        await _net.DisposeAsync();

        // The listener holds a reference back into here, so it goes first.
        if (_keyOwner is not null)
        {
            try
            {
                if (_page is not null) await _page.InvokeVoidAsync("stopListeningForKeys");
            }
            catch (Exception)
            {
                // The page is going away; the listener goes with it.
            }

            _keyOwner.Dispose();
            _keyOwner = null;
        }

        foreach (IJSObjectReference? module in new[] { _sfx, _page })
        {
            if (module is null) continue;

            try { await module.DisposeAsync(); } catch (Exception) { /* page is going away */ }
        }
    }
}
