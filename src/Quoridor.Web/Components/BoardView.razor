@*
    The board, in the same fixed 728x728 space the desktop app draws in — so the
    geometry constants below are the same numbers, and the SVG viewBox does the
    scaling that a Viewbox does there.

    Hover works without a mode switch, as on the desktop: every groove between two
    squares is its own target, so which way the wall lies follows from where the
    cursor is rather than from a toggle.
*@

@* A smaller game is played on a centred square of the same grid, so the geometry below
   never changes — the view simply looks at less of it. *@
<svg class="board" viewBox="@ViewBox" preserveAspectRatio="xMidYMid meet" @onmouseleave="ClearHover">

    @* A board is a physical thing; a flat rectangle of one colour is not. The sheen is
       one gradient painted once — no animation, nothing per frame. *@
    <defs>
        <linearGradient id="board-sheen" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="var(--board-top)" />
            <stop offset="100%" stop-color="var(--board-bottom)" />
        </linearGradient>
    </defs>

    <rect class="backdrop" x="@ViewX" y="@ViewY" width="@ViewSize" height="@ViewSize" rx="6" />

    @* Razor claims <text> for its own block syntax, so the coordinate labels are the
       one part of the board that has to be emitted through the render tree directly. *@
    @Coordinates

    @* Taking the second seat turns the board around so that seat is still the near
       edge. Rotating the whole group means every coordinate below — including the hit
       targets, which keep reporting the squares they actually are — stays untouched.
       Only the labels sit outside it, since text upside down is no use to anyone. *@
    <g transform="@(Flipped ? "rotate(180 364 364)" : "")">

    @* Only the squares in the game are drawn. On a smaller board the ring around it
       would otherwise poke into view, since the frame is a clean margin around the
       playable square and the ring's squares start half a cell outside it. *@
    @{ int opened = 0; }
    @for (int row = From; row <= Last; row++)
    {
        for (int col = From; col <= Last; col++)
        {
            bool hole = (Holes & Board.Bit(Board.Index(row, col))) != 0;

            @* Only the gaps are keyed on the game. A plain square is the same square in
               every game and rebuilding it would buy nothing; a gap is what this board
               has that the last one did not, so it gets a fresh element and opens. They
               open in turn rather than at once — a dozen things moving together read as
               one flicker, and the point is to be able to count them. *@
            <rect @key="(hole ? Generation : 0, row, col)"
                  class="cell @(hole ? "hole" : "")"
                  style="@(hole ? $"animation-delay: {Stagger(opened++, HoleCount, 0, 90)}ms" : null)"
                  x="@Origin(col)" y="@Origin(row)" width="@Cell" height="@Cell" rx="3" />
        }
    }

    @* Each player's target row: a wash across the squares and a finish line on the edge. *@
    @for (int player = 0; player < 2; player++)
    {
        int goal = State.GoalRow(player);
        string accent = player == 0 ? "p0" : "p1";

        for (int col = From; col <= Last; col++)
        {
            <rect class="goal @accent" x="@Origin(col)" y="@Origin(goal)" width="@Cell" height="@Cell" rx="3" />
        }

        <rect class="finish @accent" x="@(Origin(From))" y="@(goal == From ? Origin(goal) : Origin(goal) + Cell - 3)"
              width="@(Span * Cell + (Span - 1) * Gap)" height="3" />
    }

    @if (LastMove is { } last)
    {
        <rect class="last @(LastMoverClass)" rx="3"
              x="@(LastX(last) - 3)" y="@(LastY(last) - 3)"
              width="@(LastWidth(last) + 6)" height="@(LastHeight(last) + 6)" />
    }

    @if (ShowRoutes)
    {
        @foreach ((string accent, string points) in Routes())
        {
            <polyline class="route @accent" points="@points" />
        }
    }

    @foreach (int cell in Hints())
    {
        <circle class="hint-dot @(State.SideToMove == 0 ? "p0" : "p1")"
                cx="@Centre(Board.ColOf(cell))" cy="@Centre(Board.RowOf(cell))" r="7" />
    }

    @foreach ((MoveKind kind, int row, int col, int owner) in PlacedWalls())
    {
        bool flat = kind == MoveKind.HorizontalWall;

        <rect class="wall @(owner == 0 ? "p0" : "p1")" rx="2"
              x="@WallX(kind, col)" y="@WallY(kind, row)"
              width="@(flat ? WallLength : Gap)"
              height="@(flat ? Gap : WallLength)" />

        @* A lit edge along the top, or the left of an upright one. A wall is a piece
           standing on the board, and a flat rectangle of colour does not say so. *@
        <rect class="wall-lip" rx="1"
              x="@(WallX(kind, col) + 1)" y="@(WallY(kind, row) + 1)"
              width="@(flat ? WallLength - 2 : 2)"
              height="@(flat ? 2 : WallLength - 2)" />
    }

    @* Whatever is still lying on the board to be picked up. A spare wall is drawn as
       what it gives you; a free move as an arrow going round again. *@
    @{ int laid = 0; List<(int Cell, bool IsWall)> lying = Pickups().ToList(); }
    @foreach ((int cell, bool isWall) in lying)
    {
        int cx = Centre(Board.ColOf(cell));
        int cy = Centre(Board.RowOf(cell));

        @* Positioned by the outer group so the inner one is free to be scaled about its
           own origin — everything inside is drawn around (0,0). Keyed on the game so a
           new board lays them out again; they follow the gaps rather than joining them,
           since a prize is worth reading after the hazard. *@
        <g @key="(Generation, cell)" class="pickup-holder"
           style="animation-delay: @(Stagger(laid++, lying.Count, 60, 110))ms"
           transform="translate(@cx @cy)">
            @if (isWall)
            {
                <g class="pickup wall">
                    <rect x="-13" y="-4" width="26" height="8" rx="2" />
                </g>
            }
            else
            {
                @* A turn coming round again: three quarters of a circle with an arrowhead
                   at the end of it. It says "go again" without a word on it. *@
                <g class="pickup skip">
                    <path class="arc" d="M 6.36 -6.36 A 9 9 0 1 1 -6.36 -6.36" />
                    <path class="head" d="M -2.83 -9.90 L -4.10 -4.10 L -8.63 -8.63 Z" />
                </g>
            }
        </g>
    }

    @* The one taken on the last move, still drawn for a moment while it leaves. Keyed
       on the ply so each collection plays its own burst rather than reviving the last
       one; it is removed from the render as soon as the next move arrives. *@
    @if (Collected is { } taken)
    {
        <g @key="@($"taken-{State.Ply}")" class="pickup-burst @(taken.IsWall ? "wall" : "skip")"
           transform="translate(@Centre(Board.ColOf(taken.Cell)) @Centre(Board.RowOf(taken.Cell)))">
            <circle class="halo" r="15" />
        </g>
    }

    @* What the pointer is aiming at, what is waiting to be confirmed, and what is
       queued for when the turn arrives — the same three shapes, told apart by style. *@
    @foreach ((Move mark, string style) in Marks())
    {
        if (mark.Kind == MoveKind.Pawn)
        {
            <rect class="mark square @style" rx="3"
                  x="@Origin(mark.Col)" y="@Origin(mark.Row)" width="@Cell" height="@Cell" />
        }
        else
        {
            <rect class="mark bar @style" rx="2"
                  x="@WallX(mark.Kind, mark.Col)" y="@WallY(mark.Kind, mark.Row)"
                  width="@(mark.IsHorizontal ? WallLength : Gap)"
                  height="@(mark.IsHorizontal ? Gap : WallLength)" />
        }
    }

    @for (int player = 0; player < 2; player++)
    {
        int cell = State.PawnOf(player);
        bool active = !State.IsGameOver && State.SideToMove == player;

        @* Placed by a transform on the group rather than by the circle's own centre:
           that is what the slide animates, and moving a transform is far cheaper for
           the browser than moving geometry.

           Keyed on the board as well as the player: a pawn slides to where it moved,
           but starting a different-sized game is not a move, and sliding across the
           whole board for it would be nonsense. A new key means a new element, which
           simply appears where it belongs. *@
        <g @key="(player, From)"
           class="pawn-holder @(player == 0 ? "p0" : "p1") @(active ? "active" : "")"
           transform="translate(@Centre(Board.ColOf(cell)) @Centre(Board.RowOf(cell)))">

            @* Whose turn it is should be legible from the board, not only from the
               panel beside it. A ring is a clearer answer than a difference in
               opacity you have to compare two pieces to notice. *@
            <circle class="ring" r="26" />
            <circle class="disc" r="20" />
        </g>
    }

    @* Hit targets last so they sit above everything they select. Squares first,
       grooves after, so a groove wins the few pixels where they overlap. Like the
       squares, they stop at the edge of the game: a groove outside it would offer a
       wall nobody could ever be stopped by. *@
    @for (int row = From; row <= Last; row++)
    {
        for (int col = From; col <= Last; col++)
        {
            int r = row;
            int c = col;

            <rect class="hit" x="@Origin(col)" y="@Origin(row)" width="@Cell" height="@Cell"
                  @onmouseover="() => HoverCell(r, c)" @onclick="Commit" />
        }
    }

    @for (int row = From; row < Last; row++)
    {
        for (int col = From; col <= Last; col++)
        {
            int r = row;
            int c = Math.Min(col, Last - 1);

            <rect class="hit" x="@Origin(col)" y="@(Origin(row) + Cell - 4)" width="@Cell" height="@(Gap + 8)"
                  @onmouseover="() => HoverWall(MoveKind.HorizontalWall, r, c)" @onclick="Commit" />
        }
    }

    @for (int row = From; row <= Last; row++)
    {
        for (int col = From; col < Last; col++)
        {
            int r = Math.Min(row, Last - 1);
            int c = col;

            <rect class="hit" x="@(Origin(col) + Cell - 4)" y="@Origin(row)" width="@(Gap + 8)" height="@Cell"
                  @onmouseover="() => HoverWall(MoveKind.VerticalWall, r, c)" @onclick="Commit" />
        }
    }

    </g>
</svg>

@code {
    private const int Pad = 28;
    private const int Cell = 64;
    private const int Gap = 12;
    private const int Pitch = Cell + Gap;
    private const int Extent = Pad * 2 + Board.Size * Cell + (Board.Size - 1) * Gap;
    private const int WallLength = Cell * 2 + Gap;

    /// <summary>First row and column in the game — non-zero only on a smaller board.</summary>
    private int From => State.GoalRow(0);

    /// <summary>Last row and column in the game.</summary>
    private int Last => State.GoalRow(1);

    private int Span => Last - From + 1;

    private int ViewX => From * Pitch;

    private int ViewY => ViewX;

    private int ViewSize => (Span - 1) * Pitch + Cell + Pad * 2;

    private string ViewBox => $"{ViewX} {ViewY} {ViewSize} {ViewSize}";

    // What the pointer is over, recorded whether or not it is our turn. Dropping it
    // when the turn passes is what made a resting cursor go dead: you would have to
    // move off the square and back before the click would take.
    private int _pointerCell = -1;
    private Move? _pointerWall;

    // Set when a move is waiting to be confirmed. On a phone there is no hover, so a
    // first tap should choose and a second commit, rather than one stray tap moving.
    private Move? _selected;

    private bool _needsRender = true;

    [Parameter, EditorRequired] public GameState State { get; set; }

    [Parameter] public bool Interactive { get; set; }

    [Parameter] public bool ShowRoutes { get; set; }

    /// <summary>Turn the board around, for the player who took the second seat.</summary>
    [Parameter] public bool Flipped { get; set; }

    /// <summary>Squares out of play, drawn as gaps rather than squares.</summary>
    [Parameter] public UInt128 Holes { get; set; }

    /// <summary>
    /// Counts the games, so a new one can be told from a move within one. A rolled board
    /// is a different board every time and the things that make it different — the gaps
    /// and the prizes — are worth a moment to read before the clock starts. Changing this
    /// rebuilds the board's elements, which is what lets their entrance play again.
    /// </summary>
    [Parameter] public int Generation { get; set; }

    private int HoleCount => (int)UInt128.PopCount(Holes);

    /// <summary>
    /// Where the nth of <paramref name="count"/> things falls inside a fixed window,
    /// rather than a step each. The window has to stay put however many there are: this
    /// build has one thread and the search takes it as soon as the pause after a move
    /// runs out, so an entrance still going when that happens stops dead — and stopped
    /// at the start of one of these is stopped at nothing visible. Ten pickups and two
    /// gaps therefore arrive in the same time two pickups do, just closer together.
    /// </summary>
    private static int Stagger(int index, int count, int start, int window) =>
        count <= 1 ? start : start + window * index / (count - 1);

    /// <summary>The pickup taken by the last move, if it took one, for its send-off.</summary>
    [Parameter] public (int Cell, bool IsWall)? Collected { get; set; }

    /// <summary>Require a second tap on the same target before the move is played.</summary>
    [Parameter] public bool ConfirmMoves { get; set; }

    [Parameter] public Move? LastMove { get; set; }

    [Parameter] public EventCallback<Move> OnMove { get; set; }

    /// <summary>A move queued for the moment the turn arrives, or null for none.</summary>
    [Parameter] public Move? Premove { get; set; }

    [Parameter] public EventCallback<Move?> OnPremove { get; set; }

    /// <summary>Reports what the wall under the cursor would cost, or null when there is none.</summary>
    [Parameter] public EventCallback<string?> OnPreview { get; set; }

    protected override void OnParametersSet()
    {
        // The pointer is deliberately not cleared here. What it is over has not changed
        // just because the position did; only what that means has.
        _needsRender = true;
        _selected = null;
    }

    // Mouse movement inside one target must not redraw three hundred elements.
    protected override bool ShouldRender()
    {
        bool render = _needsRender;
        _needsRender = false;
        return render;
    }

    private string LastMoverClass => State.SideToMove == 0 ? "p1" : "p0";

    private RenderFragment Coordinates => builder =>
    {
        int sequence = 0;

        // Only the squares in the game are labelled, against the edges of what is shown
        // rather than of the whole grid, and counted from the game's own corner — a 7x7
        // board runs a1 to g7, which is also what the move list calls those squares.
        for (int i = From; i <= Last; i++)
        {
            // The labels are not rotated with the board, so they are renumbered instead.
            int row = Flipped ? Quoridor.Core.Board.Size - 1 - i : i;

            Label($"{Last - row + 1}", ViewX + 14, Centre(i) + 4);
            Label($"{(char)('a' + row - From)}", Centre(i), ViewY + ViewSize - Pad + 16);
        }

        void Label(string text, int x, int y)
        {
            builder.OpenElement(sequence++, "text");
            builder.AddAttribute(sequence++, "class", "coord");
            builder.AddAttribute(sequence++, "x", x);
            builder.AddAttribute(sequence++, "y", y);
            builder.AddContent(sequence++, text);
            builder.CloseElement();
        }
    };

    // =============================================================== interaction ==

    /// <summary>The move the pointer is currently over, whoever's turn it is.</summary>
    private Move? Pointed => _pointerWall ?? (_pointerCell >= 0 ? Move.ToCell(_pointerCell) : null);

    /// <summary>Legal for the side to move right now. Meaningless during their turn.</summary>
    private bool PointedIsLegal => Pointed is { } move && State.IsLegal(move);

    private void HoverCell(int row, int col)
    {
        int cell = Board.Index(row, col);
        if (_pointerCell == cell && _pointerWall is null) return;

        _pointerCell = cell;
        _pointerWall = null;
        _needsRender = true;

        OnPreview.InvokeAsync(null);
    }

    private void HoverWall(MoveKind kind, int row, int col)
    {
        var candidate = new Move(kind, row, col);
        if (_pointerWall == candidate) return;

        _pointerWall = candidate;
        _pointerCell = -1;
        _needsRender = true;

        OnPreview.InvokeAsync(Interactive ? Describe(candidate, State.IsWallLegal(kind, row, col)) : null);
    }

    private void ClearHover()
    {
        if (_pointerWall is null && _pointerCell < 0) return;

        _pointerWall = null;
        _pointerCell = -1;
        _needsRender = true;

        OnPreview.InvokeAsync(null);
    }

    private async Task Commit()
    {
        if (Pointed is not { } move) return;

        // Not our turn: remember it and play it the moment the turn arrives. Whether it
        // will still be legal is unknowable now, so it is checked then and dropped if
        // the opponent's move ruined it.
        if (!Interactive)
        {
            if (Premove is null || Premove != move) await OnPremove.InvokeAsync(move);
            else await OnPremove.InvokeAsync(null);

            return;
        }

        if (!State.IsLegal(move)) return;

        // With confirmation on, the first tap chooses and the second plays — a phone has
        // no hover, so without it one stray tap would move.
        if (ConfirmMoves && _selected != move)
        {
            _selected = move;
            _needsRender = true;
            return;
        }

        _selected = null;
        await OnMove.InvokeAsync(move);
    }

    /// <summary>
    /// What the wall would actually do. Checking legality already walks both routes,
    /// so the number that decides whether it is worth playing is nearly free.
    /// </summary>
    private string Describe(Move wall, bool legal)
    {
        if (!legal)
        {
            return State.IsSlotFree(wall.Kind, wall.Row, wall.Col)
                ? "That would leave a player with no route at all — not allowed."
                : "No room for a wall there.";
        }

        int mover = State.SideToMove;
        int opponent = mover ^ 1;

        GameState placed = State;
        placed.PlaceWallUnchecked(wall.Kind, wall.Row, wall.Col);

        int them = PathFinder.Distance(placed, opponent) - PathFinder.Distance(State, opponent);
        int us = PathFinder.Distance(placed, mover) - PathFinder.Distance(State, mover);

        string cost = them switch
        {
            0 => "Costs them nothing",
            1 => "Costs them 1 step",
            _ => $"Costs them {them} steps",
        };

        return us == 0 ? $"{cost}, and nothing to you." : $"{cost}, and {us} to you.";
    }

    // =================================================================== contents ==

    /// <summary>Every square still holding something, and whether it is a spare wall.</summary>
    private IEnumerable<(int Cell, bool IsWall)> Pickups()
    {
        UInt128 walls = State.WallPickups;
        UInt128 skips = State.SkipPickups;

        for (int cell = 0; cell < Board.CellCount && (walls | skips) != 0; cell++)
        {
            UInt128 bit = Board.Bit(cell);

            if ((walls & bit) != 0)
            {
                walls &= ~bit;
                yield return (cell, true);
            }
            else if ((skips & bit) != 0)
            {
                skips &= ~bit;
                yield return (cell, false);
            }
        }
    }

    private IEnumerable<(Move Move, string Style)> Marks()
    {
        string side = State.SideToMove == 0 ? "p0" : "p1";

        if (Premove is { } queued) yield return (queued, "premove");

        if (_selected is { } chosen)
        {
            yield return (chosen, $"chosen {side}");
            yield break;
        }

        if (Interactive && Pointed is { } pointed)
            yield return (pointed, PointedIsLegal ? $"aim {side}" : "bad");
    }

    private List<int> Hints()
    {
        var cells = new List<int>(8);
        if (!Interactive || State.IsGameOver) return cells;

        Span<Move> buffer = stackalloc Move[8];
        int count = State.GeneratePawnMoves(buffer);
        for (int i = 0; i < count; i++) cells.Add(buffer[i].Cell);

        return cells;
    }

    private IEnumerable<(MoveKind Kind, int Row, int Col, int Owner)> PlacedWalls()
    {
        for (int slot = 0; slot < Board.SlotCount; slot++)
        {
            int row = slot / Board.SlotSize;
            int col = slot % Board.SlotSize;
            int owner = State.WallOwner(slot);

            if ((State.HorizontalWalls & (1UL << slot)) != 0)
                yield return (MoveKind.HorizontalWall, row, col, owner);

            if ((State.VerticalWalls & (1UL << slot)) != 0)
                yield return (MoveKind.VerticalWall, row, col, owner);
        }
    }

    private List<(string Accent, string Points)> Routes()
    {
        var routes = new List<(string, string)>(2);
        if (State.IsGameOver) return routes;

        Span<byte> distances = stackalloc byte[Board.CellCount];

        for (int player = 0; player < 2; player++)
        {
            var cells = new List<int>(Board.CellCount);

            PathFinder.FillDistancesToGoal(State, player, distances);
            PathFinder.TraceShortestPath(State, player, distances, cells);

            if (cells.Count < 2) continue;

            routes.Add((player == 0 ? "p0" : "p1",
                string.Join(' ', cells.Select(c => $"{Centre(Board.ColOf(c))},{Centre(Board.RowOf(c))}"))));
        }

        return routes;
    }

    // =================================================================== geometry ==

    private static int Origin(int index) => Pad + index * Pitch;

    private static int Centre(int index) => Pad + index * Pitch + Cell / 2;

    private static int WallX(MoveKind kind, int col) =>
        kind == MoveKind.HorizontalWall ? Origin(col) : Origin(col) + Cell;

    private static int WallY(MoveKind kind, int row) =>
        kind == MoveKind.HorizontalWall ? Origin(row) + Cell : Origin(row);

    private static int LastX(Move move) =>
        move.Kind == MoveKind.Pawn ? Origin(move.Col) : WallX(move.Kind, move.Col);

    private static int LastY(Move move) =>
        move.Kind == MoveKind.Pawn ? Origin(move.Row) : WallY(move.Kind, move.Row);

    private static int LastWidth(Move move) => move.Kind switch
    {
        MoveKind.Pawn => Cell,
        MoveKind.HorizontalWall => WallLength,
        _ => Gap,
    };

    private static int LastHeight(Move move) => move.Kind switch
    {
        MoveKind.Pawn => Cell,
        MoveKind.HorizontalWall => Gap,
        _ => WallLength,
    };
}
