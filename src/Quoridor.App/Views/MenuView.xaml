<UserControl x:Class="Quoridor.App.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">

    <Grid>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <StackPanel Width="480">

                <!-- Letters are generated in code so each one can arrive on its own beat. -->
                <StackPanel x:Name="TitleHost" Orientation="Horizontal" Margin="0,0,0,12" />

                <TextBlock x:Name="Tagline"
                           Style="{StaticResource Text.Subtitle}"
                           Text="Cross the board first. Ten walls to make the other route longer." />

                <Rectangle x:Name="Divider"
                           Height="1"
                           HorizontalAlignment="Left"
                           Width="0"
                           Fill="{DynamicResource Brush.Line}"
                           Margin="0,30,0,16" />

                <StackPanel x:Name="MenuItems">
                    <Button x:Name="LocalButton" Style="{StaticResource Button.Menu}" Content="Local match" />
                    <Button x:Name="BotButton" Style="{StaticResource Button.Menu}" Content="Play the bot" />
                    <Button x:Name="SpectateButton" Style="{StaticResource Button.Menu}" Content="Watch two engines" />
                    <Button x:Name="NetworkButton" Style="{StaticResource Button.Menu}" Content="Play over the network" />
                    <Button x:Name="RulesButton" Style="{StaticResource Button.Menu}" Content="How to play" />
                    <Button x:Name="QuitButton" Style="{StaticResource Button.Menu}" Content="Quit" />
                </StackPanel>

                <Grid x:Name="OptionsGrid" Margin="52,26,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Three ways in. Most people want the first, and should not have to
                         read past everything the third can do to find the button. -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource Text.Section}"
                               Text="Game" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <RadioButton x:Name="FlavourStandardOption" GroupName="Flavour"
                                     Style="{StaticResource Button.Segment}" Content="Standard" IsChecked="True" />
                        <RadioButton x:Name="FlavourRandomOption" GroupName="Flavour"
                                     Style="{StaticResource Button.Segment}" Content="Random" />
                        <RadioButton x:Name="FlavourCustomOption" GroupName="Flavour"
                                     Style="{StaticResource Button.Segment}" Content="Custom" />
                    </StackPanel>

                    <TextBlock x:Name="FlavourNote" Grid.Row="1" Grid.ColumnSpan="2"
                               Style="{StaticResource Text.Subtitle}"
                               Margin="0,8,0,0" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Style="{StaticResource Text.Section}"
                               Text="Bot strength" VerticalAlignment="Center" Margin="0,10,0,0" />
                    <ComboBox x:Name="StrengthPick" Grid.Row="2" Grid.Column="1"
                              Style="{StaticResource Pick}" Margin="0,10,0,0"
                              SelectedIndex="2">
                        <ComboBoxItem Content="Easy" />
                        <ComboBoxItem Content="Normal" />
                        <ComboBoxItem Content="Hard" />
                    </ComboBox>

                    <TextBlock Grid.Row="3" Grid.Column="0"
                               Style="{StaticResource Text.Section}"
                               Text="Clock" VerticalAlignment="Center" Margin="0,10,0,0" />
                    <ComboBox x:Name="ClockPick" Grid.Row="3" Grid.Column="1"
                              Style="{StaticResource Pick}" Margin="0,10,0,0"
                              SelectedIndex="0">
                        <ComboBoxItem Content="No clock" />
                        <ComboBoxItem Content="5 min + 3 sec" />
                        <ComboBoxItem Content="3 min + 2 sec" />
                    </ComboBox>

                    <StackPanel x:Name="CustomOptions" Grid.Row="4" Grid.ColumnSpan="2"
                                Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Style="{StaticResource Text.Section}"
                                       Text="You move" VerticalAlignment="Center" Margin="0,10,0,0" />
                            <ComboBox x:Name="OrderPick" Grid.Row="0" Grid.Column="1"
                                      Style="{StaticResource Pick}" Margin="0,10,0,0"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="First" />
                                <ComboBoxItem Content="Second" />
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Style="{StaticResource Text.Section}"
                                       Text="Board" VerticalAlignment="Center" Margin="0,10,0,0" />
                            <ComboBox x:Name="SizePick" Grid.Row="1" Grid.Column="1"
                                      Style="{StaticResource Pick}" Margin="0,10,0,0"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="9 × 9 — standard" />
                                <ComboBoxItem Content="7 × 7 — quick" />
                                <ComboBoxItem Content="5 × 5 — tiny" />
                            </ComboBox>

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Style="{StaticResource Text.Section}"
                                       Text="Walls each" VerticalAlignment="Center" Margin="0,10,0,0" />
                            <ComboBox x:Name="WallsPick" Grid.Row="2" Grid.Column="1"
                                      Style="{StaticResource Pick}" Margin="0,10,0,0"
                                      SelectedIndex="4">
                                <ComboBoxItem Content="0" />
                                <ComboBoxItem Content="3" />
                                <ComboBoxItem Content="5" />
                                <ComboBoxItem Content="7" />
                                <ComboBoxItem Content="10" />
                                <ComboBoxItem Content="14" />
                                <ComboBoxItem Content="20" />
                            </ComboBox>

                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Style="{StaticResource Text.Section}"
                                       Text="Holes" VerticalAlignment="Center" Margin="0,10,0,0" />
                            <ComboBox x:Name="HolesPick" Grid.Row="3" Grid.Column="1"
                                      Style="{StaticResource Pick}" Margin="0,10,0,0"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="None" />
                                <ComboBoxItem Content="2 — scattered at random" />
                                <ComboBoxItem Content="4 — scattered at random" />
                                <ComboBoxItem Content="6 — scattered at random" />
                                <ComboBoxItem Content="10 — scattered at random" />
                            </ComboBox>

                            <TextBlock Grid.Row="4" Grid.Column="0"
                                       Style="{StaticResource Text.Section}"
                                       Text="Pickups" VerticalAlignment="Center" Margin="0,10,0,0" />
                            <ComboBox x:Name="PickupsPick" Grid.Row="4" Grid.Column="1"
                                      Style="{StaticResource Pick}" Margin="0,10,0,0"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="None" />
                                <ComboBoxItem Content="4 — a spare wall or a free move" />
                                <ComboBoxItem Content="6 — a spare wall or a free move" />
                                <ComboBoxItem Content="10 — a spare wall or a free move" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Grid>

            </StackPanel>

            <!-- A real game plays itself here; the board is added in code. -->
            <Grid x:Name="DemoHost"
                  Width="368" Height="368"
                  Margin="64,0,0,0"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False" />

        </StackPanel>

        <Grid VerticalAlignment="Bottom" Margin="30,0,30,24">
            <TextBlock Style="{StaticResource Text.Mono}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Opacity="0.7"
                       Text="Ctrl+T  theme      F11  fullscreen" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SettingsButton"
                        Style="{StaticResource Button.Ghost}"
                        Content="Settings"
                        Margin="0,0,8,0" />
                <Button x:Name="ThemeButton"
                        Style="{StaticResource Button.Ghost}"
                        Content="Light theme" />
            </StackPanel>
        </Grid>

        <!-- ================================================ network overlay ==== -->
        <Grid x:Name="NetworkOverlay"
              Background="{DynamicResource Brush.Overlay}"
              Visibility="Collapsed"
              Opacity="0">
            <Border x:Name="NetworkCard"
                    Style="{StaticResource Card}"
                    MaxWidth="580"
                    Padding="36,32"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="NetworkScale" ScaleX="0.96" ScaleY="0.96" />
                </Border.RenderTransform>

                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Display}" FontSize="30" Text="Play over the network" />

                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,18,0,0"
                               Text="One of you hosts and reads out an address; the other types it in. On the same network this needs nothing else — no account, no server, no internet." />

                    <Rectangle Style="{StaticResource Rule}" Margin="0,22,0,20" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource Text.Section}"
                                   Text="Host moves" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <RadioButton x:Name="HostFirstOption" GroupName="HostOrder"
                                     Style="{StaticResource Button.Segment}" Content="First" IsChecked="True" />
                        <RadioButton x:Name="HostSecondOption" GroupName="HostOrder"
                                     Style="{StaticResource Button.Segment}" Content="Second" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="HostButton" Style="{StaticResource Button.Ghost}"
                                Content="Host a game" Padding="18,9" Margin="0,0,10,0" />
                        <TextBox x:Name="AddressBox"
                                 Width="190"
                                 Padding="10,8"
                                 Margin="0,0,8,0"
                                 VerticalContentAlignment="Center"
                                 FontFamily="Consolas"
                                 FontSize="12.5"
                                 Background="Transparent"
                                 Foreground="{DynamicResource Brush.Text}"
                                 BorderBrush="{DynamicResource Brush.Line}"
                                 BorderThickness="1" />
                        <Button x:Name="JoinButton" Style="{StaticResource Button.Ghost}"
                                Content="Join" Padding="18,9" />
                    </StackPanel>

                    <TextBlock x:Name="NetworkStatus"
                               Style="{StaticResource Text.Body}"
                               Margin="0,20,0,0"
                               TextWrapping="Wrap" />

                    <TextBlock x:Name="NetworkAddresses"
                               Style="{StaticResource Text.Mono}"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap" />

                    <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,20,0,0" TextWrapping="Wrap"
                               Text="Across the internet the host has to forward the port. If that is a nuisance, the browser version connects two people from a link with nothing to set up." />

                    <Button x:Name="CloseNetworkButton"
                            Style="{StaticResource Button.Ghost}"
                            Content="Cancel"
                            HorizontalAlignment="Right"
                            Margin="0,24,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- =============================================== settings overlay ==== -->
        <Grid x:Name="SettingsOverlay"
              Background="{DynamicResource Brush.Overlay}"
              Visibility="Collapsed"
              Opacity="0">
            <Border x:Name="SettingsCard"
                    Style="{StaticResource Card}"
                    MaxWidth="560"
                    Padding="36,32"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="SettingsScale" ScaleX="0.96" ScaleY="0.96" />
                </Border.RenderTransform>

                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Display}" FontSize="30" Text="Settings" />

                    <Grid Margin="0,26,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Text.Section}"
                                   Text="Theme" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                            <RadioButton x:Name="ThemeDarkOption" GroupName="SetTheme"
                                         Style="{StaticResource Button.Segment}" Content="Dark" />
                            <RadioButton x:Name="ThemeLightOption" GroupName="SetTheme"
                                         Style="{StaticResource Button.Segment}" Content="Light" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Text.Section}"
                                   Text="Engine thinks for" VerticalAlignment="Center" Margin="0,14,0,0" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,14,0,0">
                            <RadioButton x:Name="EngineFastOption" GroupName="SetEngine"
                                         Style="{StaticResource Button.Segment}" Content="0.4 s" />
                            <RadioButton x:Name="EngineNormalOption" GroupName="SetEngine"
                                         Style="{StaticResource Button.Segment}" Content="1.2 s" />
                            <RadioButton x:Name="EngineDeepOption" GroupName="SetEngine"
                                         Style="{StaticResource Button.Segment}" Content="3 s" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Text.Section}"
                                   Text="Watched games" VerticalAlignment="Center" Margin="0,14,0,0" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,14,0,0">
                            <RadioButton x:Name="PaceBriskOption" GroupName="SetPace"
                                         Style="{StaticResource Button.Segment}" Content="Brisk" />
                            <RadioButton x:Name="PaceSteadyOption" GroupName="SetPace"
                                         Style="{StaticResource Button.Segment}" Content="Steady" />
                            <RadioButton x:Name="PaceCalmOption" GroupName="SetPace"
                                         Style="{StaticResource Button.Segment}" Content="Calm" />
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Text.Section}"
                                   Text="Routes" VerticalAlignment="Center" Margin="0,14,0,0" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,14,0,0">
                            <RadioButton x:Name="RoutesHiddenOption" GroupName="SetRoutes"
                                         Style="{StaticResource Button.Segment}" Content="On request" />
                            <RadioButton x:Name="RoutesShownOption" GroupName="SetRoutes"
                                         Style="{StaticResource Button.Segment}" Content="Always" />
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Text.Section}"
                                   Text="Sound" VerticalAlignment="Center" Margin="0,14,0,0" />
                        <Grid Grid.Row="4" Grid.Column="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="46" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SoundDial" Grid.Column="0" Style="{StaticResource Dial}"
                                    Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="SoundReading" Grid.Column="1" Style="{StaticResource Text.Mono}"
                                       VerticalAlignment="Center" TextAlignment="Right" />
                        </Grid>

                        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Text.Section}"
                                   Text="Music" VerticalAlignment="Center" Margin="0,14,0,0" />
                        <Grid Grid.Row="5" Grid.Column="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="46" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="MusicDial" Grid.Column="0" Style="{StaticResource Dial}"
                                    Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="MusicReading" Grid.Column="1" Style="{StaticResource Text.Mono}"
                                       VerticalAlignment="Center" TextAlignment="Right" />
                        </Grid>

                        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource Text.Section}"
                                   Text="Track" VerticalAlignment="Center" Margin="0,14,0,0" />
                        <ComboBox x:Name="TrackPick" Grid.Row="6" Grid.Column="1"
                                  Style="{StaticResource Pick}" Margin="0,14,0,0" SelectedIndex="0">
                            <ComboBoxItem Content="Ink — calm, mid-register" />
                            <ComboBoxItem Content="Slate — low and sparse" />
                            <ComboBoxItem Content="Glass — bright, more movement" />
                        </ComboBox>
                    </Grid>

                    <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,24,0,0" TextWrapping="Wrap"
                               Text="Kept in your roaming profile, so the game opens the way you left it." />

                    <Button x:Name="CloseSettingsButton"
                            Style="{StaticResource Button.Ghost}"
                            Content="Done"
                            HorizontalAlignment="Right"
                            Margin="0,26,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================================== rules overlay ==== -->
        <Grid x:Name="RulesOverlay"
              Background="{DynamicResource Brush.Overlay}"
              Visibility="Collapsed"
              Opacity="0">
            <Border x:Name="RulesCard"
                    Style="{StaticResource Card}"
                    MaxWidth="640"
                    Padding="36,32"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="RulesScale" ScaleX="0.96" ScaleY="0.96" />
                </Border.RenderTransform>

                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Display}" FontSize="30" Text="How to play" />

                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,18,0,0"
                               Text="On your turn you either step your pawn one square, or place one of your ten walls. Never both." />
                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,10,0,0"
                               Text="A wall is two squares long and sits in the groove between squares. It blocks movement from both sides." />
                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,10,0,0"
                               Text="A wall may never leave a player with no route at all — the board always stays solvable for both." />
                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,10,0,0"
                               Text="Meet the other pawn face to face and you may hop straight over it. If a wall stands right behind it, step diagonally around instead." />
                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,10,0,0"
                               Text="First pawn to reach the far row wins." />

                    <Rectangle Height="1" Fill="{DynamicResource Brush.Line}" Margin="0,24,0,20" />

                    <!-- What the two things lying on the board do. Drawn at the size they
                         appear at, because a bar and a ring explain nothing on their own. -->
                    <TextBlock Style="{StaticResource Text.Section}" Text="Pickups" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Rectangle Grid.Row="0" Grid.Column="0"
                                   Width="26" Height="8" RadiusX="2" RadiusY="2"
                                   Fill="{DynamicResource Brush.Text}" Opacity="0.45"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Text.Body}"
                                   Text="A spare wall. Step on it and one more wall joins your supply, on top of whatever you started with. The turn passes as usual." />

                        <Canvas Grid.Row="1" Grid.Column="0" Margin="0,12,0,0"
                                Width="24" Height="24"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Path Data="M 6.36 -6.36 A 9 9 0 1 1 -6.36 -6.36"
                                  Stroke="{DynamicResource Brush.Text}" StrokeThickness="2.1"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Opacity="0.62" Canvas.Left="12" Canvas.Top="12" />
                            <Path Data="M -2.83 -9.90 L -4.10 -4.10 L -8.63 -8.63 Z"
                                  Fill="{DynamicResource Brush.Text}"
                                  Opacity="0.62" Canvas.Left="12" Canvas.Top="12" />
                        </Canvas>
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Text.Body}" Margin="0,12,0,0"
                                   Text="A free move. Step on it and the turn does not pass — you move again at once, and your opponent misses theirs. Reaching your goal row with one still wins there and then." />
                    </Grid>

                    <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="They lie in symmetric pairs, so the same chances sit on your opponent's half as on yours. Whoever gets there first takes it." />

                    <Rectangle Height="1" Fill="{DynamicResource Brush.Line}" Margin="0,24,0,20" />

                    <TextBlock Style="{StaticResource Text.Section}" Text="Controls" />
                    <TextBlock Style="{StaticResource Text.Mono}" Margin="0,14,0,0"
                               Text="Click a highlighted square         move your pawn" />
                    <TextBlock Style="{StaticResource Text.Mono}" Margin="0,6,0,0"
                               Text="Hover a groove, then click         place a wall" />
                    <TextBlock Style="{StaticResource Text.Mono}" Margin="0,6,0,0"
                               Text="Right-click / wheel / R            flip the wall" />
                    <TextBlock Style="{StaticResource Text.Mono}" Margin="0,6,0,0"
                               Text="Ctrl+Z  undo      F2  restart      Esc  menu" />

                    <Button x:Name="CloseRulesButton"
                            Style="{StaticResource Button.Ghost}"
                            Content="Got it"
                            HorizontalAlignment="Right"
                            Margin="0,26,0,0" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
