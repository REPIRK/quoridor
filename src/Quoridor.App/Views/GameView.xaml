<UserControl x:Class="Quoridor.App.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">

    <UserControl.Resources>
        <!-- A row of the move list. It is clickable, so it looks clickable before it is
             clicked; and the row being read back is marked by a bar in the gutter rather
             than by its ink alone, which was quiet enough to lose in a list of eighty. The
             gutter is held open on every row so that marking one does not shift the text. -->
        <Style x:Key="LogRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Cell}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== top bar ==== -->
        <Grid Grid.Row="0" Margin="34,26,34,10">
            <Button x:Name="MenuButton"
                    Style="{StaticResource Button.Ghost}"
                    Content="&#x2190;  Menu"
                    HorizontalAlignment="Left" />

            <TextBlock x:Name="ModeLabel"
                       Style="{StaticResource Text.Section}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

            <!-- One button, not a row of toggles. None of it is needed mid-move. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SettingsButton" Style="{StaticResource Button.Ghost}"
                        Content="Settings" Margin="0,0,8,0" />
                <Button x:Name="FullscreenButton" Style="{StaticResource Button.Ghost}" Content="Fullscreen" />
            </StackPanel>
        </Grid>

        <!-- ========================================================== body ===== -->
        <Grid Grid.Row="1" Margin="34,10,34,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel x:Name="PlayerColumn" />

                <!-- The race, as one figure rather than as two numbers on opposite sides of
                     a column that nobody subtracts. Each player's remaining steps sit at
                     their own end in their own ink, and the bar between leans toward
                     whoever gets home first; the size of the lean is the size of the lead.
                     Past six steps it stops leaning further, because past that the answer
                     is simply "them" and a longer bar says the same thing louder.

                     The whole of it is on the figure's own tooltip, which is why nothing is
                     written beside it. -->
                <Grid x:Name="Tape" Margin="0,26,0,0" ToolTipService.InitialShowDelay="350">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TapeFirst" Grid.Column="0"
                               Style="{StaticResource Text.Mono}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Accent0}" />

                    <Grid Grid.Column="1" Height="6" Margin="10,0" ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.ColumnSpan="2" CornerRadius="3"
                                Background="{DynamicResource Brush.Cell}"
                                BorderBrush="{DynamicResource Brush.Line}"
                                BorderThickness="1" />

                        <!-- Half the rail, scaled from the middle outward. One bar and not
                             two: which side it grows to is the edge it grows from, so the
                             turn passing slides the same bar across the middle instead of
                             putting out one and taking in another. -->
                        <Rectangle x:Name="TapeWedge" Grid.Column="0"
                                   RadiusX="3" RadiusY="3"
                                   RenderTransformOrigin="1,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform x:Name="TapeWedgeScale" ScaleX="0" />
                            </Rectangle.RenderTransform>
                        </Rectangle>

                        <!-- Drawn after the bar, so it is never buried by it: a bar leaning
                             slightly is only legible as leaning against something. -->
                        <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Left"
                                   Fill="{DynamicResource Brush.Line}" />
                    </Grid>

                    <TextBlock x:Name="TapeSecond" Grid.Column="2"
                               Style="{StaticResource Text.Mono}"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Accent1}" />
                </Grid>
            </StackPanel>

            <Grid x:Name="BoardHost" Grid.Column="1" Margin="22,0"
                  AutomationProperties.Name="Board" />

            <StackPanel Grid.Column="2" VerticalAlignment="Center">

                <!-- The instructions teach themselves in two moves and are furniture after
                     that, so they retire on their own. The mark brings them back, and is
                     the only thing left standing in their place. -->
                <Grid>
                    <TextBlock Style="{StaticResource Text.Section}" Text="Status"
                               VerticalAlignment="Center" />
                    <Button x:Name="HelpButton"
                            Style="{StaticResource Button.Ghost}"
                            Content="?"
                            Padding="10,2"
                            HorizontalAlignment="Right"
                            ToolTip="How to move" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <!-- Whose move it is, said out loud. A player who cannot see the board
                         learns that the turn has passed from this line and from nothing
                         else, and it is already the one thing here that says so. -->
                    <TextBlock x:Name="StatusText"
                               FontFamily="Sitka Display, Georgia"
                               FontSize="21"
                               Foreground="{DynamicResource Brush.Text}"
                               VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite" />
                    <StackPanel x:Name="ThinkingDots"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                Margin="8,0,0,7"
                                Visibility="Collapsed" />
                </StackPanel>

                <!-- Also a live region, because it is where the keyboard caret names the
                     square it is standing on and what playing there would cost. -->
                <TextBlock x:Name="HintText"
                           Style="{StaticResource Text.Subtitle}"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />

                <TextBlock x:Name="KeysText"
                           Style="{StaticResource Text.Mono}"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <TextBlock x:Name="EngineLine"
                           Style="{StaticResource Text.Mono}"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <Rectangle Style="{StaticResource Rule}" Margin="0,26,0,0" />

                <TextBlock Style="{StaticResource Text.Section}" Text="Moves" Margin="0,20,0,0" />

                <Grid Height="188" Margin="0,10,0,0">
                    <TextBlock x:Name="LogEmpty"
                               Style="{StaticResource Text.Subtitle}"
                               Text="Nothing played yet."
                               VerticalAlignment="Top" />
                    <ScrollViewer x:Name="LogScroller"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="LogPanel" />
                    </ScrollViewer>
                </Grid>

                <!-- ShowOnDisabled throughout: why a control is dead is worth saying, and
                     the moment it is worth saying is when the pointer is already on it. -->
                <StackPanel Orientation="Horizontal" Margin="0,6,0,10">
                    <Button x:Name="ReviewPrevButton" Style="{StaticResource Button.Ghost}"
                            Content="&#x25C0;" Padding="11,4" Margin="0,0,6,0"
                            ToolTipService.ShowOnDisabled="True" />
                    <Button x:Name="ReviewNextButton" Style="{StaticResource Button.Ghost}"
                            Content="&#x25B6;" Padding="11,4" Margin="0,0,6,0"
                            ToolTipService.ShowOnDisabled="True" />
                    <Button x:Name="ReviewLiveButton" Style="{StaticResource Button.Ghost}"
                            Content="Live" Padding="13,4"
                            ToolTipService.ShowOnDisabled="True" />
                </StackPanel>

                <Rectangle Style="{StaticResource Rule}" />

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button x:Name="UndoButton" Style="{StaticResource Button.Ghost}" Content="Undo" Margin="0,0,8,0"
                            ToolTipService.ShowOnDisabled="True" />
                    <Button x:Name="RestartButton" Style="{StaticResource Button.Ghost}" Content="Restart" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ================================================ settings overlay ==== -->
        <Grid x:Name="SettingsOverlay"
              Grid.RowSpan="2"
              Background="{DynamicResource Brush.Overlay}"
              Visibility="Collapsed"
              Opacity="0">

            <Border x:Name="SettingsCard"
                    Style="{StaticResource Card}"
                    MaxWidth="470"
                    Padding="34,30"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="SettingsScale" ScaleX="0.96" ScaleY="0.96" />
                </Border.RenderTransform>

                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Display}" FontSize="30" Text="Settings" />

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="46" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Text.Section}"
                                   Text="Board" VerticalAlignment="Center" />
                        <!-- One switch and not three. Reading the position is a single way
                             of looking at the board, and whatever the board draws for it
                             belongs behind this button rather than behind a list of them. -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                            <Button x:Name="RoutesButton" Style="{StaticResource Button.Ghost}" Content="Reading"
                                    ToolTip="Space. Draws each player's route, and how the position stands." />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Text.Section}"
                                   Text="Theme" VerticalAlignment="Center" Margin="0,14,0,0" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                    Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="ThemeButton" Style="{StaticResource Button.Ghost}" Content="Light" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Text.Section}"
                                   Text="Sound" VerticalAlignment="Center" Margin="0,14,0,0" />
                        <Slider x:Name="SoundDial" Grid.Row="2" Grid.Column="1"
                                Style="{StaticResource Dial}" Margin="0,14,10,0"
                                VerticalAlignment="Center" />
                        <TextBlock x:Name="SoundReading" Grid.Row="2" Grid.Column="2"
                                   Style="{StaticResource Text.Mono}" Margin="0,14,0,0"
                                   VerticalAlignment="Center" TextAlignment="Right" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Text.Section}"
                                   Text="Music" VerticalAlignment="Center" Margin="0,14,0,0" />
                        <Slider x:Name="MusicDial" Grid.Row="3" Grid.Column="1"
                                Style="{StaticResource Dial}" Margin="0,14,10,0"
                                VerticalAlignment="Center" />
                        <TextBlock x:Name="MusicReading" Grid.Row="3" Grid.Column="2"
                                   Style="{StaticResource Text.Mono}" Margin="0,14,0,0"
                                   VerticalAlignment="Center" TextAlignment="Right" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Text.Section}"
                                   Text="Track" VerticalAlignment="Center" Margin="0,14,0,0" />
                        <ComboBox x:Name="TrackPick" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                  Style="{StaticResource Pick}" Margin="0,14,0,0"
                                  MinWidth="0" SelectedIndex="0">
                            <ComboBoxItem Content="Ink — calm, mid-register" />
                            <ComboBoxItem Content="Slate — low and sparse" />
                            <ComboBoxItem Content="Glass — bright, more movement" />
                        </ComboBox>
                    </Grid>

                    <TextBlock x:Name="SettingsNote" Style="{StaticResource Text.Subtitle}"
                               Margin="0,24,0,0" TextWrapping="Wrap" />

                    <Button x:Name="CloseSettingsButton"
                            Style="{StaticResource Button.Ghost}"
                            Content="Done"
                            HorizontalAlignment="Right"
                            Margin="0,24,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================================================== result card ==== -->
        <Grid x:Name="ResultOverlay"
              Grid.RowSpan="2"
              Background="{DynamicResource Brush.Overlay}"
              Visibility="Collapsed"
              Opacity="0">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="ResultShift" Y="18" />
                </StackPanel.RenderTransform>

                <TextBlock x:Name="ResultTitle"
                           Style="{StaticResource Text.Display}"
                           FontSize="50"
                           HorizontalAlignment="Center" />

                <Rectangle Style="{StaticResource Rule}" Width="80" Margin="0,20,0,0" />

                <TextBlock x:Name="ResultDetail"
                           Style="{StaticResource Text.Mono}"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
                    <Button x:Name="RematchButton"
                            Style="{StaticResource Button.Ghost}"
                            Content="Rematch"
                            Padding="22,11"
                            Margin="0,0,10,0" />
                    <Button x:Name="SwapSidesButton"
                            Style="{StaticResource Button.Ghost}"
                            Content="Swap sides"
                            Padding="22,11"
                            Margin="0,0,10,0"
                            Visibility="Collapsed" />
                    <Button x:Name="ResultMenuButton"
                            Style="{StaticResource Button.Ghost}"
                            Content="Main menu"
                            Padding="22,11" />
                </StackPanel>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
