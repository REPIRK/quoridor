<UserControl x:Class="Quoridor.App.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== top bar ==== -->
        <Grid Grid.Row="0" Margin="34,26,34,10">
            <Button x:Name="MenuButton"
                    Style="{StaticResource Button.Ghost}"
                    Content="&#x2190;  Menu"
                    HorizontalAlignment="Left" />

            <TextBlock x:Name="ModeLabel"
                       Style="{StaticResource Text.Section}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

            <!-- One button, not a row of toggles. None of it is needed mid-move. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SettingsButton" Style="{StaticResource Button.Ghost}"
                        Content="Settings" Margin="0,0,8,0" />
                <Button x:Name="FullscreenButton" Style="{StaticResource Button.Ghost}" Content="Fullscreen" />
            </StackPanel>
        </Grid>

        <!-- ========================================================== body ===== -->
        <Grid Grid.Row="1" Margin="34,10,34,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="PlayerColumn" Grid.Column="0" VerticalAlignment="Center" />

            <Grid x:Name="BoardHost" Grid.Column="1" Margin="22,0" />

            <StackPanel Grid.Column="2" VerticalAlignment="Center">

                <TextBlock Style="{StaticResource Text.Section}" Text="Status" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock x:Name="StatusText"
                               FontFamily="Sitka Display, Georgia"
                               FontSize="21"
                               Foreground="{DynamicResource Brush.Text}"
                               VerticalAlignment="Center" />
                    <StackPanel x:Name="ThinkingDots"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                Margin="8,0,0,7"
                                Visibility="Collapsed" />
                </StackPanel>

                <TextBlock x:Name="HintText"
                           Style="{StaticResource Text.Subtitle}"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap" />

                <TextBlock x:Name="EngineLine"
                           Style="{StaticResource Text.Mono}"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <Rectangle Style="{StaticResource Rule}" Margin="0,26,0,0" />

                <TextBlock Style="{StaticResource Text.Section}" Text="Moves" Margin="0,20,0,0" />

                <Grid Height="188" Margin="0,10,0,0">
                    <TextBlock x:Name="LogEmpty"
                               Style="{StaticResource Text.Subtitle}"
                               Text="Nothing played yet."
                               VerticalAlignment="Top" />
                    <ScrollViewer x:Name="LogScroller"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="LogPanel" />
                    </ScrollViewer>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,10">
                    <Button x:Name="ReviewPrevButton" Style="{StaticResource Button.Ghost}"
                            Content="&#x25C0;" Padding="11,4" Margin="0,0,6,0" />
                    <Button x:Name="ReviewNextButton" Style="{StaticResource Button.Ghost}"
                            Content="&#x25B6;" Padding="11,4" Margin="0,0,6,0" />
                    <Button x:Name="ReviewLiveButton" Style="{StaticResource Button.Ghost}"
                            Content="Live" Padding="13,4" />
                </StackPanel>

                <Rectangle Style="{StaticResource Rule}" />

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button x:Name="UndoButton" Style="{StaticResource Button.Ghost}" Content="Undo" Margin="0,0,8,0" />
                    <Button x:Name="RestartButton" Style="{StaticResource Button.Ghost}" Content="Restart" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ================================================ settings overlay ==== -->
        <Grid x:Name="SettingsOverlay"
              Grid.RowSpan="2"
              Background="{DynamicResource Brush.Overlay}"
              Visibility="Collapsed"
              Opacity="0">

            <Border x:Name="SettingsCard"
                    Style="{StaticResource Card}"
                    MaxWidth="470"
                    Padding="34,30"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="SettingsScale" ScaleX="0.96" ScaleY="0.96" />
                </Border.RenderTransform>

                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Display}" FontSize="30" Text="Settings" />

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="46" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Text.Section}"
                                   Text="Board" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                            <Button x:Name="RoutesButton" Style="{StaticResource Button.Ghost}" Content="Routes" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Text.Section}"
                                   Text="Theme" VerticalAlignment="Center" Margin="0,14,0,0" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                    Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="ThemeButton" Style="{StaticResource Button.Ghost}" Content="Light" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Text.Section}"
                                   Text="Sound" VerticalAlignment="Center" Margin="0,14,0,0" />
                        <Slider x:Name="SoundDial" Grid.Row="2" Grid.Column="1"
                                Style="{StaticResource Dial}" Margin="0,14,10,0"
                                VerticalAlignment="Center" />
                        <TextBlock x:Name="SoundReading" Grid.Row="2" Grid.Column="2"
                                   Style="{StaticResource Text.Mono}" Margin="0,14,0,0"
                                   VerticalAlignment="Center" TextAlignment="Right" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Text.Section}"
                                   Text="Music" VerticalAlignment="Center" Margin="0,14,0,0" />
                        <Slider x:Name="MusicDial" Grid.Row="3" Grid.Column="1"
                                Style="{StaticResource Dial}" Margin="0,14,10,0"
                                VerticalAlignment="Center" />
                        <TextBlock x:Name="MusicReading" Grid.Row="3" Grid.Column="2"
                                   Style="{StaticResource Text.Mono}" Margin="0,14,0,0"
                                   VerticalAlignment="Center" TextAlignment="Right" />
                    </Grid>

                    <TextBlock x:Name="SettingsNote" Style="{StaticResource Text.Subtitle}"
                               Margin="0,24,0,0" TextWrapping="Wrap" />

                    <Button x:Name="CloseSettingsButton"
                            Style="{StaticResource Button.Ghost}"
                            Content="Done"
                            HorizontalAlignment="Right"
                            Margin="0,24,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================================================== result card ==== -->
        <Grid x:Name="ResultOverlay"
              Grid.RowSpan="2"
              Background="{DynamicResource Brush.Overlay}"
              Visibility="Collapsed"
              Opacity="0">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="ResultShift" Y="18" />
                </StackPanel.RenderTransform>

                <TextBlock x:Name="ResultTitle"
                           Style="{StaticResource Text.Display}"
                           FontSize="50"
                           HorizontalAlignment="Center" />

                <Rectangle Style="{StaticResource Rule}" Width="80" Margin="0,20,0,0" />

                <TextBlock x:Name="ResultDetail"
                           Style="{StaticResource Text.Mono}"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
                    <Button x:Name="RematchButton"
                            Style="{StaticResource Button.Ghost}"
                            Content="Rematch"
                            Padding="22,11"
                            Margin="0,0,10,0" />
                    <Button x:Name="SwapSidesButton"
                            Style="{StaticResource Button.Ghost}"
                            Content="Swap sides"
                            Padding="22,11"
                            Margin="0,0,10,0"
                            Visibility="Collapsed" />
                    <Button x:Name="ResultMenuButton"
                            Style="{StaticResource Button.Ghost}"
                            Content="Main menu"
                            Padding="22,11" />
                </StackPanel>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
