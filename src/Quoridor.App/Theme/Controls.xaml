<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Durations and easings are defined once so every surface moves with the
         same rhythm; nothing in the app should hand-roll its own timing. -->
    <Duration x:Key="Duration.Fast">0:0:0.16</Duration>
    <Duration x:Key="Duration.Normal">0:0:0.28</Duration>
    <Duration x:Key="Duration.Slow">0:0:0.45</Duration>

    <CubicEase x:Key="Ease.Out" EasingMode="EaseOut" />
    <CubicEase x:Key="Ease.InOut" EasingMode="EaseInOut" />
    <QuinticEase x:Key="Ease.Snap" EasingMode="EaseOut" />

    <!-- ============================================================ text ====

         Three voices, and they never overlap. Sitka — a text serif, not a display
         face — carries the names of things: the wordmark, the menu, the result.
         Sitka italic at small sizes labels the sections, the way a caption is set
         apart in print. Segoe UI handles anything the player has to read quickly,
         and Consolas anything that is really a number: the move log, the board's
         own coordinates.

         No thin-weight geometric sans, no letterspaced all-caps micro-labels. -->

    <Style x:Key="Text.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Sitka Display, Georgia" />
        <Setter Property="FontSize" Value="62" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Text.Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
    </Style>

    <!-- Section label. Set as a caption rather than a dashboard heading. -->
    <Style x:Key="Text.Section" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Sitka Small, Georgia" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
    </Style>

    <!-- ========================================================== panels ====

         A hairline, not a box. Boxing every group is what makes an interface look
         assembled from parts; a rule and some space groups just as clearly. -->

    <Style x:Key="Rule" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{DynamicResource Brush.Line}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="22,20" />
    </Style>

    <!-- ========================================================= buttons ====

         Menu entry: a rule slides out from the gutter and the label steps aside
         for it. No fills, no borders — the motion carries the affordance. -->
    <Style x:Key="Button.Menu" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="Sitka Display, Georgia" />
        <Setter Property="FontSize" Value="23" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" Height="50">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Rectangle x:Name="Rule"
                                   Grid.Column="0"
                                   Width="0" Height="1"
                                   Margin="0,0,16,0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Fill="{DynamicResource Brush.Accent1}" />

                        <ContentPresenter x:Name="Body"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Opacity="0.74"
                                          RenderTransformOrigin="0,0.5">
                            <ContentPresenter.RenderTransform>
                                <TranslateTransform x:Name="Shift" />
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Rule"
                                                     Storyboard.TargetProperty="Width"
                                                     To="32" Duration="{StaticResource Duration.Normal}"
                                                     EasingFunction="{StaticResource Ease.Snap}" />
                                    <DoubleAnimation Storyboard.TargetName="Shift"
                                                     Storyboard.TargetProperty="X"
                                                     To="8" Duration="{StaticResource Duration.Normal}"
                                                     EasingFunction="{StaticResource Ease.Out}" />
                                    <DoubleAnimation Storyboard.TargetName="Body"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="{StaticResource Duration.Fast}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Rule"
                                                     Storyboard.TargetProperty="Width"
                                                     To="0" Duration="{StaticResource Duration.Normal}"
                                                     EasingFunction="{StaticResource Ease.Out}" />
                                    <DoubleAnimation Storyboard.TargetName="Shift"
                                                     Storyboard.TargetProperty="X"
                                                     To="0" Duration="{StaticResource Duration.Normal}"
                                                     EasingFunction="{StaticResource Ease.Out}" />
                                    <DoubleAnimation Storyboard.TargetName="Body"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.74" Duration="{StaticResource Duration.Fast}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Body" Property="Opacity" Value="0.28" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary action: outlined, square-ish, no fill until you touch it. -->
    <Style x:Key="Button.Ghost" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell"
                            Background="Transparent"
                            BorderBrush="{DynamicResource Brush.Line}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Body"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Opacity="0.78" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.Surface}" />
                        </Trigger>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Body"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="{StaticResource Duration.Fast}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Body"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.78" Duration="{StaticResource Duration.Fast}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.32" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented choice (bot strength): the selected one is underscored, not
         filled. Reads as a set of options rather than a row of chips. -->
    <!-- A dropdown, for choices where showing every option at once is noise. Templated
         from scratch because the stock ComboBox brings a Windows chrome with it that
         does not belong on this page. -->
    <Style x:Key="Pick" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="MinWidth" Value="230" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- The foreground has to be handed down explicitly: a stock
                             ToggleButton carries the system's own text colour, and the
                             presenter inside it inherits that rather than the page's —
                             which is black text on a dark card. -->
                        <ToggleButton x:Name="Face"
                                      Focusable="False"
                                      ClickMode="Press"
                                      Foreground="{TemplateBinding Foreground}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Shell"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource Brush.Line}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="11,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ContentPresenter Grid.Column="0"
                                                              Content="{TemplateBinding Content}"
                                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                                              VerticalAlignment="Center" />

                                            <Path Grid.Column="1"
                                                  Margin="12,1,2,0"
                                                  VerticalAlignment="Center"
                                                  Data="M 0 0 L 4 4 L 8 0"
                                                  Stroke="{DynamicResource Brush.Muted}"
                                                  StrokeThickness="1.2" />
                                        </Grid>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Shell" Property="BorderBrush"
                                                    Value="{DynamicResource Brush.Accent1}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>

                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        </ToggleButton>

                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               Focusable="False">
                            <Border Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Line}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="0,4,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.28" Direction="270" />
                                </Border.Effect>

                                <StackPanel IsItemsHost="True" Margin="0,4" />
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Resources>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Row" Background="Transparent" Padding="12,7">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background"
                                            Value="{DynamicResource Brush.Cell}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent1}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
    </Style>

    <!-- A volume slider: a hairline and a dot, nothing else. -->
    <Style x:Key="Dial" TargetType="Slider">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Rectangle Height="2" VerticalAlignment="Center" RadiusX="1" RadiusY="1"
                                   Fill="{DynamicResource Brush.Line}" />

                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="13" Height="13"
                                                     Fill="{DynamicResource Brush.Accent1}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent" Margin="0,0,20,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ContentPresenter x:Name="Body"
                                          Grid.Row="0"
                                          Margin="0,2,0,5"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Opacity="0.55" />

                        <Rectangle x:Name="Underline"
                                   Grid.Row="1"
                                   Height="1.5"
                                   Fill="{DynamicResource Brush.Accent1}"
                                   Opacity="0"
                                   RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform x:Name="UnderlineScale" ScaleX="0.2" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Body" Property="Opacity" Value="1" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Underline"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource Duration.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="UnderlineScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource Duration.Normal}"
                                                         EasingFunction="{StaticResource Ease.Snap}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Underline"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource Duration.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="UnderlineScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.2" Duration="{StaticResource Duration.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
