@using Quoridor.Engine
@* Two enums of this name now reach this file. Quoridor.Session brings its own with the
   desktop's socket peer, and this screen has never used that one — the link here is
   WebRTC through NetLink, which owns the other. Named rather than reordered, because
   which of the two is meant is worth being told rather than inferred from an order. *@
@using NetState = Quoridor.Ui.Game.NetState
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject NavigationManager Nav

<div class="app" data-theme="@(_light ? "light" : "dark")">

    <header class="bar" inert="@Covered">
        <div class="brand">Quoridor</div>
        <div class="mode">@Title</div>
        @* One button, not six. What is behind it is not needed mid-move, and a row of
           toggles above the board is a row of things to read past. *@
        <div class="actions">
            <button class="ghost" @onclick="OpenSetup">New game</button>
            <button class="ghost @(_showSettings ? "on" : "")" @onclick="() => _showSettings = !_showSettings">
                Settings
            </button>
        </div>
    </header>

    <main class="layout" inert="@Covered">

        <aside class="players">
            @for (int seat = 1; seat >= 0; seat--)
            {
                int player = seat;
                bool onMove = !_session.IsOver && _session.State.SideToMove == player;

                <div class="player @(onMove ? "on-move" : "")">
                    <span class="turn @(player == 0 ? "p0" : "p1")"></span>
                    <div class="who">
                        @* The clock sits on the name's own line, at the far end of it. It is
                           the other half of the answer to "whose move is it and how are they
                           doing", which is what this row is for, and a figure that ticks
                           needs to be found once and then only glanced at. *@
                        <div class="line">
                            <div class="name">@_session.PlayerName(player)</div>
                            @if (_session.HasClock)
                            {
                                <div class="clock @(player == 0 ? "p0" : "p1") @(_session.FlaggedPlayer == player ? "flagged" : "")">
                                    @TimeControl.Format(_session.RemainingOf(player))
                                </div>
                            }
                        </div>
                        @* Two spare walls land in this row and nowhere else. The board
                           sees the pickup off where it was taken, but the thing it was
                           taken for arrives here, and arriving in silence is how a prize
                           comes to feel like nothing much happened. Keyed on the ply so
                           each collection plays once. *@
                        <div class="walls @(player == 0 ? "p0" : "p1") @(Gained(player) ? "gained" : "")"
                             @key="@(Gained(player) ? $"gained-{player}-{_session.State.Ply}" : $"walls-{player}")">
                            @for (int i = 0; i < WallPips; i++)
                            {
                                @* The sweep crosses the row in a fixed time however long
                                   the row is, and finishes inside the pause before the
                                   engine takes the thread — as the board's own entrance
                                   does, and for the same reason. *@
                                <i class="@(i < _session.State.WallsOf(player) ? "" : "spent")"
                                   style="@(Gained(player) ? $"animation-delay: {90 * i / Math.Max(1, WallPips - 1)}ms" : null)"></i>
                            }
                            <span class="count">@_session.State.WallsOf(player)</span>
                        </div>
                    </div>
                </div>
            }

            @* The race, as one figure instead of two grey strings on opposite sides of a
               panel that nobody subtracts from each other. Each player's remaining steps
               sit at their own end, and the bar between leans toward whoever gets home
               first — by six steps it is as far over as it goes, because past that the
               answer is simply "them" and a longer bar says nothing more.

               The half-step of being on move is included, so the bar is never exactly
               level and the turn passing is visible here as well as on the board. The
               whole sentence is on the figure itself, which is why nothing is written
               beside it. *@
            <div class="tape" role="img" title="@Race" aria-label="@Race" style="--edge: @Edge">
                <span class="end p0">@Remaining(0)</span>
                <div class="rail">
                    <span class="wedge @(Ahead == 0 ? "p0" : "p1")"></span>
                </div>
                <span class="end p1">@Remaining(1)</span>
            </div>
        </aside>

        <div class="board-wrap">
            @* AllowPremove below: not your turn and reading the game back are two different
               things, and Interactive is false for both. Only the first of them is a turn
               that is coming, so only the first may be moved for in advance — a click on a
               position from ten plies ago is a player looking, not a player queueing. A
               watched game is the third case and it is neither: no turn of theirs is coming
               at all, so a move banked in one would sit on the board and never be played.

               Said here and not among the attributes, which is where it was first written.
               A Razor comment inside an element's attribute list is not removed: the
               compiler emits it as a component parameter whose *name* is the whole of the
               comment text, and Blazor then throws "does not have a property matching the
               name" the first time the board is rendered — so the game screen never draws
               at all. It compiles either way, which is the trap: nothing but running it
               says so. Reproduced by handing the emitted name to
               ParameterView.SetParameterProperties against a real BoardView. *@
            @* Reading below: a watched game is drawn with both routes on whatever the
               player's own preference is. Nobody is being helped — neither seat is theirs
               — and the routes are the only thing that makes two engines pushing each
               other about legible from outside. The desktop does exactly this. It is
               computed rather than stored, so the preference itself is left alone. *@
            <BoardView State="Shown"
                       Interactive="@(_session.IsHumanTurn && !_thinking && !_session.IsOver && _reviewPly is null)"
                       Reading="@(_reading || _session.Options.Mode == GameMode.Spectate)"
                       Reviewing="@(_reviewPly is not null)"
                       Flipped="@(_session.LocalSeat == 1)"
                       Holes="_session.Holes"
                       Generation="_session.Setup.GetHashCode()"
                       Collected="@(_reviewPly is null ? _session.LastPickup : null)"
                       Carved="_carved"
                       Coarse="_touch"
                       ConfirmMoves="_confirm"
                       LastMove="ShownLastMove"
                       AllowPremove="@(_reviewPly is null && _session.Options.Mode != GameMode.Spectate)"
                       Premove="_premove"
                       OnPremove="move => _premove = move"
                       OnMove="OnMove"
                       OnPreview="text => _preview = text" />
        </div>

        <aside class="panel">
            @* The instructions teach themselves in two moves and then become furniture,
               so they retire on their own. The mark brings them back for anyone who
               wants them, and is the only thing left in their place. *@
            <div class="heading">
                <h2>Status</h2>
                <button class="ask @(_showHelp ? "on" : "")" title="How to move"
                        @onclick="() => _showHelp = !_showHelp">?</button>
            </div>

            @* Whose move it is, said out loud. A player who cannot see the board learns the
               turn has passed from this line and from nothing else, and it is already the
               one thing on the page that says so — role="status" only asks the screen
               reader to mention it when it changes, and atomic asks for the whole of it
               rather than the words that differ. *@
            <p class="status" role="status" aria-atomic="true">@Status@(_saidThinking ? "…" : "")</p>

            @{ string note = _preview ?? Hint; }
            @if (note.Length > 0)
            {
                <p class="hint">@note</p>
            }
            @if (_showHelp && Keys.Length > 0)
            {
                <p class="hint keys">@Keys</p>
            }
            @if (EngineLine is { } engine)
            {
                <p class="engine">@engine</p>
            }

            <hr />

            <h2>Moves</h2>
            <ol class="moves">
                @for (int row = 0; row * 2 < _session.Moves.Count; row++)
                {
                    int index = row;
                    bool here = _reviewPly is { } ply && ply > 0 && (ply - 1) / 2 == index;

                    <li class="@(here ? "here" : "")" @onclick="() => Review(Math.Min((index + 1) * 2, _session.Moves.Count))">
                        <span class="n">@(row + 1).</span>
                        <span>@Notation.Format(_session.Moves[row * 2], _session.State)</span>
                        <span>@(row * 2 + 1 < _session.Moves.Count ? Notation.Format(_session.Moves[row * 2 + 1], _session.State) : "")</span>
                    </li>
                }
                @if (_session.Moves.Count == 0)
                {
                    <li class="empty">Nothing played yet.</li>
                }
            </ol>

            @* The five things a player reaches for while a game is on, gathered into one
               element that has no styling of its own. On a wide screen it is invisible —
               the rows inside it sit at the foot of the panel exactly where they were
               written — and on a phone it is the strip along the bottom of the screen,
               under the thumb that is holding the phone rather than at the top edge it
               cannot reach. One group and one set of buttons; only where they are drawn
               differs, which is why this is a wrapper and not a second layout. *@
            <div class="tools">
                @* A greyed-out button that will not say why is a button you press twice and
                   then distrust. The reason is on the button itself, where the pointer
                   already is when the question comes up. *@
                <div class="actions review">
                    <button class="ghost" disabled="@(_session.Moves.Count == 0)" title="@BackNote"
                            @onclick="() => Review((_reviewPly ?? _session.Moves.Count) - 1)">&#x25C0;</button>
                    <button class="ghost" disabled="@(_reviewPly is null)" title="@LiveNote"
                            @onclick="() => Review((_reviewPly ?? 0) + 1)">&#x25B6;</button>
                    <button class="ghost" disabled="@(_reviewPly is null)" title="@LiveNote"
                            @onclick="() => Review(null)">Live</button>
                </div>

                <hr />

                <div class="actions">
                    <button class="ghost" disabled="@(!_session.CanUndo || _thinking)" title="@UndoNote"
                            @onclick="Undo">Undo</button>
                    <button class="ghost" @onclick="() => Restart(false)">Restart</button>
                </div>
            </div>
        </aside>
    </main>

    @* Nine rows, of which a player changed two. What went is written beside what stayed,
       because the cut is the design: Theme and Style were two rows for one question and are
       now one; the sound was a switch, a level, a second switch, a second level and a track
       list — five controls for "how loud", now two sliders where nothing to hear is what off
       means; the engine's three rows are one plus a toggle, and the pace of a watched game
       is only asked about while one is being watched.

       Nothing has been taken away. Every setting the panel used to carry is still set from
       here, and the theme and the look are also the first thing the start screen can reach. *@
    @if (_showSettings)
    {
        <div class="overlay" @onclick="() => _showSettings = false">
            <div class="setup settings" @onclick:stopPropagation="true">
                <h1>Settings</h1>

                @* The two that survive on their own merits: both are read while a game is on,
                   and both change what the board says rather than what it plays. *@
                <div class="row">
                    <span class="label">Board</span>
                    <button class="seg @(_reading ? "on" : "")" @onclick="() => Choose(() => _reading = !_reading)">Read the position</button>
                    <button class="seg @(_confirm ? "on" : "")" @onclick="() => Choose(() => _confirm = !_confirm)">Confirm moves</button>
                </div>

                @* How long the engine may think, in the desktop build's words and with the
                   desktop build's own numbers. What the list stops at is not this screen's
                   decision — the host says, because the host is what knows whether the
                   search has a thread of its own or is borrowing the one drawing the page.

                   The ponder switch rides on the same row as one toggle rather than sitting
                   on a row of its own as a pair. It was "Keeps searching / Idles" against a
                   label, which is three things to read for a question that has a yes and a
                   no — and it is the same subject as the budget beside it: both are the
                   engine being told how much of the machine it may have. Only where there is
                   a spare thread to search on; in a browser the answer is forced, and a
                   control that cannot be moved is worse than no control. *@
                <div class="row">
                    <span class="label">Engine thinks for</span>
                    @foreach (int option in HostProfile.Current.MoveTimes)
                    {
                        int choice = option;
                        <button class="seg @(_moveTimeMs == choice ? "on" : "")"
                                @onclick="() => Choose(() => _moveTimeMs = choice)">@HostProfile.Label(choice)</button>
                    }
                    @if (HostProfile.Current.MayPonder)
                    {
                        <span class="split"></span>
                        <button class="seg @(_ponder ? "on" : "")"
                                @onclick="() => Choose(() => _ponder = !_ponder)">Keeps thinking while you do</button>
                    }
                </div>
                @if (HostProfile.Current.IsLimited)
                {
                    <p class="fine why">@HostProfile.Current.LimitNote</p>
                }

                @* One control where there were three. Nothing to hear is what "off" means, so
                   the level is the switch as well — which is how the desktop settled it, and a
                   switch and a level that are able to disagree are two controls for one
                   answer. The track list belongs to the music and rides with it; it is dead
                   while there is no music to change, which is the only time it says nothing. *@
                <div class="row">
                    <span class="label">Sound</span>
                    <input class="slider" type="range" min="0" max="100" step="1"
                           value="@_soundVolume"
                           @oninput="e => SetVolume(e.Value, music: false)" />
                    <span class="reading">@Level(_soundVolume)</span>
                </div>

                <div class="row">
                    <span class="label">Music</span>
                    <input class="slider" type="range" min="0" max="100" step="1"
                           value="@_musicVolume"
                           @oninput="e => SetVolume(e.Value, music: true)" />
                    <span class="reading">@Level(_musicVolume)</span>
                    <select class="pick track" value="@_track" disabled="@(!_music)" @onchange="PickTrack">
                        <option value="0">Ink — calm, mid-register</option>
                        <option value="1">Slate — low and sparse</option>
                        <option value="2">Glass — bright, more movement</option>
                    </select>
                </div>

                @* Both looks on one row, because they are one question asked twice: what the
                   game looks like sitting there. Neither is changed twice by the same person,
                   and two rows for two switches that are never touched again was two rows
                   spent on nothing. Carved leads because carved is what the game now opens as. *@
                <div class="row">
                    <span class="label">Look</span>
                    <button class="seg @(!_light ? "on" : "")" @onclick="() => Choose(() => _light = false)">Dark</button>
                    <button class="seg @(_light ? "on" : "")" @onclick="() => Choose(() => _light = true)">Light</button>
                    <span class="split"></span>
                    <button class="seg @(_carved ? "on" : "")" @onclick="() => Choose(() => _carved = true)">Carved</button>
                    <button class="seg @(!_carved ? "on" : "")" @onclick="() => Choose(() => _carved = false)">Flat</button>
                </div>

                @* How fast two engines play each other, asked only of somebody who is watching
                   two engines. It was a row on every screen for a mode almost nobody is in,
                   and a setting about a game that is not happening is a row to read past. *@
                @if (PaceMatters)
                {
                    <div class="row">
                        <span class="label">Watched games</span>
                        @foreach ((string name, int pace) in PaceChoices)
                        {
                            int choice = pace;
                            <button class="seg @(_paceMs == choice ? "on" : "")"
                                    @onclick="() => Choose(() => _paceMs = choice)">@name</button>
                        }
                    </div>
                }

                @* What is on the board right now, and what the things lying on it do. Only
                   over a game: opened from the start screen there is no board to describe
                   yet, and the screen behind is already showing the one being chosen. *@
                @if (_started && !_showSetup)
                {
                    <p class="fine">This game: @_session.Setup.Describe().</p>

                    @if (_session.Setup.ActualPickups > 0)
                    {
                        <PickupGuide Carved="_carved" />
                    }

                    @* What the board really carries, not what was asked for: a two set on a
                       nine and then rolled onto a five is a rule the player would go looking
                       for and never find. *@
                    @if (_session.Setup.ActualPortals > 0)
                    {
                        @PortalGuide
                    }
                }

                <div class="actions">
                    <button class="ghost primary" @onclick="() => _showSettings = false">Done</button>
                </div>
            </div>
        </div>
    }

    @* Not the instant the game ends. The winning move is the most interesting thing that
       happens all game and the card used to cover it before anybody had looked. *@
    @if (_showResult)
    {
        <div class="overlay">
            <div class="result">
                <h1>@WinnerLabel</h1>
                <p>@_session.Moves.Count moves played</p>
                <div class="actions">
                    <button class="ghost" @onclick="() => Restart(false)">Rematch</button>
                    @* Only where there are sides to swap. Both seats are this keyboard's in
                       a local match and neither of them is in a watched game. *@
                    @if (_session.LocalSeat >= 0)
                    {
                        <button class="ghost" @onclick="() => Restart(true)">Swap sides</button>
                    }
                    <button class="ghost" @onclick="OpenSetup">New game</button>
                </div>
            </div>
        </div>
    }

    @* =========================================================== the start screen ==

       What the app opens on, and what "New game" comes back to. It was a card on a sheet
       over a board nobody had set up yet — a modal standing in for a screen — which is why
       ten rows had to be stacked down the width of a phone, and why the card was reliably
       taller than the phone it was drawn on.

       It owns the window now, the way the desktop's menu does: the choices down one side
       and the board they describe down the other, in two columns where there are two
       columns to be had and in one where there are not. The rows are the same rows; what
       changed is that they are in two named groups with air between them instead of a
       stack of ten, because a screen has room a card never had.

       The desktop plays a real game on the board beside its menu — two engines pushing each
       other about behind the choices. This one does not, and that is a decision rather than
       an omission: see the preview below. *@
    @if (_showSetup)
    {
        @* A card raised over this screen owns the keyboard while it is up, exactly as the
           board behind is handed over while this screen is up. *@
        <div class="overlay screen" inert="@(_showSettings || _showResult || _showLeave)">
            <div class="setup start">

                <div class="banner">
                    <div>
                        <h1>Quoridor</h1>
                        <p class="lead">
                            Cross the board first. Ten walls each to make the other route longer.
                        </p>
                    </div>

                    @* A game already on the board is not lost by looking at this screen, and
                       the way back to it has to be visible rather than known. There was none:
                       the card had no exit but starting another game, so "New game" pressed
                       by mistake ended the one in progress — with the phone's back gesture
                       the single undocumented way out, and nothing at all in a browser. *@
                    @if (_started)
                    {
                        <button class="ghost" @onclick="() => _showSetup = false">Back to your game</button>
                    }
                </div>

                <div class="choices">

                    @* Who is in the other seat. The fourth is the odd one out and is last for
                       that reason: it is the only one that is not an opponent, because in it
                       nobody at this screen plays at all. It is the desktop's "Watch two
                       engines", and it is here for the same reason the clock is — the game
                       behind the screen could always do it. *@
                    <section class="group">
                        <h2>Opponent</h2>

                        <div class="row">
                            <button class="seg @(_mode == GameMode.VersusBot ? "on" : "")"
                                    @onclick="() => SelectMode(GameMode.VersusBot)">The engine</button>
                            <button class="seg @(_mode == GameMode.Hotseat ? "on" : "")"
                                    @onclick="() => SelectMode(GameMode.Hotseat)">A friend, here</button>
                            <button class="seg @(_mode == GameMode.Online ? "on" : "")"
                                    @onclick="() => SelectMode(GameMode.Online)">A friend, online</button>
                            <button class="seg @(_mode == GameMode.Spectate ? "on" : "")"
                                    @onclick="() => SelectMode(GameMode.Spectate)">Two engines</button>
                        </div>

                        @* Also asked of a watched game, where it is the second engine's
                           strength: the first is always the full search, so what the strength
                           picks is who it is playing. The desktop asks the same question in
                           the same place. *@
                        @if (_mode is GameMode.VersusBot or GameMode.Spectate)
                        {
                            <div class="row">
                                <span class="label">Strength</span>
                                <select class="pick" value="@((int)_strength)"
                                        @onchange="e => _strength = (BotStrength)Number(e, 2)">
                                    <option value="0">Easy</option>
                                    <option value="1">Normal</option>
                                    <option value="2">Hard</option>
                                </select>
                            </div>
                        }

                        @* Offered where it can be kept: a network game would have to agree the
                           clock and keep the two of them in step, and there is no message for
                           either — so rather than show a control that quietly does nothing, it
                           is not shown. A watched game has no clock for the same reason the
                           desktop's has none: nobody is being kept waiting. *@
                        @if (_mode is GameMode.VersusBot or GameMode.Hotseat)
                        {
                            <div class="row">
                                <span class="label">Clock</span>
                                @foreach (TimeControl option in ClockChoices)
                                {
                                    TimeControl choice = option;
                                    <button class="seg @(_clock == choice ? "on" : "")"
                                            @onclick="() => _clock = choice">@ClockLabel(choice)</button>
                                }
                            </div>
                        }
                    </section>

                    @* And what it is played on. The three ways in: most people want the first
                       and should not have to read past everything the third can do to reach
                       it, which is why the six rows behind Custom stay behind Custom. *@
                    <section class="group">
                        <h2>Board</h2>

                        <div class="row">
                            @foreach (GameFlavour option in new[] { GameFlavour.Standard, GameFlavour.Random, GameFlavour.Custom })
                            {
                                GameFlavour choice = option;
                                <button class="seg @(_flavour == choice ? "on" : "")"
                                        @onclick="() => SelectFlavour(choice)">@choice</button>
                            }
                        </div>
                        <p class="fine note">@FlavourNote</p>

                        @if (_flavour == GameFlavour.Custom)
                        {
                            @if (_mode is GameMode.VersusBot or GameMode.Online)
                            {
                                <div class="row">
                                    <span class="label">You play</span>
                                    <select class="pick" value="@_seat" @onchange="PickSeat">
                                        <option value="0">First</option>
                                        <option value="1">Second</option>
                                    </select>
                                </div>
                            }

                            @* Still shown while the link is out. The board is not read until
                               the other player actually connects, so these stay live and the
                               host can keep adjusting while they wait — and taking them away
                               the instant the button was pressed made the card collapse and
                               looked like the settings had been thrown away. Only the player
                               joining loses them, because for them the board is the host's to
                               choose. *@
                            @if (_net.State != NetState.Joining)
                            {
                                <div class="row">
                                    <span class="label">Size</span>
                                    <select class="pick" value="@_size" @onchange="PickSize">
                                        <option value="9">9 × 9 — standard</option>
                                        <option value="7">7 × 7 — quick</option>
                                        <option value="5">5 × 5 — tiny</option>
                                    </select>
                                </div>

                                @* Every one of these lists is the chosen size's own, straight
                                   out of Core. A nine's numbers on a five are not a longer
                                   game there, they are a board that cannot carry them: 20
                                   walls against 16 slots, and 10 pickups against the 4 squares
                                   the holes leave. *@
                                <div class="row">
                                    <span class="label">Walls each</span>
                                    <select class="pick" value="@_walls" @onchange="PickWalls">
                                        @foreach (int option in WallChoices)
                                        {
                                            <option value="@option">@option</option>
                                        }
                                    </select>
                                </div>

                                <div class="row">
                                    <span class="label">Holes</span>
                                    <select class="pick" value="@_holes" @onchange="PickHoles">
                                        @foreach (int option in HoleChoices)
                                        {
                                            <option value="@option">@ScatterLabel(option, "scattered at random")</option>
                                        }
                                    </select>
                                </div>

                                <div class="row">
                                    <span class="label">Pickups</span>
                                    <select class="pick" value="@_pickups" @onchange="PickPickups">
                                        @foreach (int option in PickupChoices)
                                        {
                                            <option value="@option">@ScatterLabel(option, "a spare wall or a free move")</option>
                                        }
                                    </select>
                                </div>

                                @* Said for the same reason the portal note is said: a size that
                                   offers fewer is following a rule of the game, and a rule
                                   nobody states reads as a list that has lost its options. *@
                                @if (SizeNote.Length > 0)
                                {
                                    <p class="fine why">@SizeNote</p>
                                }

                                @* Counted in portals, not in squares: a portal's two mouths are
                                   one object, unlike a pair of holes or of pickups. The list is
                                   the size's own, so a number this board cannot carry is never
                                   the one sent over a link. *@
                                <div class="row">
                                    <span class="label">Portals</span>
                                    <select class="pick" value="@_portals"
                                            disabled="@(PortalChoices.Length == 1)"
                                            @onchange="PickPortals">
                                        @foreach (int option in PortalChoices)
                                        {
                                            <option value="@option">@PortalLabel(option)</option>
                                        }
                                    </select>
                                </div>

                                @* A control with nothing in it is a control that looks broken.
                                   What the size will and will not carry is a rule of the game,
                                   so it is said out loud rather than left to be inferred from
                                   a dead list. *@
                                @if (PortalNote.Length > 0)
                                {
                                    <p class="fine why">@PortalNote</p>
                                }
                            }
                        }
                    </section>
                </div>

                @* ------------------------------------------------------ the board itself ----

                   The desktop's menu has two engines playing a real game behind the choices,
                   and it is what makes that screen feel like a game rather than a form. This
                   is the same idea and not the same thing, deliberately.

                   A live demo does not earn its place here. In a browser the search runs on
                   the one thread there is, so a demo would be a start screen whose buttons
                   answer in bursts between searches; on a phone it is a core at full tilt, in
                   a hand, before the player has asked for anything at all. Neither is what the
                   desktop is paying for it, because the desktop has a thread going spare.

                   So the board shows the game about to be started instead of one nobody
                   chose. It costs one generation per change of a control and no search at
                   all — nothing is running, so nothing has to be stopped when Play is
                   pressed — and it answers a question the setup could never answer before:
                   what four holes on a seven actually look like, where the mouths of a portal
                   land, whether a five is too small for the game you had in mind. The knobs
                   were the only part of this screen you had to commit to in order to see.

                   This is the board Play deals and not one like it. See StartGame.

                   Which way up it is drawn is asked of ShownFlipped rather than of the seat
                   control directly, because those are not the same question — see there. *@
                <div class="preview" inert="">
                    <BoardView State="_shownBoard.State"
                               Holes="_shownBoard.Holes"
                               Carved="_carved"
                               Flipped="@ShownFlipped"
                               Generation="_shown.GetHashCode()" />

                    @* The legend beside the thing it explains, which is where it should always
                       have been: it used to be attached to the controls that asked for these,
                       so a rolled board showed both legends whether or not it had rolled
                       either. Asked of the board actually drawn above, so it appears exactly
                       when there is something on it to explain. *@
                    @if (_shown.ActualPickups > 0)
                    {
                        <PickupGuide Carved="_carved" />
                    }
                    @if (_shown.ActualPortals > 0)
                    {
                        @PortalGuide
                    }
                </div>

                <div class="go">
                    @if (_mode == GameMode.Online)
                    {
                        <div class="online">
                            @if (_net.State == NetState.Idle)
                            {
                                @* Only the player who creates the game picks the board and the
                                   sides; the one who opens the link is told what they are. *@
                                <div class="row">
                                    <button class="ghost primary" @onclick="HostGame">Create a game</button>
                                </div>
                                <div class="row">
                                    <input class="code" placeholder="or paste an invite code"
                                           value="@_joinCode"
                                           @oninput="e => _joinCode = e.Value?.ToString() ?? string.Empty" />
                                    <button class="ghost" disabled="@string.IsNullOrWhiteSpace(_joinCode)"
                                            @onclick="JoinGame">Join</button>
                                </div>
                            }
                            else if (_net.State == NetState.Hosting)
                            {
                                <p class="fine">
                                    @(string.IsNullOrEmpty(_net.Code)
                                        ? "Setting up…"
                                        : "Send this link to the other player. The game starts the moment they open it.")
                                </p>
                                @if (!string.IsNullOrEmpty(_net.Code))
                                {
                                    <div class="row">
                                        <input class="code wide" readonly value="@ShareLink" @onfocus="SelectAll" />
                                        <button class="ghost copy" @onclick="() => Copy(ShareLink)">@CopyLabel</button>
                                    </div>
                                    <p class="fine">
                                        Or read out the code: <span class="mono">@_net.Code</span>
                                        <button class="ghost copy" @onclick="() => Copy(_net.Code)">@CopyLabel</button>
                                    </p>
                                }
                            }
                            else if (_net.State == NetState.Joining)
                            {
                                <p class="fine">Connecting…</p>
                            }
                            else if (_net.State == NetState.Failed)
                            {
                                <p class="fine">@_net.Trouble</p>
                                <div class="row">
                                    <button class="ghost" @onclick="ResetNet">Try again</button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="actions">
                            <button class="ghost primary" @onclick="StartGame">Play</button>
                        </div>
                    }

                    @* Two of the four modes are worth a sentence and two are not. Playing the
                       engine or somebody sitting beside you is what the button says it is; a
                       link between two browsers and a game nobody at this screen plays are
                       both something else, and neither is what "Play" normally means.

                       The third paragraph that used to stand here taught the click and the
                       hover. The board teaches that itself in the line under the status, in
                       the words that suit the pointer actually being used — which this screen
                       could not know. *@
                    @if (_mode == GameMode.Online)
                    {
                        <p class="fine">
                            The two browsers talk directly to each other over WebRTC — there is no
                            server of ours in the middle. A free public service is used once, only to
                            introduce them; after that the moves never touch a third party. Strict
                            networks sometimes block the direct connection.
                        </p>
                    }
                    else if (_mode == GameMode.Spectate)
                    {
                        <p class="fine">
                            Both sides are played by the engine. Routes are drawn for each. The first
                            seat is always the full search; the strength above is what it is playing.
                        </p>
                    }
                </div>

                <div class="foot">
                    @* The panel is the game's, and the game is behind this screen — so without
                       this the theme, the sound and everything else the panel now carries could
                       not be reached until a game had been started. *@
                    <button class="ghost" @onclick="() => _showSettings = true">Settings</button>

                    @* What the desktop build is still worth downloading for, said only to the
                       host that is missing it. It used to say clocks, engine against engine and
                       game review, all three of which are on this page now — a line offering
                       what the reader is already looking at is worse than no line. What is left
                       is the thread, so it is said where there is no thread: on a phone the
                       search already has one, and the line was an advertisement for something
                       the reader had. *@
                    @if (HostProfile.Current.IsLimited)
                    {
                        <p class="fine">
                            Prefer it on your desktop?
                            <a href="https://github.com/REPIRK/quoridor/releases/latest/download/Quoridor.exe">
                                Download the Windows app
                            </a>
                            — the search gets a thread of its own there, so it can be given longer,
                            it keeps thinking while you do, and games run over your own network.
                        </p>
                    }
                </div>
            </div>
        </div>
    }

    @* The last step down. Only a shell that can be left ever asks for this — a browser tab
       has no gesture that means "close the app" and never reaches it — and it is asked
       because the gesture that gets here is the same one-finger sweep that goes back a
       screen, so it arrives by accident about as often as on purpose. Written last so it
       is over everything, including the setup card: a press that lands here is answering
       this question and nothing behind it. *@
    @if (_showLeave)
    {
        <div class="overlay">
            <div class="result">
                <h1>Leave the game?</h1>
                <p>@_session.Moves.Count moves played · not saved to a file, but it will be here when you come back</p>
                <div class="actions">
                    <button class="ghost primary" @onclick="() => _showLeave = false">Keep playing</button>
                    <button class="ghost" @onclick="Leave">Leave</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    /// <summary>
    /// The game itself, which is the same class the desktop build has always run: the
    /// position and its history, the clocks, and whichever seats an engine plays. This
    /// screen used to keep a thinner copy of its own, and everything that copy could not
    /// do — a clock, two engines, a budget worth setting — was missing from this build for
    /// no reason but that.
    ///
    /// A plain local game until the setup card is answered, because it is only standing in
    /// for one: an engine built here would be built before the preferences are read.
    /// </summary>
    private GameSession _session = new(GameOptions.Hotseat(TimeControl.None, GameSetup.Standard, GameFlavour.Standard));

    private NetLink _net = default!;

    private GameMode _mode = GameMode.VersusBot;

    // The full engine is the default; the two heuristic bots are the handicap.
    private BotStrength _strength = BotStrength.Hard;

    /// <summary>The clock the game being set up will be played on.</summary>
    private TimeControl _clock = TimeControl.None;

    /// <summary>
    /// How long the engine may think about one move. Started at whatever this host allows,
    /// which is the desktop's own default where there is a thread to spare and the
    /// browser's long-standing 0.6 s where there is not.
    /// </summary>
    private int _moveTimeMs = HostProfile.Current.DefaultMoveTime;

    /// <summary>
    /// Whether the engine goes on searching while the human is deciding. On, which is the
    /// desktop's own default, and never asked at all where the host says there is no thread
    /// to spare — a browser reads this as false however it is set, because the search there
    /// would be running on the thread that draws the page.
    ///
    /// Kept as the player's answer rather than the host's because it is one: the engine
    /// replies no slower with it off, so what it costs is a core for as long as somebody
    /// takes over a move, and whether that is worth paying is a question about the machine
    /// in the player's hand and not about the game.
    /// </summary>
    private bool _ponder = true;

    /// <summary>
    /// The least time one move takes in a watched game, so that two engines pushing each
    /// other about can be followed. The desktop's three settings and the desktop's three
    /// numbers; the middle one is what this build has always used.
    /// </summary>
    private int _paceMs = 1400;

    private static readonly (string Name, int Pace)[] PaceChoices =
        { ("Brisk", 500), ("Steady", 1400), ("Calm", 2800) };

    /// <summary>
    /// Whether how fast two engines play each other is a question worth putting to the
    /// person reading the panel. It is the one setting here that is about a single mode, and
    /// it stood on every screen whether or not anybody was watching anything — asked of the
    /// game being set up while the start screen is up, and of the game on the board when it
    /// is not, because those are the two games the panel can be opened over.
    /// </summary>
    private bool PaceMatters => _showSetup
        ? _mode == GameMode.Spectate
        : _session.Options.Mode == GameMode.Spectate;

    /// <summary>The three above without their names, for checking a stored one against.</summary>
    private static readonly int[] PaceMilliseconds = { 500, 1400, 2800 };

    /// <summary>The seat this browser takes in the game being set up. Seat 0 moves first.</summary>
    private int _seat;

    private GameFlavour _flavour = GameFlavour.Standard;

    // The custom knobs, only reachable through the third flavour.
    private int _size = Board.Size;
    private int _walls = Board.WallsPerPlayer;
    private int _holes;
    private int _pickups;
    private int _portals;

    private bool _showSetup = true;
    private bool _showSettings;
    private bool _thinking;
    private bool _engineRunning;
    private bool _light;
    private bool _reading;
    private bool _confirm;

    /// <summary>Whether the board is drawn as an object rather than as a diagram. Off is
    /// the board this game is really about, so off is what a first visit gets.</summary>
    /// <summary>
    /// The board is lit and has depth unless someone turns it off. It began the other way
    /// round — the plain board was the default and this was the opt-in — and the owner,
    /// having played both on a phone and a desktop, asked for it the other way.
    /// </summary>
    private bool _carved = true;

    /// <summary>
    /// Whether a card is up over the page. Each of the three is an opaque sheet across the
    /// whole viewport, so the mouse has never been able to reach what is behind one — but
    /// the keyboard could, and now that the board has a caret of its own that is a real
    /// hole: the caret is the third stop on a fresh page, ahead of every control the setup
    /// card offers, and Enter on it plays a move into a game nobody has started yet.
    ///
    /// `inert` is the one thing that says this properly. It takes the whole subtree out of
    /// the tab order and out of hit testing at once, which is what an opaque sheet already
    /// means everywhere except the keyboard.
    /// </summary>
    private bool Covered => _showSetup || _showSettings || _showResult || _showLeave;

    /// <summary>Whether the "leave the game?" card is up. Only a back gesture raises it,
    /// so in a browser it is never seen at all.</summary>
    private bool _showLeave;

    private bool _touch;
    private bool _showHelp;

    /// <summary>
    /// Whether there is anything to hear, and how much of it. The pair is no longer two
    /// controls: the slider is the switch, so these two are always each other's answer and
    /// the flag exists only because it is what the stored line has always been written in —
    /// a build without this change reads it back and still gets the truth.
    /// </summary>
    private bool _sound = true;
    private bool _music;
    private int _soundVolume = 70;
    private int _musicVolume;

    private int _track;
    private string? _preview;
    private string _joinCode = string.Empty;

    /// <summary>
    /// How many wall pips to draw. Sized once, to the most the row will ever have to
    /// show — pickups can push a player above the starting supply, and a row that grew
    /// as they did would reflow the panel mid-game.
    /// </summary>
    private int WallPips => Math.Min(Board.MaxWalls,
        _session.Setup.Walls + (_session.Setup.Pickups > 0 ? 4 : 0));

    /// <summary>Whether this player's wall supply just grew, which only a pickup does.
    /// Not while stepping back through the game, where nothing is happening now.</summary>
    private bool Gained(int player) =>
        _reviewPly is null && _session.LastMoveTookAWall && _session.LastMover == player;

    /// <summary>A dropdown's new value, or the fallback if the browser sent nonsense.</summary>
    private static int Number(ChangeEventArgs e, int fallback) =>
        int.TryParse(e.Value?.ToString(), out int value) ? value : fallback;

    /// <summary>
    /// What each of the three ways in will do. The rolled one has a sentence the others do
    /// not need, and it is the sentence that makes the roll a choice rather than a surprise:
    /// the board on the screen is the board Play deals, so a roll you do not like is one
    /// press away from another.
    /// </summary>
    private string FlavourNote => _flavour switch
    {
        GameFlavour.Random => "Board, walls, holes, pickups and portals — all rolled for you, and this is the roll: " +
            "press Random again for another. Who moves first is settled when you press Play.",
        GameFlavour.Custom => "Everything is yours to set.",
        _ => "Nine by nine, ten walls each. The game as it is normally played.",
    };

    // ==================================================================== clock ==

    /// <summary>
    /// The three the desktop build offers, and no others. Two are enough for anyone who
    /// wants a clock at all, and a fourth would be a number to choose between rather than a
    /// game to play.
    /// </summary>
    private static readonly TimeControl[] ClockChoices = { TimeControl.None, TimeControl.Blitz, TimeControl.Rapid };

    /// <summary>Written out in full, as the desktop's menu writes it. "5+3" is the header's
    /// shorthand, which reads once you already know what it is short for.</summary>
    private static string ClockLabel(TimeControl clock) =>
        clock == TimeControl.Blitz ? "5 min + 3 sec"
        : clock == TimeControl.Rapid ? "3 min + 2 sec"
        : "No clock";

    /// <summary>
    /// How often the clocks are charged and redrawn. Ten times a second, which is what the
    /// desktop uses and what the last ten seconds need: under that the display shows tenths,
    /// and a tenth that only changes every third of a second is a clock that stutters.
    /// </summary>
    private const int ClockTickMs = 100;

    /// <summary>
    /// Which run of the clock is the live one. A game can be handed back a clock it had
    /// already stopped — an undo after a flag has fallen does exactly that — and without
    /// this the new loop would run alongside the old one and charge every tick twice.
    /// </summary>
    private int _clockRun;

    private void StartClock()
    {
        if (_session.HasClock) _ = RunClock(_session, ++_clockRun);
    }

    /// <summary>
    /// Charges the player on move for the time that really passed, rather than for the
    /// number of ticks that arrived. In a browser the engine's search holds the only thread
    /// there is, so ticks do not arrive at all while it runs — and the time it spent is the
    /// engine's own and has to be charged to it. Measuring the interval instead of counting
    /// it makes that come out right by itself, on either host.
    /// </summary>
    private async Task RunClock(GameSession session, int run)
    {
        long last = System.Diagnostics.Stopwatch.GetTimestamp();

        while (run == _clockRun && ReferenceEquals(session, _session) && !session.IsOver)
        {
            await Task.Delay(ClockTickMs);

            // A restart or a new game replaces the session outright, and this loop belongs
            // to the one it was started for. The new one starts a loop of its own.
            if (run != _clockRun || !ReferenceEquals(session, _session)) return;

            TimeSpan elapsed = System.Diagnostics.Stopwatch.GetElapsedTime(last);
            last = System.Diagnostics.Stopwatch.GetTimestamp();

            // A card over the board is a board that cannot be played, and charging someone
            // for the seconds they spent in the settings panel is charging them for time
            // they were not given. The interval is thrown away rather than banked.
            if (Covered) continue;

            bool flagged = session.ChargeClock(elapsed);

            // Through InvokeAsync rather than called outright. Everything else on this page
            // repaints from inside an event the renderer itself raised, and is therefore
            // already on the renderer's thread; this loop is the one thing that runs on
            // nobody's behalf, for as long as the game lasts, and a native host has a real
            // dispatcher that will refuse a repaint arriving from anywhere else.
            await InvokeAsync(StateHasChanged);

            if (!flagged) continue;

            // Losing on time ends a game without a move being played, so nothing else on
            // the page is going to make a sound about it.
            await Sfx(Ours(session) ? "win" : "lose");
            return;
        }
    }

    /// <summary>
    /// Whether the result belongs to the person at this screen. In a local match and a
    /// watched game nobody here lost, so it is a fanfare either way — which is exactly what
    /// a seat of -1 means.
    /// </summary>
    private static bool Ours(GameSession session) =>
        session.LocalSeat < 0 || session.Winner == session.LocalSeat;

    // ================================================================== options ==

    /// <summary>
    /// The game this card describes, as the session wants it. Every argument is passed in
    /// rather than read off the fields, because a rematch has to repeat the game that was
    /// played and not the one the card is currently showing.
    /// </summary>
    private static GameOptions OptionsFor(
        GameMode mode, BotStrength strength, TimeControl clock, int seat, GameSetup setup, GameFlavour flavour) =>
        mode switch
        {
            GameMode.Hotseat => GameOptions.Hotseat(clock, setup, flavour),
            GameMode.Spectate => GameOptions.Spectate(strength, setup, flavour),

            // Built by hand rather than through GameOptions.Online, which decides the seat
            // from who is hosting: here the host may have chosen to play second, and the
            // other side is told which seat it has rather than inferring one. The flavour
            // travels too, so a rematch on a rolled board rolls again for both of them.
            GameMode.Online => new GameOptions(
                GameMode.Online, BotStrength.Normal, TimeControl.None,
                HumanMovesFirst: seat == 0, Board: setup, Flavour: flavour),

            _ => GameOptions.VersusBot(strength, clock, humanMovesFirst: seat == 0, setup, flavour),
        };

    // ========================================================= what a size carries ==

    /// <summary>The wall supplies the chosen size can actually be played with.</summary>
    private int[] WallChoices => GameSetup.WallOptions(_size);

    /// <summary>The hole counts the chosen size has squares for.</summary>
    private int[] HoleChoices => GameSetup.HoleOptions(_size);

    /// <summary>The pickup counts left over once the holes have taken theirs.</summary>
    private int[] PickupChoices => GameSetup.PickupOptions(_size);

    /// <summary>The portal counts the chosen size can actually carry.</summary>
    private int[] PortalChoices => GameSetup.PortalOptions(_size);

    /// <summary>
    /// The board size, with every count brought back inside what that size can carry.
    /// A two chosen on a nine cannot be left standing on the control after the board has
    /// become a five: the game would be built without it, and a number shown but not
    /// honoured reads as the generator being unreliable rather than as a rule of the size.
    ///
    /// The same was true of the walls, the holes and the pickups, which kept the nine's
    /// numbers on every board — a five with Holes=10 and Pickups=10 starts as
    /// "5×5 · 0 walls · 10 holes · 4 pickups" while the card still says ten of each,
    /// because Core caps them against its 14 drawable cells.
    /// </summary>
    private void PickSize(ChangeEventArgs e)
    {
        _size = Number(e, Board.Size);

        _walls = Clamped(_walls, WallChoices);
        _holes = Clamped(_holes, HoleChoices);
        _pickups = Clamped(_pickups, PickupChoices);
        _portals = Clamped(_portals, PortalChoices);

        RefreshPreview();
    }

    private void PickWalls(ChangeEventArgs e)
    {
        _walls = Clamped(Number(e, Board.WallsPerPlayer), WallChoices);
        RefreshPreview();
    }

    private void PickHoles(ChangeEventArgs e)
    {
        _holes = Clamped(Number(e, 0), HoleChoices);
        RefreshPreview();
    }

    private void PickPickups(ChangeEventArgs e)
    {
        _pickups = Clamped(Number(e, 0), PickupChoices);
        RefreshPreview();
    }

    private void PickPortals(ChangeEventArgs e)
    {
        _portals = Clamped(Number(e, 0), PortalChoices);
        RefreshPreview();
    }

    /// <summary>
    /// Which of the two seats is the player's. It is the one setup control that changes
    /// nothing about the board and so does not rebuild the preview — it only turns it
    /// around, which is what taking the second seat does to the board in play.
    /// </summary>
    private void PickSeat(ChangeEventArgs e) => _seat = Number(e, 0);

    /// <summary>
    /// A count brought inside what a size offers: the largest option that size carries
    /// which is no bigger than the one asked for. Not a plain minimum, because the result
    /// has to be one of the options the list draws — a value no option carries leaves the
    /// control showing a blank, which reads as the setting having been lost.
    /// </summary>
    private static int Clamped(int count, int[] options)
    {
        int best = options[0];

        foreach (int option in options)
        {
            if (option <= count && option > best) best = option;
        }

        return best;
    }

    /// <summary>The two scattered counts, which read the same way apart from what is
    /// scattered. Zero is "None" rather than "0 — scattered at random".</summary>
    private static string ScatterLabel(int count, string what) =>
        count == 0 ? "None" : $"{count} — {what}";

    /// <summary>
    /// Why a smaller board is offered less of everything. Said only for the five, where
    /// all three lists shorten at once; the seven only loses the top of the wall list,
    /// which is a smaller claim than a paragraph under the controls is worth.
    /// </summary>
    private string SizeNote => _size == 5
        ? "A five has 16 wall slots to the nine's 64, and 14 squares that a hole or a pickup may stand on — so the counts a nine offers are not on this board to give."
        : string.Empty;

    /// <summary>Said in pairs of squares, because that is the unit the count is in.</summary>
    private static string PortalLabel(int count) => count switch
    {
        1 => "1 — one pair of linked squares",
        2 => "2 — two pairs of linked squares",
        _ => "None",
    };

    /// <summary>
    /// Why a size is offered fewer portals than the last one was. A five has nowhere at all
    /// to put a mouth, and a seven has one usable pairing, so a second portal there would
    /// share it and the two would be one objective rather than two.
    /// </summary>
    private string PortalNote => PortalChoices.Length switch
    {
        1 => "No portals on a five. A mouth may not stand on a goal row, next to one, or on the middle row — and on a five that is every row there is.",
        2 => "One portal on a seven. Its two usable rows are a single mirrored pair, and two portals sharing that pair would be one objective rather than two.",
        _ => string.Empty,
    };

    /// <summary>
    /// What a portal does, drawn where the pickups are drawn and in the same voice. It is a
    /// fragment rather than a component of its own only because it is wanted in three places
    /// in this one file — the custom knobs, a rolled game, and the settings panel of a game
    /// already in play.
    ///
    /// Two mouths, not one: a portal is the pair, and a single ring is the half of it that
    /// cannot be walked through.
    /// </summary>
    private RenderFragment PortalGuide => @<div class="guide">
        <div class="line">
            <svg class="glyph" viewBox="0 0 40 28" aria-hidden="true">
                <g class="portal">
                    <path class="link" d="M 10 21 Q 20 28 30 21" />
                    <circle class="rim" cx="10" cy="14" r="8" />
                    <circle class="iris" cx="10" cy="14" r="3.5" />
                    <circle class="rim" cx="30" cy="14" r="8" />
                    <circle class="iris" cx="30" cy="14" r="3.5" />
                </g>
            </svg>
            <div>
                <b>Two squares, one step.</b>
                Stand on either mouth and the other one is next door: crossing costs a move
                and passes the turn, exactly as walking one square does. Nothing is used up,
                so a portal works all game, for whoever is standing on it.
            </div>
        </div>

        <p class="fine">
            Both mouths of a pair are drawn in one colour, so the one you are standing on
            tells you where you would come out. They sit opposite each other under the same
            half turn as the pickups, and no wall can ever close one.
        </p>
    </div>;

    /// <summary>
    /// A whole board on a scatter of its own, which is what a rematch on a rolled game asks
    /// for. The seed is drawn rather than read off the clock: the clock only ticks every few
    /// milliseconds, so a rematch taken straight away used to be handed the same number and
    /// rebuilt the very board it was asked to replace, and a seed that climbs steadily makes
    /// the boards it produces cycle instead of scatter.
    /// </summary>
    private GameSetup BuildSetup(GameFlavour flavour) => BuildSetup(flavour, Random.Shared.Next());

    /// <summary>
    /// The board these controls describe. Standard is the plain game; Random rolls
    /// everything; Custom is whatever the knobs say, scattered from the same seed.
    ///
    /// The seed is a parameter and not drawn in here, so that the start screen can hold one
    /// still: a scatter that moved every time the wall count was nudged would be a picture
    /// of a different game each time, and the board that screen shows is the board it deals.
    /// </summary>
    private GameSetup BuildSetup(GameFlavour flavour, int seed)
    {
        if (flavour == GameFlavour.Standard) return GameSetup.Standard;

        if (flavour == GameFlavour.Custom)
        {
            return new GameSetup
            {
                Size = _size,
                Walls = _walls,
                Holes = _holes,
                Pickups = _pickups,
                Portals = _portals,
                Seed = seed,
            };
        }

        return GameSetup.Roll(seed);
    }

    // ================================================================= the preview ==

    /// <summary>
    /// The board the start screen is currently describing, and the position it produces.
    ///
    /// Held rather than computed in the markup, and this is not an optimisation: every
    /// flavour but Standard draws a fresh seed, so a setup built during a render would
    /// re-scatter the holes on every keystroke, every hover and every repaint the clock
    /// causes. It is rebuilt when a control is touched and at no other time, which is
    /// exactly when the board it stands for has actually changed.
    /// </summary>
    private GameSetup _shown = GameSetup.Standard;

    private BuiltBoard _shownBoard = GameSetup.Standard.Build();

    /// <summary>
    /// The scatter the preview is standing on. Held still while the counts are being set,
    /// and drawn again only when a whole board is being asked for afresh — choosing a
    /// flavour, or opening the screen. Without it, nudging the wall count would move every
    /// hole on the board and the preview would read as a slot machine.
    /// </summary>
    private int _shownSeed = Random.Shared.Next();

    /// <summary>
    /// Whether the preview is drawn from the second seat, which is the one thing about it
    /// that is not a property of the board at all.
    ///
    /// It has to be the same question the game itself will be asked, and the seat control is
    /// not that question: <c>GameSession.LocalSeat</c> is -1 in a local match and in a watched
    /// game — nobody at this screen has a seat in either, so both are always drawn the way up
    /// they were dealt — and it is 1 only where the mode gives this browser the second seat.
    /// Asked of the control alone, the preview turned over whenever a seat chosen against the
    /// engine was still standing after the opponent was changed to a friend here, and stayed
    /// upright when a seat chosen on a custom board was still standing after the board was
    /// changed back to the standard one. Both are two clicks away, and both make the preview
    /// a picture of a board that is not the one Play deals.
    ///
    /// A rolled game is the one case that genuinely cannot be known here: Play draws the
    /// order of play along with everything else, so the seat this reads has not been decided
    /// yet. Upright is the honest answer, and the note under the control already says the
    /// order is settled when the button is pressed.
    /// </summary>
    private bool ShownFlipped =>
        _flavour != GameFlavour.Random && _mode is GameMode.VersusBot or GameMode.Online && _seat == 1;

    /// <summary>Redraws the preview from the controls as they now stand.</summary>
    private void RefreshPreview()
    {
        _shown = BuildSetup(_flavour, _shownSeed);
        _shownBoard = _shown.Build();
    }

    /// <summary>And the same on a fresh scatter, which is what asking for another board is.</summary>
    private void RollPreview()
    {
        _shownSeed = Random.Shared.Next();
        RefreshPreview();
    }

    /// <summary>
    /// Chooses one of the three ways in. Pressing the one already chosen is not a no-op:
    /// on Random it rolls again, which is the only way to ask a rolled game for a second
    /// opinion before committing to it.
    /// </summary>
    private void SelectFlavour(GameFlavour flavour)
    {
        _flavour = flavour;
        RollPreview();
    }

    /// <summary>A move chosen during the opponent's turn, played the moment ours starts.</summary>
    private Move? _premove;

    /// <summary>Ply being looked at while stepping back; null means live.</summary>
    private int? _reviewPly;

    private GameState Shown => _reviewPly is { } ply ? _session.StateAfter(ply) : _session.State;

    private Move? ShownLastMove => _reviewPly is { } ply
        ? ply > 0 ? _session.Moves[ply - 1] : null
        : _session.LastMove;

    protected override async Task OnInitializedAsync()
    {
        // Where a session gets the two numbers it cannot decide for itself. It is a
        // function and not a value on purpose, and asked afresh every time: the budget is
        // read when an engine is built, so the setting made here reaches the next game
        // rather than the one on the board — which is exactly how the desktop's own
        // picker behaves.
        //
        // Pondering is two answers and needs both: the host says whether there is a thread
        // to search on at all, and where there is, the player says whether it should be
        // used. A browser forces it off however the switch is set, which is why the switch
        // is not shown there; a phone offers it, because a core running for as long as
        // somebody takes over a move is battery out of their hand.
        //
        // Installed before anything with an engine in it is built.
        GameSession.Preferences = () => new EnginePreferences(
            TimeSpan.FromMilliseconds(_moveTimeMs), HostProfile.Current.MayPonder && _ponder);

        // What the system's back gesture does, where there is a system that has one. Set
        // this early: the shell can be asked before the first render — a sweep during the
        // splash — and an unanswered press there closes the app.
        HostShell.BackPressed = OnBackPressed;

        // Before anything is drawn, so that what is drawn is already the player's own.
        await LoadSettings();

        // And the board on the start screen follows from those: the game last set up is
        // what this build opens showing, so the preview has to be built after the line
        // that says what it was.
        RefreshPreview();

        _net = new NetLink(Js);
        _net.Changed += OnNetChanged;
        _net.Received += OnNetMessage;

        // Arriving through an invite link goes straight to connecting.
        var uri = new Uri(Nav.Uri);
        string? invite = System.Web.HttpUtility.ParseQueryString(uri.Query).Get("join");

        if (!string.IsNullOrWhiteSpace(invite))
        {
            _mode = GameMode.Online;
            _joinCode = invite;
            await _net.JoinAsync(invite);
            return;
        }

        // Otherwise, whatever was on the board when this was last open. Asked after the
        // invite because an invite is somebody being asked to play now, and before
        // anything is drawn so that a resumed game is what the first frame shows rather
        // than a setup card that flashes past.
        await LoadGame();
    }

    /// <summary>What the move list was last scrolled for, so it is only scrolled again
    /// when the game moved on or the review moved to another row.</summary>
    private (int Played, int? Ply) _listed = (-1, null);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            // Every way a game can end — a move here, the engine's reply, a move arriving
            // over the link — ends with a render, so the wait is started from here rather
            // than from each of them in turn.
            if (_session.IsOver && !_showResult && !_resultHeld && !_resultSeen)
            {
                _resultHeld = true;
                _ = HoldResult();
            }

            // The list is a fixed height and a game outgrows it about ten moves in,
            // after which the move just played is below the fold — including the one
            // the arrow keys have just stepped to, which is the whole point of pressing
            // them. It follows the game rather than being scrolled by hand every move.
            (int, int?) now = (_session.Moves.Count, _reviewPly);

            if (now != _listed && _page is not null)
            {
                _listed = now;

                try
                {
                    await _page.InvokeVoidAsync("followMoves", _reviewPly is not null);
                }
                catch (Exception)
                {
                    // A list that does not scroll itself is not worth a broken page.
                }
            }

            // Every position this game passes through ends in a render, which makes here
            // the one place that cannot miss one. It writes only when the game has actually
            // moved — a hover redraws the board a dozen times a second and none of those
            // are a game to come back to.
            await KeepGameAsync();
            await KeepChromeAsync();

            return;
        }

        // Fetch the sound module now, while nobody is waiting for anything, so the first
        // move does not find itself paying for it.
        _ = LoadSfx();

        try
        {
            if (await LoadPage() is not { } page) return;

            _keyOwner = DotNetObjectReference.Create(this);
            await page.InvokeVoidAsync("listenForKeys", _keyOwner);

            if (!await page.InvokeAsync<bool>("isCoarsePointer")) return;

            _touch = true;

            // What a finger needs from the board, and the only thing on this page that is
            // asked for because the pointer is a blunt one: the board's own presses have to
            // keep being delivered to whatever the thumb is over as it slides, which a
            // browser stops doing the moment a touch goes down. Everything else about
            // pointing at this board is already the same for both kinds of pointer.
            //
            // Confirmation used to be turned on here as well, on the grounds that a screen
            // with no hover would otherwise play a move on one stray tap. That was true of
            // a board where a tap was the whole gesture. It is not true of this one: the
            // press is the look and the lift is the move, and a wall can be examined and
            // slid onto the right groove before anything is played. So it is left as what
            // it is, a preference, off unless somebody asks for it — and a wall on a phone
            // now costs the same one gesture a pawn does, which was the point.
            await page.InvokeVoidAsync("freeTheBoard");

            StateHasChanged();
        }
        catch (Exception)
        {
            // Not worth a broken page if the check is unavailable.
        }
    }

    // ============================================================== the window ==

    /// <summary>Which theme the window around the page was last told about.</summary>
    private bool? _chromeLight;

    /// <summary>
    /// Keeps the strip of window this page does not draw in the theme the page is in.
    ///
    /// There is always some. In a browser on a phone it is the address bar; in the app it
    /// is the status bar at the top and whatever the system puts at the bottom. Both are
    /// the host's to paint and neither can know which theme is up, because the theme is a
    /// preference this page remembers and applies after the host has already drawn itself.
    /// A dark app under a white status bar is not a small thing on a screen this size: it
    /// is most of what "this app is dark" was supposed to mean.
    ///
    /// The ink is passed rather than looked up so that the two ends cannot drift: it is the
    /// stylesheet's own --bg for the theme in force, which is exactly the colour the page
    /// meets the system bar with.
    /// </summary>
    private async Task KeepChromeAsync()
    {
        if (_chromeLight == _light) return;

        _chromeLight = _light;

        try
        {
            if (_page is { } page)
                await page.InvokeVoidAsync("setSystemTheme", _light, _light ? "#e8e3d8" : "#171714");
        }
        catch (Exception)
        {
            // A host with no bars to colour, or one that will not be told. The page is
            // drawn either way.
        }
    }

    // ================================================================== keys ==

    private DotNetObjectReference<Play>? _keyOwner;

    /// <summary>
    /// The keyboard, which the desktop build has always had and this one did not. The
    /// map lives here rather than in the script so that what a key does sits beside the
    /// thing it does it to; the script only claims the presses so the page does not
    /// scroll out from under a player who pressed space.
    /// </summary>
    [JSInvokable]
    public void OnKey(string key)
    {
        // Nearest the player first, which is the order the back gesture answers in and for
        // the same reason: the settings panel can now be raised over the start screen, and
        // asked in the other order an Escape at the panel would have closed the screen
        // underneath it instead.

        // The leaving card is only ever raised by a back gesture, which is a phone's; a
        // keyboard is not, but a card that cannot be dismissed by the key everybody presses
        // at a card is a card somebody is stuck at.
        if (_showLeave)
        {
            if (key is "Escape") { _showLeave = false; StateHasChanged(); }
            return;
        }

        if (_showSettings)
        {
            // One way out of the panel, and it is the one everybody tries first.
            if (key is "Escape") { _showSettings = false; StateHasChanged(); }
            return;
        }

        // While a game is being set up the board behind is not the player's yet — but where
        // there is one behind, Escape is the way back to it, as it is out of every other
        // screen here. On a cold start there is nothing to go back to and the key does
        // nothing, which is better than a start screen that can be dismissed to an empty
        // board.
        if (_showSetup)
        {
            if (key is "Escape" && _started) { _showSetup = false; StateHasChanged(); }
            return;
        }

        switch (key)
        {
            case "ArrowLeft":
                Review((_reviewPly ?? _session.Moves.Count) - 1);
                break;

            case "ArrowRight":
                Review((_reviewPly ?? 0) + 1);
                break;

            // Back to the live position from anywhere in the game so far.
            case "Escape" when _reviewPly is not null:
                Review(null);
                break;

            case " ":
                _reading = !_reading;
                break;

            case "?":
                _showHelp = !_showHelp;
                break;

            case "ctrl+z" when _session.CanUndo && !_thinking:
                Undo();
                break;

            default:
                return;
        }

        StateHasChanged();
    }

    // ================================================================== back ==

    /// <summary>
    /// Whether a real game has been put on the board. The session that exists before the
    /// setup card is answered is a stand-in — a plain local game nobody chose — and the
    /// difference matters to exactly one question: whether closing the setup card would
    /// return the player to something or to an empty board.
    /// </summary>
    private bool _started;

    /// <summary>
    /// The system's back gesture, which is a phone's one universal control and the only
    /// one this page does not draw itself. It has to mean "up one level" every time it is
    /// pressed, and it has to reach the game before it reaches the app: a sweep that leaves
    /// a match in progress because there happened to be nothing else to close is the single
    /// worst thing a back button can do.
    ///
    /// So it is answered as a ladder, from whatever is nearest the player outwards, and
    /// every rung is one press. What is drawn in front goes first — a card over the board
    /// is what the player is looking at and is what "back" refers to, even where the board
    /// behind it is also in a state of its own. Then the states of the board itself, then
    /// the game, and only when there is nothing left of any of them does the app close.
    ///
    /// Returns whether this page took the press. False is the shell's cue to do what back
    /// means where there is no page left to unwind — which is why it is a question and not
    /// a notification.
    ///
    /// Called on the shell's own thread. It reads the state to decide and changes nothing
    /// itself; the change goes through the renderer like every other change on this page.
    /// </summary>
    private bool OnBackPressed()
    {
        if (NextBackStep() is not { } step) return false;

        _ = InvokeAsync(() =>
        {
            step();
            StateHasChanged();
        });

        return true;
    }

    /// <summary>
    /// One rung of the ladder, or null when the page is at the bottom of it and the press
    /// belongs to the shell. Written as the whole ladder in one place, in order, because
    /// the requirement is about the order and a rule spread across eight handlers is a
    /// rule nobody can check.
    /// </summary>
    private Action? NextBackStep()
    {
        // The cards, nearest first. The leaving card is over everything including the
        // setup card, so back out of it is back to whatever asked the question.
        if (_showLeave) return () => _showLeave = false;
        if (_showSettings) return () => _showSettings = false;

        // The result card comes off to leave the final position on the board, which is
        // what somebody who just watched a game end wants to look at. It does not come
        // back by itself afterwards — see _resultSeen.
        if (_showResult) return () => { _showResult = false; _resultSeen = true; };

        // The setup card, but only when there is a game behind it to go back to. Opened
        // over a game it is a choice being reconsidered; opened on a cold start it is the
        // first thing there is, and closing it would leave a board nobody has set up.
        if (_showSetup && _started) return () => _showSetup = false;

        // The board's own states, which are things the player switched on and can be
        // expected to want switched off again.
        // The board's own states — things the player switched on for this position and can
        // be expected to want switched off again. Not the reading, which is on the same
        // list of switches but is a preference that is written down and would then have
        // been changed by a gesture that meant "go back".
        if (_reviewPly is not null) return () => Review(null);
        if (_showHelp) return () => _showHelp = false;

        // A game with moves in it is worth a question. Not one that has only been set up:
        // there is nothing there to lose, and a card asking about it would be a press for
        // nothing. A finished game is not worth a question either — it is over.
        if (_started && !_showSetup && !_session.IsOver && _session.Moves.Count > 0)
            return () => _showLeave = true;

        // Nothing left. The shell closes, and what was on the board is on disk — written
        // after every move, not at the moment of leaving, because being killed without
        // being asked is the ordinary way an app on a phone ends.
        return null;
    }

    /// <summary>Leaves, having asked. Null in a browser, where nothing asks.</summary>
    private void Leave()
    {
        _showLeave = false;
        HostShell.Leave?.Invoke();
    }

    // ================================================================= review ==

    /// <summary>
    /// Steps back and forth through the game. Null returns to the live position.
    ///
    /// A game with nothing played has no past to step into, and the keyboard could reach
    /// one that the buttons could not: ArrowLeft asked for ply -1, which is not >= 0 and
    /// so fell through to a clamp that produced ply 0 — the live position, marked as
    /// history. The board went non-interactive and the first move of the game could not
    /// be played at all.
    /// </summary>
    private void Review(int? ply)
    {
        int played = _session.Moves.Count;

        if (ply is null || played == 0 || ply >= played)
        {
            _reviewPly = null;
            return;
        }

        _reviewPly = Math.Clamp(ply.Value, 0, played);
        _preview = null;

        // Reading the game back is not waiting for a turn, and a click on the historic
        // board must not be banked as a move to play in the live one. The board stops
        // offering premoves while this is set (AllowPremove below); anything banked
        // before we got here goes now, because it was chosen against a position the
        // player has since stepped away from.
        _premove = null;
    }

    /// <summary>
    /// The invite, as something worth sending to somebody. The page's own address is the
    /// right base wherever that address is one the other player could open; where it is
    /// not — inside an app, where the page is served from within the process — the host
    /// names a place the game can be played instead. See HostProfile.InviteBase.
    /// </summary>
    private string ShareLink =>
        $"{(HostProfile.Current.InviteBase is { Length: > 0 } elsewhere ? elsewhere : Nav.BaseUri)}?join={_net.Code}";

    private string Title
    {
        get
        {
            string name = _session.Options.Mode switch
            {
                GameMode.Hotseat => "Two players, one screen",
                GameMode.Spectate => "Two engines",
                GameMode.Online => _net.IsConnected ? "Online game" : "Online game · disconnected",
                _ => $"Versus {_session.Options.Strength.ToString().ToLowerInvariant()} engine",
            };

            if (!_session.Setup.IsStandard) name += $" · {_session.Setup.Describe()}";

            // The clock belongs beside the board and not beside the settings, for the same
            // reason the board's own description does: both were settled when the game
            // began and neither can be changed while it lasts. In the header's shorthand,
            // which is the desktop's shorthand — the card that set it wrote it out in full.
            if (_session.HasClock) name += $" · {_session.Options.Clock.Label}";

            return name;
        }
    }

    private string Status
    {
        get
        {
            if (_session.IsOver) return WinnerLabel;
            if (_saidThinking) return "Thinking";

            if (_session.Options.Mode == GameMode.Online)
                return _session.IsHumanTurn ? "Your move" : "Waiting for your opponent";

            return _session.Options.Mode == GameMode.VersusBot && _session.IsHumanTurn
                ? "Your move"
                : $"{_session.PlayerName(_session.State.SideToMove)} to move";
        }
    }

    private string Hint
    {
        get
        {
            if (_session.IsOver) return "Rematch to play again.";

            if (_session.Options.Mode == GameMode.Online && !_net.IsConnected)
                return _net.Trouble.Length > 0 ? _net.Trouble : "The connection is gone.";

            // Nothing is asked of anyone here, so nothing the line usually says about how
            // to move applies. The desktop says exactly this in exactly this place.
            if (_session.Options.Mode == GameMode.Spectate)
                return "Both sides are played by the engine. Routes are drawn for each.";

            // Without saying so, a turn that does not pass just looks like the game
            // ignored the other player.
            if (_session.LastMoveWentAgain)
                return "Free move — the turn does not pass. Go again.";

            // The other shape a turn that comes straight back can have, and the one no
            // pickup explains: the rules forfeit a turn nobody can play.
            if (_session.LastTurnForfeited)
                return "Your opponent has no legal move. The turn is forfeited — play again.";

            if (_session.LastMoveTookAWall)
                return "Two spare walls picked up, on top of what you started with.";

            // The one move whose result does not look like its cause: the pawn is
            // suddenly half a board away, having paid a single step for it.
            if (_session.LastMoveCrossedPortal)
                return "Through the portal — one step to the square it is linked to.";

            if (_session.State.WallsOf(_session.State.SideToMove) == 0)
                return "No walls left — it is a straight race now.";

            // How to move is worth saying once. After a couple of moves it has been
            // learned by doing, and a line that never changes is a line you stop
            // reading — so it goes, and the mark by the heading brings it back.
            if (!_showHelp && _session.Moves.Count > 2) return string.Empty;

            // The one sentence a phone gets, and it has to teach the whole gesture: that
            // holding is how you look, that sliding is how you correct, and that nothing
            // is played until the finger comes off. Said as one motion rather than as
            // three rules, because it is one motion.
            return _touch
                ? "Press a square to step, or the gap between squares for a wall — hold to see what it costs, slide to change it, lift to play it."
                : "Click a square to step, or hover a groove between squares to place a wall.";
        }
    }

    /// <summary>
    /// The keys, shown only with the help open. A shortcut nobody is told about is a
    /// shortcut nobody uses, and a list of them standing over the board all game is the
    /// furniture the help text was retired for being.
    /// </summary>
    private string Keys => _touch || _session.IsOver
        ? string.Empty
        : "Space reads the position · ← → step through the game · Esc returns to it · Ctrl+Z undo";

    // ============================================================ why not, then ==

    /// <summary>
    /// Why Undo is not available, when it is not. Online it never is and that is a rule of
    /// the mode rather than of the position, so it is worth saying even though the button
    /// will never come back to life in that game.
    /// </summary>
    private string? UndoNote
    {
        get
        {
            if (_thinking) return "The engine has the board for a moment.";
            if (_session.CanUndo) return null;

            if (_session.Options.Mode == GameMode.Online)
                return "Taking a move back has to be agreed, and there is no way to ask.";

            // Both seats belong to the engine, so there is no move of anyone's here to
            // take back — a rule of the mode rather than of the position, like online.
            if (_session.Options.Mode == GameMode.Spectate)
                return "Neither side is yours to take a move back from.";

            return _session.Moves.Count == 0
                ? "Nothing has been played yet."
                : "Not until you have had a move of your own to take back.";
        }
    }

    /// <summary>Why there is nothing to step back to.</summary>
    private string? BackNote => _session.Moves.Count == 0 ? "No moves to step back through yet." : null;

    /// <summary>Why the two forward controls are dead: they only mean something from inside
    /// the game's past, and this is the live position.</summary>
    private string? LiveNote => _reviewPly is null ? "You are at the live position." : null;

    private string WinnerLabel
    {
        get
        {
            int winner = _session.Winner;
            if (winner < 0) return string.Empty;

            // A game decided by the clock is not the same result as a game decided on the
            // board, and this line is the only place that can say which of the two it was.
            string ending = _session.FlaggedPlayer >= 0 ? " on time" : string.Empty;

            // Nobody at this screen played a local match or a watched game, so both are
            // announced by name — which is also what a seat of -1 is telling us.
            if (_session.LocalSeat < 0) return $"{_session.PlayerName(winner)} wins{ending}";

            if (winner == _session.LocalSeat) return $"You win{ending}";

            return (_session.Options.Mode == GameMode.VersusBot ? "The engine wins" : "Your opponent wins") + ending;
        }
    }

    /// <summary>
    /// What the engine last found, for the one seat it is worth reporting from. In a watched
    /// game that is whichever of the two just moved — the line would otherwise always
    /// describe the first seat and never the answer just played.
    /// </summary>
    private IQuoridorAgent? Reporting => _session.Options.Mode == GameMode.Spectate
        ? _session.AgentOf(_session.LastMover >= 0 ? _session.LastMover : 0)
        : _session.Bot;

    private string? EngineLine
    {
        get
        {
            if (Reporting is not SearchAgent engine || engine.LastResult.Depth == 0) return null;

            SearchResult result = engine.LastResult;

            // The score is from the point of view of whoever did the searching. Against a
            // person that is the engine and the other side is "you"; in a watched game
            // there is no "you" to be ahead, so the two are named.
            bool watched = _session.Options.Mode == GameMode.Spectate;
            int searcher = Math.Max(_session.LastMover, 0);

            string mover = watched ? _session.PlayerName(searcher) : "engine";
            string other = watched ? _session.PlayerName(searcher ^ 1) : "you";

            string verdict = result.IsForced
                ? result.Score > 0 ? $"{mover} has a forced win" : $"{mover} is lost"
                : result.Score > 250 ? $"{mover} ahead"
                : result.Score < -250 ? $"{other} ahead"
                : "level";

            return $"depth {result.Depth} · {result.Nodes:N0} nodes · {verdict}";
        }
    }

    // ================================================================== the tape ==

    /// <summary>
    /// How far ahead a player has to be before the bar stops leaning further. Past six
    /// steps the answer is simply "them", and a longer bar would be saying the same thing
    /// louder rather than saying more.
    /// </summary>
    private const int DecisiveLead = 6;

    /// <summary>
    /// The lead, in steps, positive when the first player is closer to home. The half-step
    /// belongs to whoever is on move — they take the next of those steps — which is why
    /// the race is never exactly level and why the bar shifts as the turn passes.
    /// </summary>
    private double Advantage
    {
        get
        {
            (int first, int second) = _session.Distances();

            // Having no route at all is not being a long way behind; it is being out of
            // the race, and the figure should say so rather than pick a number.
            if (first < 0 && second < 0) return 0;
            if (first < 0) return -DecisiveLead;
            if (second < 0) return DecisiveLead;

            double half = _session.IsOver ? 0 : _session.State.SideToMove == 0 ? 0.5 : -0.5;

            return second - first + half;
        }
    }

    /// <summary>Whose end the bar leans toward.</summary>
    private int Ahead => Advantage >= 0 ? 0 : 1;

    /// <summary>
    /// How far over, as the fraction of the rail's half the bar is scaled to. Written
    /// invariantly because it lands in a CSS custom property, and a browser set to a
    /// comma decimal point would be handed a number it can only drop.
    /// </summary>
    private string Edge => Math.Min(Math.Abs(Advantage) / DecisiveLead, 1)
        .ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>What a player has left to walk, short enough to sit at the end of the bar.</summary>
    private string Remaining(int player)
    {
        (int first, int second) = _session.Distances();
        int distance = player == 0 ? first : second;

        return distance < 0 ? "—" : distance == 0 ? "home" : distance.ToString();
    }

    /// <summary>
    /// The figure said out loud, for the title and for anyone reading the page rather than
    /// looking at it. A shape with a sentence attached needs no caption printed beside it.
    /// </summary>
    private string Race
    {
        get
        {
            (int first, int second) = _session.Distances();
            string both = $"{_session.PlayerName(0)} {Walk(first)}, {_session.PlayerName(1)} {Walk(second)}";

            if (first < 0 || second < 0) return $"{both}.";

            int lead = Math.Abs(second - first);

            if (lead == 0)
            {
                return _session.IsOver
                    ? $"{both} — level."
                    : $"{both} — level, and {_session.PlayerName(_session.State.SideToMove)} to move.";
            }

            string leader = _session.PlayerName(second > first ? 0 : 1);

            return $"{both} — {leader} ahead by {lead} {(lead == 1 ? "step" : "steps")}.";
        }
    }

    // Written as a chain rather than a switch on relational patterns: a line that begins
    // with "<" inside a Razor code block is read as the start of a tag, and "< 0 =>" turns
    // the rest of the file into markup.
    private static string Walk(int distance) =>
        distance < 0 ? "has no route"
        : distance == 0 ? "is home"
        : distance == 1 ? "is one step from home"
        : $"is {distance} steps from home";

    // ================================================================== setup ==

    private void OpenSetup()
    {
        _showSetup = true;

        // A fresh board to look at each time the screen is opened, which is what a rolled
        // game means by "another game" and costs a plain one nothing.
        RollPreview();

        ResetNet();
    }

    private void SelectMode(GameMode mode)
    {
        _mode = mode;
        if (mode != GameMode.Online) ResetNet();
    }

    private void StartGame()
    {
        // A rolled game rolls the order of play too.
        if (_flavour == GameFlavour.Random) _seat = Random.Shared.Next(2);

        // The board that has been on the screen all along, and not another one built from
        // the same numbers. Every flavour but Standard draws a seed, so building again here
        // would deal a different scatter from the one the player has just spent a minute
        // looking at — which would make the preview a picture of a game rather than of this
        // game, and a rolled board something you can never actually choose. Rolling again is
        // still one press: Random re-rolls, and opening the screen at all rolls afresh.
        //
        // Recomputed rather than trusted, so that a control added later which forgets to say
        // it changed the board cannot make the two disagree silently.
        RefreshPreview();

        _session = new GameSession(OptionsFor(_mode, _strength, _clock, _seat, _shown, _flavour));
        _showSetup = false;

        // The game just set up is the one a returning player almost always wants next, so
        // it is written down here — where it has been settled — rather than on every
        // touch of every control on the card.
        Remember();

        // Music cannot start when the page loads, however it was left: a browser will not
        // make a sound until somebody has pressed something. This press is the first one
        // there is, so a piece that was playing last time picks up here.
        if (_music) _ = StartMusic();

        // Last, because it is what hands the board to the engine when the engine opens,
        // and a fast bot answers inside this call.
        ResetPlayState();
    }

    /// <summary>
    /// Begins again, optionally with the players changing places. Online this has to be
    /// agreed, so the same instruction goes to the other browser and both act on it.
    /// </summary>
    private async Task Restart(bool swap)
    {
        // Everything the game was set up with, taken off the game itself rather than off
        // the card behind it: the card may have been opened and fiddled with since, and a
        // rematch is a repeat of what was played.
        GameOptions options = _session.Options;
        bool rolled = options.Flavour == GameFlavour.Random;

        // A rolled game rolls again — playing the same random board twice is not what
        // "random" was asked for. Standard and Custom are settings, so they stand.
        GameSetup setup = rolled ? BuildSetup(GameFlavour.Random) : _session.Setup;

        int seat = _session.LocalSeat < 0 ? 0 : swap ? _session.LocalSeat ^ 1 : _session.LocalSeat;

        // Random re-rolls who starts as well — but not online, where the seats belong to
        // both players and swapping sides is the only agreed way to change them.
        if (rolled && options.Mode != GameMode.Online) seat = Random.Shared.Next(2);

        // Online the whole thing is a joint decision, so the other browser is told which
        // board to build and whether the sides changed.
        if (options.Mode == GameMode.Online)
            await _net.SendAsync($"restart|{(swap ? "swap" : "keep")}|{setup.Encode()}");

        _seat = seat;
        _session = new GameSession(
            OptionsFor(options.Mode, options.Strength, options.Clock, seat, setup, options.Flavour));

        ResetPlayState();
    }

    /// <summary>
    /// How long a board takes to arrive: the gaps open, then the prizes are laid out.
    /// The delays themselves are worked out in the board component, which keeps them
    /// inside this window however many of each there are.
    /// </summary>
    private const int BoardEntranceMs = 330;

    /// <summary>
    /// Hands the game to the engine when the engine opens — but not before the board has
    /// finished arriving. Every other move already waits for the pawn to land for the
    /// same reason: the search runs on the only thread there is, and an entrance still
    /// playing when it starts stops where it stands. At the start of a game that is a
    /// board with its gaps not yet drawn, which is worse than a stopped pawn: it is a
    /// board that is simply wrong until the search returns.
    /// </summary>
    private async Task OpenGame()
    {
        if (!_session.IsBotTurn)
        {
            // The board is the player's, so the engine's core is free for as long as they
            // spend over it. Nothing is played out of a ponder and no answer is kept; all
            // it leaves behind is a warmed table. The host decides whether it happens at
            // all, and in a browser it does not — there is only the one thread, and this
            // would take it and never give it back.
            _session.StartPondering();
            return;
        }

        // A plain board has nothing to arrive, so it has nothing to wait for. The portals
        // count here as the holes and the pickups do: their mouths are drawn with the rest
        // of what the generator laid out, and a search starting mid-entrance freezes them
        // half-arrived. Only at the start of a game: an undo back onto an engine turn also
        // comes through here, and there the board has been on screen all along.
        if (_session.Moves.Count == 0 &&
            (_session.Setup.Holes > 0 || _session.Setup.Pickups > 0 || _session.Setup.ActualPortals > 0))
        {
            await Task.Delay(BoardEntranceMs);
        }

        await RunEngine();
    }

    private void Undo()
    {
        _session.Undo();

        // Which also starts the engine again, if the position we came back to is one it
        // has to answer — taking back the move that won the game is exactly that.
        ResetPlayState();
    }

    // =================================================================== sound ==

    private IJSObjectReference? _sfx;

    /// <summary>
    /// The sounds are synthesised in the browser, so the module is the whole of it —
    /// there is nothing to download and nothing to wait for. Loaded on the first sound
    /// because a page may never make one.
    /// </summary>
    private async Task<IJSObjectReference?> LoadSfx()
    {
        try
        {
            if (_sfx is not null) return _sfx;

            _sfx = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/Quoridor.Ui/js/sfx.js");

            // Builds the audio graph while the browser is idle. Left to the first move,
            // it costs that move a fifth of a second and the pawn lurches instead of
            // sliding.
            await _sfx.InvokeVoidAsync("warm");

            // A volume remembered from an earlier visit has to reach the thing that makes
            // the sound, or the slider says one number and the board plays another.
            await _sfx.InvokeVoidAsync("setVolume", _soundVolume / 100.0, _musicVolume / 100.0);

            return _sfx;
        }
        catch (Exception)
        {
            // Audio is a nicety; a browser that refuses it should not break the game.
            return null;
        }
    }

    private async Task Sfx(string kind)
    {
        if (!_sound) return;

        try
        {
            if (await LoadSfx() is { } module) await module.InvokeVoidAsync("play", kind);
        }
        catch (Exception)
        {
        }
    }

    /// <summary>The sound a move makes, and the one the end of the game makes.</summary>
    private async Task SoundFor(Move move)
    {
        // A pickup is the one thing on the board worth its own sound; without it the
        // most interesting move in the game sounds exactly like every other step. A
        // portal step earns one for the opposite reason: it is the one move that does not
        // look like what it is, because the pawn arrives somewhere it never walked to.
        if (_session.LastMoveWentAgain || _session.LastMoveTookAWall)
            await Sfx(_session.LastMoveWentAgain ? "again" : "collect");
        else if (_session.LastMoveCrossedPortal)
            await Sfx("portal");
        else
            await Sfx(move.Kind == MoveKind.Pawn ? "move" : "wall");

        if (!_session.IsOver) return;

        await Sfx(Ours(_session) ? "win" : "lose");
    }

    /// <summary>Switches pieces. Playing already means stopping and starting again.</summary>
    private async Task PickTrack(ChangeEventArgs e)
    {
        _track = Math.Clamp(Number(e, 0), 0, 2);
        Remember();

        if (!_music) return;

        try
        {
            if (await LoadSfx() is { } module) await module.InvokeVoidAsync("music", false);
        }
        catch (Exception)
        {
            return;
        }

        await StartMusic();
    }

    private async Task StartMusic()
    {
        try
        {
            if (await LoadSfx() is not { } module) return;

            await module.InvokeVoidAsync("setVolume", _soundVolume / 100.0, _musicVolume / 100.0);
            await module.InvokeVoidAsync("music", _music, _track);
        }
        catch (Exception)
        {
        }
    }

    /// <summary>How a volume reads beside its slider. Nothing to hear is not "0%".</summary>
    private static string Level(int volume) => volume == 0 ? "off" : $"{volume}%";

    /// <summary>
    /// Sets one of the two volumes, which is now also how either of them is switched off.
    ///
    /// There used to be a button beside each slider. Two controls for one answer is two
    /// controls that can disagree — a switch reading On over a slider at zero says nothing
    /// true — and it was two of the panel's nine rows spent on a question that has a number
    /// for an answer already. The desktop settled this the same way, in the same words:
    /// nothing to hear is what off means.
    /// </summary>
    private async Task SetVolume(object? value, bool music)
    {
        if (!int.TryParse(value?.ToString(), out int level)) return;

        level = Math.Clamp(level, 0, 100);

        bool was = music ? _music : _sound;
        bool now = level > 0;

        if (music)
        {
            _musicVolume = level;
            _music = now;
        }
        else
        {
            _soundVolume = level;
            _sound = now;
        }

        Remember();

        try
        {
            if (await LoadSfx() is not { } module) return;

            await module.InvokeVoidAsync("setVolume", _soundVolume / 100.0, _musicVolume / 100.0);
        }
        catch (Exception)
        {
            return;
        }

        // The piece starts when the slider leaves zero and stops when it arrives there.
        // Only on the crossing: starting it again on every step of a drag would restart the
        // track from its opening bar a hundred times on the way from quiet to loud.
        if (music)
        {
            if (was != now) await StartMusic();
            return;
        }

        // A volume you cannot hear is a volume you cannot set, so the effects slider
        // makes a sound as it moves.
        if (now) await Sfx("move");
    }

    // ============================================================== remembered ==

    /// <summary>The board sizes the list offers, which is what a stored one has to be.</summary>
    private static readonly int[] BoardSizes = { 9, 7, 5 };

    /// <summary>
    /// Everything worth carrying to the next visit, as the single line it is stored as.
    /// Named terms rather than a fixed order, so that a setting added later is simply not
    /// found in what an older visit wrote — and takes its default — and one that has
    /// stopped meaning anything can be dropped without invalidating the rest.
    /// </summary>
    private string StoredSettings => string.Join(';', new[]
    {
        $"theme={(_light ? "light" : "dark")}",
        $"style={(_carved ? "carved" : "flat")}",
        $"reading={(_reading ? 1 : 0)}",
        $"confirm={(_confirm ? 1 : 0)}",
        $"sound={(_sound ? 1 : 0)}",
        $"soundvol={_soundVolume}",
        $"music={(_music ? 1 : 0)}",
        $"musicvol={_musicVolume}",
        $"track={_track}",

        // Written as the number of milliseconds and not as which button was lit: what the
        // list offers is the host's business, and the two hosts do not offer the same list.
        // A phone's 3 s read back in a browser is brought down to what a browser allows,
        // rather than leaving a row with nothing lit in it.
        $"movetime={_moveTimeMs}",

        // Both are written whatever host wrote them, and both are read back on any host.
        // A phone that was told to idle and is then opened in a browser has nothing to
        // idle, so the setting simply has no effect there rather than being lost; the pace
        // of a watched game means the same thing on either.
        $"ponder={(_ponder ? 1 : 0)}",
        $"pace={_paceMs}",

        // The game last set up, so that coming back to play another one is the same
        // single press it was the first time. An online game is not written down: it
        // cannot be resumed by remembering it, since the invite went with the tab, and
        // opening the card on the online panel with an empty code is a worse start than
        // the one almost everybody wants.
        $"opponent={OpponentName(_mode)}",
        $"clock={ClockName(_clock)}",
        $"strength={(int)_strength}",
        $"game={_flavour}",
        $"size={_size}",
        $"walls={_walls}",
        $"holes={_holes}",
        $"pickups={_pickups}",
        $"portals={_portals}",
    });

    /// <summary>
    /// Takes the stored line back apart. Every value is checked against what the control
    /// it belongs to actually offers, and anything that fails simply leaves the default
    /// standing: what is in storage was written by some other version of this page, or by
    /// somebody with the developer tools open, and neither is a reason to fail to start.
    /// </summary>
    private void ApplySettings(string stored)
    {
        foreach (string term in stored.Split(';', StringSplitOptions.RemoveEmptyEntries))
        {
            int mark = term.IndexOf('=');
            if (mark <= 0) continue;

            string name = term[..mark];
            string value = term[(mark + 1)..];

            switch (name)
            {
                case "theme": _light = value == "light"; break;
                // Only the word that turns it off is honoured, so a line stored before
                // this was the default does not carry the old one forward.
                case "style": _carved = value != "flat"; break;
                case "reading": _reading = value == "1"; break;
                case "confirm": _confirm = value == "1"; break;
                case "sound": _sound = value == "1"; break;
                case "music": _music = value == "1"; break;
                case "soundvol": _soundVolume = Ranged(value, _soundVolume, 100); break;
                case "musicvol": _musicVolume = Ranged(value, _musicVolume, 100); break;
                case "track": _track = Ranged(value, _track, 2); break;
                case "movetime": _moveTimeMs = HostProfile.Current.Allowed(Ranged(value, _moveTimeMs, 60_000)); break;
                case "ponder": _ponder = value == "1"; break;

                // Only one of the three the control offers. A number no button carries
                // would leave the row with nothing lit, which reads as the setting having
                // been lost rather than as it never having been one of the choices.
                case "pace": _paceMs = Offered(value, PaceMilliseconds, _paceMs); break;

                case "opponent": _mode = Opponent(value); break;
                case "clock": _clock = StoredClock(value); break;
                case "strength": _strength = (BotStrength)Ranged(value, (int)_strength, 2); break;
                case "game": _flavour = Flavour(value); break;

                case "size": _size = Offered(value, BoardSizes, Board.Size); break;
                case "walls": _walls = Ranged(value, _walls, Board.MaxWalls); break;
                case "holes": _holes = Ranged(value, _holes, Board.CellCount); break;
                case "pickups": _pickups = Ranged(value, _pickups, Board.CellCount); break;
                case "portals": _portals = Ranged(value, _portals, GameSetup.MaxPortals); break;
            }
        }

        // The size and the four counts are stored as separate terms and read in whatever
        // order they arrive in, so what the size will carry is only settled once the whole
        // line is in — the same rule the controls themselves apply, and for the same
        // reason. Every count is checked here rather than as it is read, because until the
        // size is known there is no list to check it against.
        _walls = Clamped(_walls, WallChoices);
        _holes = Clamped(_holes, HoleChoices);
        _pickups = Clamped(_pickups, PickupChoices);
        _portals = Clamped(_portals, PortalChoices);

        // The volume is the switch now, and the two used to be able to disagree — a line
        // written by an older build can say "off, at seventy". It comes back as a zero,
        // which is what that line meant, rather than as a slider sitting at seventy with
        // nothing coming out of it. Both directions, because the flag is still written and
        // is what an older build reads back out of the line this one leaves behind.
        if (!_sound) _soundVolume = 0;
        if (!_music) _musicVolume = 0;

        _sound = _soundVolume > 0;
        _music = _musicVolume > 0;
    }

    /// <summary>A stored number inside the range its control has, or the default. Written
    /// as two comparisons rather than a relational pattern because a Razor code block reads
    /// a line beginning with "&lt;" as the start of a tag.</summary>
    private static int Ranged(string value, int fallback, int highest) =>
        int.TryParse(value, out int number) && number >= 0 && number <= highest ? number : fallback;

    /// <summary>
    /// A stored number, but only one the control in question actually offers. A value no
    /// option carries would leave the list showing a blank, which reads as the setting
    /// having been lost rather than as it never having been possible.
    /// </summary>
    private static int Offered(string value, int[] options, int fallback) =>
        int.TryParse(value, out int number) && Array.IndexOf(options, number) >= 0 ? number : fallback;

    private static GameFlavour Flavour(string value) => value switch
    {
        nameof(GameFlavour.Random) => GameFlavour.Random,
        nameof(GameFlavour.Custom) => GameFlavour.Custom,
        _ => GameFlavour.Standard,
    };

    /// <summary>
    /// The mode, under its own name rather than under the enum's. Online is never stored,
    /// so an older line that has never heard of a watched game simply falls through to the
    /// one almost everybody wants.
    /// </summary>
    private static GameMode Opponent(string value) => value switch
    {
        "hotseat" => GameMode.Hotseat,
        "engines" => GameMode.Spectate,
        _ => GameMode.VersusBot,
    };

    private static string OpponentName(GameMode mode) => mode switch
    {
        GameMode.Hotseat => "hotseat",
        GameMode.Spectate => "engines",
        _ => "engine",
    };

    /// <summary>The clock by name, so that adding a fourth one later cannot silently turn
    /// somebody's stored third into it.</summary>
    private static TimeControl StoredClock(string value) => value switch
    {
        "blitz" => TimeControl.Blitz,
        "rapid" => TimeControl.Rapid,
        _ => TimeControl.None,
    };

    private static string ClockName(TimeControl clock) =>
        clock == TimeControl.Blitz ? "blitz"
        : clock == TimeControl.Rapid ? "rapid"
        : "off";

    /// <summary>
    /// Reads the settings back before anything is drawn. After the first render would be
    /// simpler and would also mean a player who chose the light theme is shown the dark
    /// one for a frame on the way in. The module is a few hundred bytes and comes from the
    /// browser's own cache on every visit that has anything stored to read — the one visit
    /// that pays for the round trip is the one where it finds nothing.
    /// </summary>
    private async Task LoadGame()
    {
        try
        {
            if (await LoadPage() is not { } page) return;

            string stored = await page.InvokeAsync<string>("readResume");

            // Remembered as read, whether or not it can be used. A line this build cannot
            // make sense of then differs from the empty string the next write produces, so
            // it is cleared off the disk rather than being re-read and re-rejected on
            // every start from here on.
            _storedGame = stored;

            RestoreGame(stored);
        }
        catch (Exception)
        {
            // No game to come back to, which is what a first run is.
        }
    }

    private async Task LoadSettings()
    {
        try
        {
            if (await LoadPage() is not { } page) return;

            ApplySettings(await page.InvokeAsync<string>("readSettings"));
        }
        catch (Exception)
        {
            // A visit with nothing remembered is a visit with the defaults, which is
            // exactly what a first visit is.
        }
    }

    /// <summary>
    /// Makes a change from the settings panel and writes the result down. A preference
    /// that has to be set again on every visit is a preference the player stops setting.
    /// </summary>
    private void Choose(Action change)
    {
        change();
        Remember();
    }

    /// <summary>
    /// Stores the settings as they now stand. Started and not awaited: nothing on the page
    /// is waiting to hear whether the browser kept them, and the button that caused it
    /// should not sit pressed while a disk is written to.
    /// </summary>
    private void Remember()
    {
        // Before the module is up nothing has been changed yet — and writing at that point
        // would store the defaults over what we are still in the middle of reading.
        if (_page is null) return;

        _ = RememberAsync();
    }

    private async Task RememberAsync()
    {
        try
        {
            if (_page is { } page) await page.InvokeVoidAsync("writeSettings", StoredSettings);
        }
        catch (Exception)
        {
            // Storage is a convenience; a browser without it should still play.
        }
    }

    // ============================================================ the game itself ==

    /// <summary>
    /// The game in progress, written down after every move.
    ///
    /// A phone does not close apps, it forgets them. Nothing warns an app that the system
    /// is about to reclaim it — there is no last chance to save, and the moment it happens
    /// is chosen by whatever else the phone is doing rather than by the player — so the
    /// only save that survives is one that has already happened. This is written after
    /// every position the game passes through, and leaving is not a special case: leaving
    /// deliberately, being killed in the background and the battery going flat all restore
    /// to the same board, because none of them is what wrote it down.
    ///
    /// A rebuild rather than a snapshot. What is stored is the game the session was made
    /// from and the moves played into it, and coming back replays them — so the position,
    /// the history, the walls, the pickups still standing and everything else the rules
    /// produce come out of the rules, and there is no second description of a board to
    /// keep in step with the first one.
    ///
    /// Online games are not written down. There is a browser at the other end of a
    /// connection that closed when the app went away; a board restored on this side alone
    /// would be a game with nobody in the other seat.
    /// </summary>
    private string StoredGame
    {
        get
        {
            if (!_started || _session.Options.Mode == GameMode.Online || _session.IsOver) return string.Empty;

            var terms = new List<string>
            {
                $"mode={OpponentName(_session.Options.Mode)}",
                $"strength={(int)_session.Options.Strength}",
                $"clock={ClockName(_session.Options.Clock)}",
                $"seat={(_session.Options.HumanMovesFirst ? 0 : 1)}",
                $"game={_session.Options.Flavour}",

                // The board actually in play, which is not always the one the card asked
                // for: a rolled game rolls again on a rematch, and it is the board with the
                // pieces on it that has to come back.
                $"board={_session.Setup.Encode()}",

                // Kind, row and column, which is the whole of a move and needs no board to
                // be read against — unlike the notation in the move list, which is written
                // relative to the corner of whatever size board it was played on.
                $"moves={string.Join(',', _session.Moves.Select(m => $"{(int)m.Kind}.{m.Row}.{m.Col}"))}",
            };

            // Where the player was reading, if they were reading. Stepping back through a
            // game is a place to be in it, and coming back to the live position when the
            // phone did not ask to is losing the reader's place.
            if (_reviewPly is { } ply) terms.Add($"ply={ply}");

            // Whole milliseconds. A clock is the one thing here that cannot be recomputed
            // from the moves, because how long somebody thought is not in the move.
            if (_session.HasClock)
            {
                terms.Add($"left={(long)_session.RemainingOf(0).TotalMilliseconds}," +
                          $"{(long)_session.RemainingOf(1).TotalMilliseconds}");
            }

            return string.Join(';', terms);
        }
    }

    /// <summary>What was last written, so a render that changed nothing writes nothing.</summary>
    private string _storedGame = string.Empty;

    /// <summary>
    /// Writes the game down if it has moved since the last time. Called from after every
    /// render rather than from each of the dozen places a position can change — a move, the
    /// engine's reply, an undo, a restart, a new game, a step through the review — because
    /// every one of them ends in a render and none of them can forget to do this.
    /// </summary>
    private async Task KeepGameAsync()
    {
        string now = StoredGame;
        if (now == _storedGame) return;

        _storedGame = now;

        try
        {
            if (_page is { } page) await page.InvokeVoidAsync("writeResume", now);
        }
        catch (Exception)
        {
            // Coming back to a board is a kindness, not a rule. A phone that will not keep
            // it still plays the game that is on the screen.
        }
    }

    /// <summary>
    /// Puts back the game that was on the board when the app was last seen, and says
    /// whether there was one. Anything it cannot read means there was not: what is in
    /// storage was written by some other version of this build, or by somebody with the
    /// developer tools open, and neither is a reason to fail to start.
    /// </summary>
    private bool RestoreGame(string stored)
    {
        if (stored.Length == 0) return false;

        GameMode mode = GameMode.VersusBot;
        BotStrength strength = BotStrength.Hard;
        TimeControl clock = TimeControl.None;
        GameFlavour flavour = GameFlavour.Standard;
        GameSetup setup = GameSetup.Standard;
        int seat = 0;
        int? ply = null;
        string moves = string.Empty;
        long[] left = Array.Empty<long>();

        foreach (string term in stored.Split(';', StringSplitOptions.RemoveEmptyEntries))
        {
            int mark = term.IndexOf('=');
            if (mark <= 0) continue;

            string name = term[..mark];
            string value = term[(mark + 1)..];

            switch (name)
            {
                case "mode": mode = Opponent(value); break;
                case "strength": strength = (BotStrength)Ranged(value, (int)strength, 2); break;
                case "clock": clock = StoredClock(value); break;
                case "seat": seat = value == "1" ? 1 : 0; break;
                case "game": flavour = Flavour(value); break;
                case "moves": moves = value; break;

                case "board":
                    if (!GameSetup.TryDecode(value.Split('|'), out setup)) return false;
                    break;

                case "ply":
                    if (int.TryParse(value, out int read) && read >= 0) ply = read;
                    break;

                case "left":
                    left = Array.ConvertAll(value.Split(','), t => long.TryParse(t, out long ms) ? ms : -1);
                    break;
            }
        }

        // A game that was never resumable in the first place, arriving from a store that
        // should not have had it.
        if (mode == GameMode.Online) return false;

        List<Move> played = ReadMoves(moves);

        // Which seat is on move at each ply, which the clocks below need and which cannot
        // be counted: a free move off a skip pickup keeps the turn, so the sides do not
        // simply alternate. Walked on a bare position rather than on a second session,
        // because a session builds an engine and an engine is sixty-four megabytes of
        // transposition table.
        GameState dry = setup.Build().State;
        var mover = new int[played.Count];

        for (int i = 0; i < played.Count; i++)
        {
            if (!dry.IsLegal(played[i])) return false;

            mover[i] = dry.SideToMove;
            dry.Apply(played[i]);
        }

        // The last ply each side is on move for. Charging a side's whole spend at one
        // moment is only safe there: by then they have taken every increment but the one
        // the move itself pays, so the number being taken off is the largest their clock
        // will ever have been asked to cover.
        var lastTurn = new int[] { -1, -1 };
        for (int i = 0; i < played.Count; i++) lastTurn[mover[i]] = i;

        _seat = seat;
        _session = new GameSession(OptionsFor(mode, strength, clock, seat, setup, flavour));

        bool clocked = _session.HasClock && left.Length == 2 && left[0] > 0 && left[1] > 0;

        for (int i = 0; i < played.Count; i++)
        {
            if (clocked && lastTurn[mover[i]] == i) SpendDownTo(mover[i], left[mover[i]], stillToCome: 1);
            if (!_session.Apply(played[i])) return false;
        }

        // And the side that is on move now, who has not moved since whatever they have
        // left was written down. Where they have moved already this was done above; where
        // they have not, they are still holding their opening budget.
        if (clocked && lastTurn[_session.State.SideToMove] < 0)
            SpendDownTo(_session.State.SideToMove, left[_session.State.SideToMove], stillToCome: 0);

        _showSetup = false;

        // Which puts the board back in play, starts the clock and hands the position to
        // the engine if the engine is the one on move.
        ResetPlayState();

        // After, not before: ResetPlayState returns the board to the live position, which
        // is exactly what it should do everywhere except here.
        if (ply is { } at && at < played.Count) _reviewPly = at;

        return true;
    }

    /// <summary>
    /// Charges a player down to the clock they had, at a moment when they are the one on
    /// move — which is the only moment the session will take time off them.
    ///
    /// <paramref name="stillToCome"/> is how many increments they are yet to be credited
    /// before the replay ends, so the number here is what leaves them on the right figure
    /// after those have landed. Floored a tenth of a second above zero: a clock restored
    /// to nothing is a game lost on time to a phone that got backgrounded, and being a
    /// tenth of a second generous is the cheaper mistake by a distance.
    /// </summary>
    private void SpendDownTo(int player, long remainingMs, int stillToCome)
    {
        TimeSpan have = _session.RemainingOf(player);
        TimeSpan want = TimeSpan.FromMilliseconds(remainingMs) - stillToCome * _session.Options.Clock.Increment;

        TimeSpan charge = have - want;
        TimeSpan most = have - TimeSpan.FromMilliseconds(100);

        if (charge > most) charge = most;
        if (charge <= TimeSpan.Zero) return;

        _session.ChargeClock(charge);
    }

    /// <summary>Takes the move list back apart. An unreadable term ends the list.</summary>
    private static List<Move> ReadMoves(string text)
    {
        var moves = new List<Move>();

        foreach (string term in text.Split(',', StringSplitOptions.RemoveEmptyEntries))
        {
            string[] parts = term.Split('.');

            if (parts.Length != 3 ||
                !int.TryParse(parts[0], out int kind) || kind is < 0 or > 2 ||
                !int.TryParse(parts[1], out int row) || row is < 0 or >= Board.Size ||
                !int.TryParse(parts[2], out int col) || col is < 0 or >= Board.Size)
            {
                break;
            }

            moves.Add(new Move((MoveKind)kind, row, col));
        }

        return moves;
    }

    /// <summary>
    /// Anything that only made sense for the position we just left — and then handing the
    /// board back to whoever is on move in the new one.
    ///
    /// Restarting the engine used to be each caller's own business, and Undo was the one
    /// caller that did not do it: take a move back onto an engine turn and the game simply
    /// stopped, with the status line saying the engine was to move and nothing ever
    /// happening. Every path that changes the position already comes through here, so this
    /// is the one place that has to remember, and the only one that can forget.
    /// </summary>
    private void ResetPlayState()
    {
        _preview = null;
        _premove = null;
        _reviewPly = null;
        _showResult = false;
        _resultHeld = false;
        _resultSeen = false;

        // Every path that puts a game on the board comes through here, which is the one
        // place that can say a game is now in play without every caller remembering to.
        _started = true;

        // Whatever the engine is in the middle of was asked about a position that is no
        // longer on the board. Cancelled and dropped rather than disposed: the search being
        // abandoned goes on reading the token it was handed until it notices, and a source
        // with no registrations has nothing to release.
        //
        // In a browser this has never had anything to do — the search holds the only
        // thread, so nothing can be pressed while it runs. Behind a native shell it is on a
        // thread of its own and Restart is live throughout, which is the whole point of
        // being there and also the reason this line has to exist.
        _engineStop.Cancel();
        _engineStop = new CancellationTokenSource();

        // A fresh opponent has no history to guess from, so the strength stands in for
        // one: the full engine is worth announcing, and the two handicapped bots answer
        // faster than the word could be read. A watched game always opens with the full
        // search, whatever strength it was given to play against.
        _lastThinkMs = _session.Options.Strength == BotStrength.Hard ||
                       _session.Options.Mode == GameMode.Spectate
            ? SlowSearchMs
            : 0;

        StartClock();

        // Not awaited: this is called from Undo and from two network callbacks, none of
        // which is waiting for the engine's reply, and RunEngine repaints for itself. It
        // releases _engineRunning in a finally, so a search that throws leaves the loop
        // startable rather than wedged.
        _ = OpenGame();
    }

    // ================================================================ the finish ==

    /// <summary>Whether the result card is up, which the game being over is not yet.</summary>
    private bool _showResult;

    /// <summary>Whether the wait is already running, so it is only started once.</summary>
    private bool _resultHeld;

    /// <summary>
    /// Whether the card for this result has already been up and been dismissed. Every
    /// render asks whether the game is over and the card is down, and without this the
    /// answer after a back gesture is yes, forever: the card would go up again half a
    /// second after being taken off, and the final position it was taken off to look at
    /// would never be visible for longer than that.
    /// </summary>
    private bool _resultSeen;

    /// <summary>
    /// Long enough to see the move that won and the finish line flooding out from it, and
    /// short enough that it reads as a beat rather than as the page having stopped. The
    /// board's own flourish is --t-win in the stylesheet and finishes inside this.
    /// </summary>
    private const int WinPauseMs = 750;

    private async Task HoldResult()
    {
        await Task.Delay(WinPauseMs);

        _resultHeld = false;

        // A restart or an undo inside the pause takes the card with it: there is no result
        // to show any more, and the wait was for a game that is no longer the one in play.
        if (!_session.IsOver) return;

        _showResult = true;
        StateHasChanged();
    }

    // =================================================================== link ==

    private async Task HostGame() => await _net.HostAsync();

    private async Task JoinGame() => await _net.JoinAsync(_joinCode);

    private void ResetNet()
    {
        _ = _net.SendAsync(string.Empty);
        _ = _net.DisposeAsync().AsTask();

        _net = new NetLink(Js);
        _net.Changed += OnNetChanged;
        _net.Received += OnNetMessage;
    }

    private void OnNetChanged() => InvokeAsync(async () =>
    {
        // The player who created the game chose the sides; the one who opened the link
        // starts on the assumption of the second seat and is told otherwise straight away.
        if (_net.IsConnected && (_session.Options.Mode != GameMode.Online || _showSetup))
        {
            bool host = _net.Code.Length > 0;

            // The player who opened the link takes the second seat and the standard board
            // until told otherwise, which happens immediately. The host plays the board that
            // was on their start screen, for the same reason Play does: it is the one they
            // chose, and it is encoded and sent from here so both sides build that one.
            GameSetup setup = host ? _shown : GameSetup.Standard;
            if (!host) _seat = 1;

            // The host's flavour travels with the game, so a rematch on a rolled board
            // rolls again for both of them.
            _session = new GameSession(OptionsFor(
                GameMode.Online, BotStrength.Normal, TimeControl.None,
                _seat, setup, host ? _flavour : GameFlavour.Standard));

            _showSetup = false;
            ResetPlayState();

            // The host announces the board; the other side asks for it. Announcing alone
            // was one message with no second chance — miss it and that browser plays on a
            // standard board while the game goes on around it, holes and pickups missing
            // and nothing saying so. Asking makes the handshake answerable rather than
            // hopeful, and the answer is idempotent, so arriving twice costs nothing.
            if (host) await _net.SendAsync($"seat|{_seat ^ 1}|{setup.Encode()}");
            else await _net.SendAsync("board?");
        }

        StateHasChanged();
    });

    private void OnNetMessage(string message) => InvokeAsync(async () =>
    {
        // "board?" — the other side asking which board this is. Only the host can answer,
        // and it answers from the session actually in play rather than from the setup
        // screen, so a game already under way is described as it now stands.
        if (message == "board?")
        {
            if (_net.Code.Length > 0 && _session.Options.Mode == GameMode.Online)
                await _net.SendAsync($"seat|{_session.LocalSeat ^ 1}|{_session.Setup.Encode()}");

            return;
        }

        // "seat|<n>|<board>" — the side and the board the other browser has set up, the
        // board as the numbers it was generated from so both sides build the same one.
        // Sent on connecting by whoever created the game, and again whenever asked.
        if (message.StartsWith("seat|"))
        {
            string[] terms = message.Split('|');

            // Seven terms is a board without portals and eight is one with: the portal
            // count is only sent when it is not zero, so every game that could have been
            // played against a build predating portals still can be.
            if (terms.Length is 7 or 8 &&
                int.TryParse(terms[1], out int mine) && mine is 0 or 1 &&
                GameSetup.TryDecode(terms.AsSpan(2), out GameSetup setup))
            {
                _seat = mine;

                if (mine != _session.LocalSeat || setup != _session.Setup)
                {
                    // A board that is not the plain one was rolled or set by the host;
                    // either way this side follows whatever they send on a rematch.
                    _session = new GameSession(OptionsFor(
                        GameMode.Online, BotStrength.Normal, TimeControl.None,
                        _seat, setup, GameFlavour.Standard));

                    ResetPlayState();
                }
            }

            StateHasChanged();
            return;
        }

        // "restart|<swap|keep>|<board>" — begin again, on the board the other side rolled
        // and with the sides they say. Older builds sent "restart" and "restart|swap",
        // which still mean the same thing on the board already in play.
        if (message.StartsWith("restart"))
        {
            string[] terms = message.Split('|');
            bool swap = terms.Length > 1 && terms[1] == "swap";

            // Seven or eight for the same reason as the seat message: the eighth term is
            // the portal count, and it is only there when there is a portal to name.
            GameSetup setup = terms.Length is 7 or 8 && GameSetup.TryDecode(terms.AsSpan(2), out GameSetup sent)
                ? sent
                : _session.Setup;

            _seat = swap ? _session.LocalSeat ^ 1 : _session.LocalSeat;

            _session = new GameSession(OptionsFor(
                GameMode.Online, BotStrength.Normal, TimeControl.None,
                _seat, setup, _session.Options.Flavour));

            ResetPlayState();
            StateHasChanged();
            return;
        }

        // "move|<ply>|<notation>". The ply guards against a duplicate or a message that
        // overtook another; anything that does not line up is dropped rather than
        // guessed at, because both sides hold the same position and can afford to wait.
        string[] parts = message.Split('|');

        // The seat test is the one that matters: legality alone is checked against
        // whoever is on move, so without it a message arriving on our own turn is
        // applied as our move, and the other browser gets to play both colours.
        if (parts.Length == 3 &&
            parts[0] == "move" &&
            _session.State.SideToMove != _session.LocalSeat &&
            int.TryParse(parts[1], out int ply) &&
            ply == _session.Moves.Count &&
            Notation.TryParse(parts[2], out Move move, _session.State.GoalRow(0)) &&
            _session.Apply(move))
        {
            _ = SoundFor(move);
        }

        StateHasChanged();
        await TryPremoveAsync();
    });

    // =================================================================== play ==

    private async Task OnMove(Move move)
    {
        if (_thinking || !_session.IsHumanTurn) return;

        int ply = _session.Moves.Count;
        if (!_session.Apply(move)) return;

        _preview = null;

        // Deliberately not awaited. The first sound has to fetch its module, and waiting
        // on that once held the engine's reply up for five seconds on a cold load.
        _ = SoundFor(move);

        if (_session.Options.Mode == GameMode.Online)
        {
            await _net.SendAsync($"move|{ply}|{Notation.Format(move, _session.State)}");
            return;
        }

        // Let the move finish moving before the engine takes the thread away. The search
        // runs on the only thread this build has, so anything still animating when it
        // starts simply stops dead and snaps into place when it ends. Playing a person
        // has always looked right for exactly this reason: nothing blocks in between.
        await Task.Delay(MoveAnimationMs);

        await RunEngine();
    }

    /// <summary>
    /// How long the board takes to show a move, matching the pawn's transition in the
    /// stylesheet. The engine waits this out before it starts thinking.
    /// </summary>
    private const int MoveAnimationMs = 330;

    /// <summary>
    /// Plays the move queued during the opponent's turn. Whether it would still be legal
    /// could not be known when it was chosen, so it is checked now and quietly dropped
    /// if their move ruined it.
    /// </summary>
    private async Task TryPremoveAsync()
    {
        if (_premove is not { } queued) return;
        if (!_session.IsHumanTurn || _reviewPly is not null) return;

        _premove = null;

        if (_session.State.IsLegal(queued)) await OnMove(queued);

        // This runs from a network callback or after the engine, not from a Blazor event,
        // so nothing repaints on its own — whether the move was played or dropped.
        StateHasChanged();
    }

    /// <summary>
    /// Stops the search when the position it was asked about is taken off the board — a
    /// restart, a new game, an undo, the page going away. Cancelled and replaced rather
    /// than reused, so a loop that comes back round reads a token belonging to the game
    /// that is now in play.
    /// </summary>
    private CancellationTokenSource _engineStop = new();

    /// <summary>
    /// How long one move takes in a watched game, at the least. Two engines answering as
    /// fast as they can is a game nobody can follow, and against a person the search is
    /// its own pause. It is the desktop's own middle setting; the desktop offers three and
    /// this does not, because a picker for how fast to watch something is a knob the board
    /// does not need.
    /// </summary>
    // The pace of a watched game is the player's, and is above with the rest of the
    // preferences: see _paceMs.

    /// <summary>
    /// Plays the engine's moves for as long as it is on move. Cancelling a search does not
    /// end this loop and does not start another one anywhere else: the loop comes back
    /// round, reads the session as it now stands, and either searches the new position or
    /// stops. That is what keeps a restart from putting two searches on one agent.
    ///
    /// The search is asked for through <c>ThinkAsync</c>, which runs it on a thread from
    /// the pool. Behind a native shell that is a real one and the page stays live
    /// throughout; in WebAssembly the pool is the only thread there is, so the search still
    /// holds the screen for as long as it lasts — which is why the budget is capped there
    /// and why "Thinking" is still painted, and yielded on, before it starts.
    /// </summary>
    private async Task RunEngine()
    {
        // Only ever one of these. The loop yields so the browser can paint "Thinking",
        // and a restart pressed inside that gap would otherwise start a second loop
        // alongside the first, both driving the same game.
        if (_engineRunning) return;
        _engineRunning = true;

        try
        {
            while (!_closed)
            {
                // Read once per turn, and re-read at the top of every one: a restart
                // replaces the session outright, and the loop has to end up driving
                // whichever game is now in play rather than the one it started on. The
                // token is re-read with it, for exactly the same reason.
                GameSession session = _session;
                if (!session.IsBotTurn) break;

                CancellationToken token = _engineStop.Token;

                _thinking = true;
                _saidThinking = _lastThinkMs >= SlowSearchMs;

                // A wait worth mentioning is announced and then paid for; one that is
                // over before it can be read is simply taken. Easy answers in a few
                // milliseconds, and the panel used to write "Thinking…" and rub it out
                // again between two frames, which reads as the page glitching rather
                // than as an opponent playing quickly.
                if (_saidThinking)
                {
                    StateHasChanged();
                    await Task.Delay(40);

                    // That yield hands the browser back the thread, and a Restart pressed
                    // inside it is processed before we get it again. Searching only asks
                    // that there be an engine on this side, not that the game still be the
                    // one we set out to play, so pressing on regardless had the engine play
                    // the human's opening move on the new board. Going round again rather
                    // than breaking out: the new game may be one the engine opens, and this
                    // loop is the one holding _engineRunning, so it is the one that has to
                    // play it.
                    if (!ReferenceEquals(session, _session) || !session.IsBotTurn) continue;
                }

                // What the answer will have to match to be worth playing.
                int ply = session.Moves.Count;

                // How long the last search took is the only honest guide to how long
                // this one will take, and it costs nothing to keep.
                long started = System.Diagnostics.Stopwatch.GetTimestamp();

                Move move;

                try
                {
                    Task<Move> search = session.ThinkAsync(token);

                    // WhenAll waits for every task and not just the first to fail, so once
                    // this returns the search is over either way and the agent is free for
                    // the next turn round the loop.
                    if (session.Options.Mode == GameMode.Spectate)
                        await Task.WhenAll(search, Task.Delay(_paceMs, token));

                    move = await search;
                }
                catch (OperationCanceledException)
                {
                    _thinking = false;
                    _saidThinking = false;
                    continue;
                }

                _lastThinkMs = (int)System.Diagnostics.Stopwatch.GetElapsedTime(started).TotalMilliseconds;

                _thinking = false;
                _saidThinking = false;

                // An abandoned search still answers: the engine returns the best move it
                // had rather than throwing, so the cancellation can go unnoticed. The
                // answer belongs to the position it was asked about, and a restart or an
                // undo makes it a move for a game that no longer exists.
                if (token.IsCancellationRequested ||
                    !ReferenceEquals(session, _session) ||
                    session.Moves.Count != ply)
                {
                    continue;
                }

                session.Apply(move);
                _ = SoundFor(move);

                StateHasChanged();

                // Same reason as after a human move: if the engine is about to think
                // again — it found a free move — its pawn has to arrive first.
                await Task.Delay(MoveAnimationMs);
            }
        }
        finally
        {
            _thinking = false;
            _saidThinking = false;
            _engineRunning = false;
        }

        // The board is somebody else's now, so the engine's core is free for as long as
        // they take over it. Says nothing and does nothing where the host cannot spare a
        // thread, which is the browser.
        _session.StartPondering();

        await TryPremoveAsync();
    }

    /// <summary>
    /// How long a search has to take before it is worth telling the player it is running.
    /// Below this the label is gone before the eye has finished moving to it.
    /// </summary>
    private const int SlowSearchMs = 120;

    /// <summary>What the last search cost, which is what the next one is guessed from.</summary>
    private int _lastThinkMs;

    /// <summary>Whether this wait was long enough last time to be worth a word about it.
    /// The engine having the thread is <see cref="_thinking"/>; this is only whether the
    /// panel says so.</summary>
    private bool _saidThinking;

    private async Task SelectAll(FocusEventArgs _) =>
        await Js.InvokeVoidAsync("document.execCommand", "selectAll", false, null);

    /// <summary>Shown on the copy buttons; says so for a moment after one is pressed.</summary>
    private string CopyLabel => _copied ? "Copied" : "Copy";

    private bool _copied;

    private IJSObjectReference? _page;

    private async Task<IJSObjectReference?> LoadPage()
    {
        try
        {
            return _page ??= await Js.InvokeAsync<IJSObjectReference>("import", "./_content/Quoridor.Ui/js/page.js");
        }
        catch (Exception)
        {
            return null;
        }
    }

    /// <summary>
    /// Puts the invite on the clipboard, and says so on the button for a moment. The
    /// work is in the module: the clipboard API has to be called as a method on the
    /// object that owns it, which an interop path by name cannot do.
    /// </summary>
    private async Task Copy(string text)
    {
        if (string.IsNullOrEmpty(text)) return;

        try
        {
            if (await LoadPage() is not { } page) return;
            if (!await page.InvokeAsync<bool>("copy", text)) return;
        }
        catch (Exception)
        {
            return;
        }

        _copied = true;
        StateHasChanged();

        await Task.Delay(1400);

        _copied = false;
        StateHasChanged();
    }

    /// <summary>
    /// Whether the screen has gone. In a browser the page going away takes everything with
    /// it, so this never had anything to guard; behind a native shell the search and the
    /// ponder are on threads of their own and would go on running on a board nobody can
    /// see, holding a core for as long as they were told to.
    /// </summary>
    private bool _closed;

    public async ValueTask DisposeAsync()
    {
        _closed = true;

        // The shell outlives this component and holds a delegate into it. A back press
        // answered by a screen that has gone is a press that does nothing at all.
        HostShell.BackPressed = null;

        // Both of these are requests rather than events — the search notices at the top of
        // its next iteration — so nothing here waits for them.
        _engineStop.Cancel();
        _session.StopPondering();

        await _net.DisposeAsync();

        // The listener holds a reference back into here, so it goes first.
        if (_keyOwner is not null)
        {
            try
            {
                if (_page is not null) await _page.InvokeVoidAsync("stopListeningForKeys");
            }
            catch (Exception)
            {
                // The page is going away; the listener goes with it.
            }

            _keyOwner.Dispose();
            _keyOwner = null;
        }

        foreach (IJSObjectReference? module in new[] { _sfx, _page })
        {
            if (module is null) continue;

            try { await module.DisposeAsync(); } catch (Exception) { /* page is going away */ }
        }
    }
}
