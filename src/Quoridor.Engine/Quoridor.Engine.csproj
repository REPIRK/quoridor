<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Quoridor.Engine</AssemblyName>
    <RootNamespace>Quoridor.Engine</RootNamespace>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Quoridor.Core\Quoridor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Search internals are implementation detail for the app, but the test and
         benchmark tools need to audit them directly. -->
    <InternalsVisibleTo Include="Quoridor.Selftest" />
    <InternalsVisibleTo Include="Quoridor.Bench" />
  </ItemGroup>

</Project>
